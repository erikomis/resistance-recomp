# ---------------------------------------------------------------------------
# NOTHING FROM THE GAME, THE FIRMWARE OR SONY GOES IN THIS REPOSITORY.
# Everything below is generated locally from the player's own disc.
# ---------------------------------------------------------------------------

# Toolkit checkout (tools/setup_toolkit.sh recreates it)
/ps3recomp/
/.venv/

# Disc images, executables, metadata
*.iso
*.ISO
*.BIN
*.bin
*.elf
*.ELF
*.self
*.SELF
*.sprx
*.SPRX
*.prx
*.PRX
*.SFO
*.sfo
*.psarc
*.PSARC
*.pkg
*.PKG
*.PUP
*.pup
*.edat
*.EDAT
*.sdat
*.SDAT

# The v1.7 update's archives (tools/v17/regen_v17.sh reads them from here)
/update/

# Decrypted game files, captured modules, analysis and lifted output
game/
modules/
analysis/
recompiled/
build/
spu_images/
jobmods/
missed/
# Lifted SPU code is translated game code: regenerate it with
# tools/regen_spu_pm.sh, never commit it.
port/spu/captured/
port/spu/*/spu_recomp.c
port/spu/*/spu_recomp.h
port/spu/jobmods_register.c
port/spu/jobmods_manifest.json
# The v1.7 campaign's SPU code (tools/v17/regen_v17.sh), all of it lifted
port/spu_v17/
port/recompiled/

# Firmware and keys. tools/fetch_keys.py writes its key file outside the
# repository (~/Library/Application Support/resistance-recomp/keys/); these
# keep one out of git if it is ever pointed here, as does RPCS3's key table.
fw/
dev_flash/
dev_flash*/
*.keys
*.KEYS
keys/
*keys*.txt
*KEYS*.txt
key_vault.cpp
key_vault.h
*.rap
*.RAP
*.rif
*.act.dat
idps*
act.dat

# Saves, installed game data, run directories
saves/
gamedata/
dev_hdd0/
dev_hdd1/
dev_bdvd/
vfs/
out/
runs/
*.cwd/
*.sav
*.SAV
*.done

# Frame dumps, captures and logs
*.ppm
*.wav
*.log
*.sample
*.trace
game.pid
pad

# Editor / OS noise
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
