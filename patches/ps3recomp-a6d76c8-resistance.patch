+/* PS3_NET_ALLOW=ip[,ip...]: the only addresses a title may connect or send
+ * to (loopback always may); anything else is refused and logged. For trying
+ * a community server without the title reaching anything else. */
+static int net_allowed(const struct in_addr* a)
+{
+    const char* list = getenv("PS3_NET_ALLOW");
+    if (!list || !*list) return 1;
+    if ((ntohl(a->s_addr) >> 24) == 127) return 1;
+    for (const char* p = list; *p;) {
+        while (*p == ',' || *p == ' ') p++;
+        const char* e = p;
+        while (*e && *e != ',' && *e != ' ') e++;
+        char buf[16];
+        const size_t n = (size_t)(e - p);
+        struct in_addr x;
+        if (n > 0 && n < sizeof buf) {
+            memcpy(buf, p, n); buf[n] = 0;
+            if (inet_pton(AF_INET, buf, &x) == 1 && x.s_addr == a->s_addr) return 1;
+        }
+        p = e;
+    }
+    char ip[16];
+    printf("[sys_net] %s blocked (not in PS3_NET_ALLOW)\n", inet_ntop(AF_INET, a, ip, sizeof ip) ? ip : "?");
+    return 0;
+}
