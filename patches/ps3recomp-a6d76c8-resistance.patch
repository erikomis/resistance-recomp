                 const int ep = (int)ea + (int)eb - 127;                /* product's biased exponent */
+                SPU_FP_RN();   /* the classification below is the test's own double arithmetic */
                 int ec;
                 if (rnd32() & 1) { ec = ep - (int)(rnd32() % 24); c._u32[i] = (rnd32() & 7u) << 20; }
                 else             { ec = ep - 25 - (int)(rnd32() % 70); c._u32[i] = 0; }
@@ -159,6 +160,55 @@ int main(void)
         printf("test_spu_float_neon: ok (%ld zero-lane cases, %ld lanes with a zero operand)\n", M, zcases);
     }
 
+    /* The edges of the native round-toward-zero path (arm64): products and sums that land
+     * near Smin (must flush to +0) or near FLT_MAX / Smax (must saturate into the extended
+     * range, which the host cannot represent), and addends that cancel the product exactly
+     * or to within a few ulps. Checked with the native path and with SPU_FP_NATIVE=0's
+     * double-based path. */
+    for (int pass = 0; pass < 2; pass++) {
+#if defined(SPU__FPCR_RZ)
+        g_spu_fp_native = pass == 0;
+#else
+        if (pass) break;
+#endif
+        const long M = 4000000;
+        for (long it = 0; it < M; it++) {
+            u128 a, b, c, got, ref;
+            for (int i = 0; i < 4; i++) {
+                const uint32_t sa = (rnd32() & 1u) << 31, sb = (rnd32() & 1u) << 31;
+                const int high = rnd32() & 1;
+                const uint32_t ea = 64 + rnd32() % 128;
+                int eb = (high ? 254 + 127 : 1 + 127) - (int)ea + (int)(rnd32() % 5) - 2;
+                if (eb < 1) eb = 1;
+                if (eb > 255) eb = 255;
+                a._u32[i] = sa | (ea << 23) | (rnd32() & 0x7FFFFFu);
+                b._u32[i] = sb | ((uint32_t)eb << 23) | (rnd32() & 0x7FFFFFu);
+                const double pd = (double)spu__sf_f(a._u32[i]) * (double)spu__sf_f(b._u32[i]);
+                const float pf = (float)-pd;
+                uint32_t w; memcpy(&w, &pf, 4);
+                c._u32[i] = ((w >> 23) & 0xFFu) && ((w >> 23) & 0xFFu) < 255 && (rnd32() & 1)
+                          ? w + (rnd32() & 3u) - 1u : rnd_float();
+            }
+            const int op = (int)(it % 6);
+            switch (op) {
+            case 0: got = spu_fa(a, c);      ref = spu_fa_ref(a, c); break;
+            case 1: got = spu_fs(a, c);      ref = spu_fs_ref(a, c); break;
+            case 2: got = spu_fm(a, b);      ref = spu_fm_ref(a, b); break;
+            case 3: got = spu_fma(a, b, c);  ref = spu_fma_ref(a, b, c); break;
+            case 4: got = spu_fms(a, b, c);  ref = spu_fms_ref(a, b, c); break;
+            default: got = spu_fnms(a, b, c); ref = spu_fnms_ref(a, b, c); break;
+            }
+            if (memcmp(&got, &ref, 16) && bad++ < 10)
+                printf("MISMATCH (range, pass %d) op=%d a=%08X b=%08X c=%08X got=%08X ref=%08X\n", pass, op,
+                       a._u32[0], b._u32[0], c._u32[0], got._u32[0], ref._u32[0]);
+        }
+        if (bad) { printf("test_spu_float_neon: %ld mismatches in the range pass\n", bad); return 1; }
+        printf("test_spu_float_neon: ok (%ld range cases%s)\n", M, pass ? ", double-based path" : "");
+    }
+#if defined(SPU__FPCR_RZ)
+    g_spu_fp_native = -1;
+#endif
+
     /* The NEON paths leave the thread in round-toward-zero; double precision
      * must still round to nearest: 1 + (2^-53 + 2^-60) -> 1 + 2^-52. */
     {
