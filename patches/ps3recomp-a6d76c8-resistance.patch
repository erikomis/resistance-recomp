diff --git a/libs/video/tests/test_gcm_zpass_report.c b/libs/video/tests/test_gcm_zpass_report.c
new file mode 100644
index 00000000..7d32e0e8
--- /dev/null
+++ b/libs/video/tests/test_gcm_zpass_report.c
@@ -0,0 +1,223 @@
+/* NV4097_GET_REPORT of type 1 (ZPASS_PIXEL_CNT) with a draw engine that
+ * counts samples on the host GPU (cellGcmSys.c, the deferred report queue).
+ *
+ * The walker reaches a GET_REPORT long before the GPU has run the draws it
+ * counts, so the report waits for the engine's count -- and every semaphore
+ * release, back-end label and reference after it waits behind it, because on
+ * the RSX they land after the report does. The engine is stubbed: the test
+ * says when a ticket's count is ready.
+ *
+ *   - a measured report is stored only when its count is ready, with that
+ *     count, never the old 0xFFFF;
+ *   - an NV406E release, a back-end label (0x1D6C/0x1D70) and a reference
+ *     behind it wait, and land after it, in FIFO order;
+ *   - a release with nothing pending is written at once, as before;
+ *   - the walker idle with a label queued behind a report kicks the engine
+ *     (RSX_ZPASS_KICK), and an old enough report is forced (RSX_ZPASS_WAIT);
+ *     a count still missing then reports the conservative 0xFFFF;
+ *   - with host counting off the walker answers 0xFFFF at once, as before.
+ *
+ * clang -std=gnu17 -I include -I libs/video
+ *   libs/video/tests/test_gcm_zpass_report.c -Wl,-dead_strip -pthread
+ *   -o /tmp/test_gcm_zpass_report && /tmp/test_gcm_zpass_report
+ *   (gcc on Linux: -ffunction-sections -fdata-sections -Wl,--gc-sections)
+ */
+#include "../cellGcmSys.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_pass_begin(void) {}
+void rsx_draw_engine_pass_report(char* buf, size_t n) { if (n) buf[0] = 0; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+#define REPORT_IO 0x00008000u            /* the report, in the IO-mapped ring */
+#define REPORT_EA (IO_ADDR + REPORT_IO)
+#define SEMA_OFF  0x10u
+#define LABEL_EA  (GCM_LABEL_GUEST_BASE + SEMA_OFF)
+#define IO_ADDR   0x00100000u
+#define IO_SIZE   0x00100000u
+#define CMD_SIZE  0x00010000u
+
+/* ---- the stubbed engine -------------------------------------------------- */
+static int eng_on = 1, host_counting = 1;
+static u32 next_ticket = 100;
+static int ticket_ready;          /* 1: counts are in; -1: lost */
+static u32 ticket_count = 1234;
+static int kicks, waits, polls;
+int  rsx_draw_engine_enabled(void) { return eng_on; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_draw_engine_zpass_supported(void) { return host_counting; }
+u32  rsx_draw_engine_zpass_report(void) { return host_counting ? next_ticket++ : 0; }
+int  rsx_draw_engine_zpass_result(u32 ticket, int submit, u32* value)
+{
+    (void)ticket;
+    if (submit == RSX_ZPASS_KICK) kicks++;
+    else if (submit == RSX_ZPASS_WAIT) waits++;
+    else polls++;
+    if (ticket_ready < 0) return -1;
+    if (!ticket_ready) return 0;
+    *value = ticket_count;
+    return 1;
+}
+
+/* The back-end label path of rsx_commands.c: records what reached it, and
+ * whether the report had landed by then. */
+static u32 bl_methods[8], bl_n, bl_report_at_call;
+int rsx_process_method(rsx_state* state, u32 method, u32 data)
+{
+    (void)state; (void)data;
+    if (method == 0x1D6Cu || method == 0x1D70u) {
+        if (bl_n < 8) bl_methods[bl_n++] = method;
+        if (method == 0x1D70u) bl_report_at_call = vm_read32(REPORT_EA + 8u);
+    }
+    return 0;
+}
+
+static uint32_t g_heap = 0x00400000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+static u32 put_cmd(u32 io, u32 subch, u32 method, u32 count, const u32* args)
+{
+    gw32(IO_ADDR + io, (count << 18) | (subch << 13) | method);
+    for (u32 i = 0; i < count; i++) gw32(IO_ADDR + io + 4 + i * 4, args[i]);
+    return io + 4 + count * 4;
+}
+static u32 put1(u32 io, u32 method, u32 arg) { return put_cmd(io, 0, method, 1, &arg); }
+
+static u32 s_ctrl, s_io;
+static void run_to(u32 put)
+{
+    vm_write32(s_ctrl + 0, put);
+    cellGcm_rsx_process_fifo();
+}
+
+/* GET_REPORT(ZPASS), then an NV406E release, a back-end label and a
+ * reference: the frame-start sequence Resistance issues after its queries. */
+static void emit_frame(u32 label_value)
+{
+    s_io = put1(s_io, 0x1A8u, 0xFEED0001u);                 /* SET_CONTEXT_DMA_REPORT: main */
+    s_io = put1(s_io, 0x1800u, (1u << 24) | REPORT_IO);       /* GET_REPORT ZPASS_PIXEL_CNT */
+    s_io = put1(s_io, 0x64u, SEMA_OFF);                      /* NV406E SEMAPHORE_OFFSET */
+    s_io = put1(s_io, 0x6Cu, label_value);                   /* NV406E SEMAPHORE_RELEASE */
+    s_io = put1(s_io, 0x1D6Cu, 0x20u);                       /* back-end label offset */
+    s_io = put1(s_io, 0x1D70u, 0x77u);                       /* back-end label release */
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+    u32 ctx_out = host_alloc(4, 4);
+    (void)cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    s_ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+    s_fifo_getoff = 0;
+    vm_write32(s_ctrl + 4, 0);
+
+    /* 1. Counting on, count not ready: nothing behind the report lands. */
+    gw32(REPORT_EA + 8u, 0xDEADu);
+    emit_frame(0x11u);
+    run_to(s_io);
+    check(vm_read32(REPORT_EA + 8u) == 0xDEADu, "a pending ZPASS report is not written");
+    check(vm_read32(LABEL_EA) == 0u, "a release behind a pending report waits");
+    check(bl_n == 0, "back-end label methods behind a pending report wait");
+    check(kicks > 0, "the idle walker kicks the engine for a label waiting behind a report");
+
+    /* 2. The count arrives: the next pass stores the report, then the rest. */
+    ticket_ready = 1;
+    run_to(s_io);
+    check(vm_read32(REPORT_EA + 8u) == 1234u, "the report carries the measured count");
+    check(vm_read32(LABEL_EA) == 0x11u, "the release lands once the report has");
+    check(bl_n == 2 && bl_methods[0] == 0x1D6Cu && bl_methods[1] == 0x1D70u,
+          "back-end label methods run in FIFO order");
+    check(bl_report_at_call == 1234u, "the back-end label lands after the report");
+
+    /* 3. Nothing pending: a release is written at once, as before. */
+    s_io = put1(s_io, 0x64u, SEMA_OFF);
+    s_io = put1(s_io, 0x6Cu, 0x22u);
+    ticket_ready = 0;
+    run_to(s_io);
+    check(vm_read32(LABEL_EA) == 0x22u, "with no report pending a release is immediate");
+
+    /* 4. A count that never arrives: forced after GCM_ZPASS_WAIT_MS, then the
+     *    conservative answer, and the label behind it lands. */
+    ticket_ready = -1;
+    emit_frame(0x33u);
+    run_to(s_io);
+    check(vm_read32(REPORT_EA + 8u) == 0xFFFFu, "a lost count reports visible (0xFFFF)");
+    check(vm_read32(LABEL_EA) == 0x33u, "and does not hold the label behind it");
+
+    ticket_ready = 0;
+    waits = 0;
+    gw32(REPORT_EA + 8u, 0xDEADu);
+    emit_frame(0x44u);
+    run_to(s_io);
+    check(vm_read32(LABEL_EA) == 0x33u, "a late count holds its label for now");
+    s_dq[s_dq_head % GCM_DQ_LEN].t0 -= 100000u;            /* age the report */
+    run_to(s_io);
+    check(waits > 0, "an old report is forced with RSX_ZPASS_WAIT");
+    check(vm_read32(REPORT_EA + 8u) == 0xFFFFu && vm_read32(LABEL_EA) == 0x44u,
+          "a report still late after the wait answers visible, the label lands");
+
+    /* 5. Host counting off: the old constant, at once, and labels too. */
+    host_counting = 0;
+    gw32(REPORT_EA + 8u, 0xDEADu);
+    emit_frame(0x55u);
+    run_to(s_io);
+    check(vm_read32(REPORT_EA + 8u) == 0xFFFFu, "without host counting ZPASS reports 0xFFFF");
+    check(vm_read32(LABEL_EA) == 0x55u, "and the release is immediate");
+
+    printf("[gcm_zpass_report] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_index_decode.c b/libs/video/tests/test_index_decode.c
new file mode 100644
index 00000000..8bff6e95
--- /dev/null
+++ b/libs/video/tests/test_index_decode.c
@@ -0,0 +1,124 @@
+/*
+ * ps3recomp - the draw engine's index decoding
+ *
+ * Random indexed and array draws through the engine against the stub backend
+ * of test_rsx_draw_engine.c: 16- and 32-bit big-endian indices, restart on
+ * and off with sentinels sprinkled through the run, several DRAW_INDEX
+ * batches in one group, strips and lists. Every draw's vertices and indices
+ * are checked against a reference built here from the same guest bytes, so
+ * the specialised decode and the bulk reference reservation must agree with
+ * the plain per-index rules.
+ *
+ * clang -std=gnu17 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video
+ *   -o /tmp/test_index_decode libs/video/tests/test_index_decode.c
+ *   libs/video/rsx_draw_engine.c libs/video/rsx_dispatch.c
+ *   libs/video/rsx_vertex_compact.c libs/video/rsx_texture_layout.c
+ *   libs/video/rsx_vp_decompiler.c libs/video/rsx_fp_decompiler.c
+ */
+#define main old_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+
+#define IDX_AT        0x00040000u      /* main memory */
+#define M_IDX_OFFSET  0x181C
+#define M_IDX_FORMAT  0x1820
+#define M_DRAW_INDEX  0x1824
+#define M_RESTART_EN  0x1DAC
+#define M_RESTART     0x1DB0
+
+static unsigned g_seed = 1u;
+static u32 rnd(u32 n) { g_seed = g_seed * 1103515245u + 12345u; return (g_seed >> 8) % n; }
+
+/* Vertex v: x = v, y = 2v (float32 x4 at VTX_OFFSET, stride 16). */
+static void write_mesh(u32 n)
+{
+    for (u32 v = 0; v < n; v++) {
+        u8* p = vm_base + VTX_OFFSET + v * 16u;
+        const float f[4] = { (float)v, 2.0f * (float)v, 0.0f, 1.0f };
+        for (u32 k = 0; k < 4; k++) {
+            u32 w; memcpy(&w, &f[k], 4);
+            p[k * 4] = (u8)(w >> 24); p[k * 4 + 1] = (u8)(w >> 16);
+            p[k * 4 + 2] = (u8)(w >> 8); p[k * 4 + 3] = (u8)w;
+        }
+    }
+}
+
+int main(void)
+{
+    vm_base = calloc(1, GUEST_BYTES);
+    if (!vm_base) return 2;
+    ppu_vm_size = GUEST_BYTES;
+    write_mesh(64);
+    engine_up();
+    int bad = 0, draws = 0, cut_draws = 0;
+    u64 digest = 1469598103934665603ull;
+    for (int run = 0; run < 3000; run++) {
+        const int is_u32 = (int)rnd(2);
+        const int restart = (int)rnd(2);
+        const u32 sentinel = is_u32 ? 0xFFFFFFFFu : 0xFFFFu;
+        const u32 count = 3u + rnd(18);
+        const u32 nbatch = 1u + rnd(3);
+        /* The index run, guest bytes; one or more batches cover it in order. */
+        u32 idx[24];
+        int has_cut = 0;
+        for (u32 i = 0; i < count; i++) {
+            idx[i] = rnd(64);
+            if (restart && i > 2 && i + 3 < count && rnd(6) == 0) { idx[i] = sentinel; has_cut = 1; }
+            u8* p = vm_base + IDX_AT + i * (is_u32 ? 4u : 2u);
+            if (is_u32) { p[0] = (u8)(idx[i] >> 24); p[1] = (u8)(idx[i] >> 16); p[2] = (u8)(idx[i] >> 8); p[3] = (u8)idx[i]; }
+            else        { p[0] = (u8)(idx[i] >> 8); p[1] = (u8)idx[i]; }
+        }
+        m(M_RESTART_EN, (u32)restart);
+        m(M_RESTART, sentinel);
+        m(M_IDX_OFFSET, IDX_AT);
+        m(M_IDX_FORMAT, 1u | ((is_u32 ? 0u : 1u) << 4));   /* main; bit 4 set = u16 */
+        const u32 prim = has_cut ? RSX_PRIMITIVE_TRIANGLE_STRIP : RSX_PRIMITIVE_TRIANGLES;
+        m(M_BEGIN_END, prim);
+        u32 first = 0;
+        for (u32 b = 0; b < nbatch; b++) {
+            const u32 left = count - first;
+            const u32 n = (b + 1 == nbatch) ? left : 1u + rnd(left - (nbatch - 1u - b));
+            m(M_DRAW_INDEX, first | ((n - 1u) << 24));
+            first += n;
+        }
+        const int before = stub.n_draw;
+        m(M_BEGIN_END, 0u);
+        if (stub.n_draw == before) continue;   /* nothing drawable (all cut) */
+        draws++;
+        if (has_cut) cut_draws++;
+        /* A digest of everything the backend saw, for comparing builds. */
+        digest = digest * 1099511628211ull ^ stub.draw_vertices;
+        digest = digest * 1099511628211ull ^ stub.draw_indices;
+        for (u32 k = 0; k < 24; k++) digest = digest * 1099511628211ull ^ stub.captured_indices[k];
+        for (u32 v = 0; v < 16; v++) for (u32 k = 0; k < sizeof stub.captured_vertices[0]; k++)
+            digest = digest * 1099511628211ull ^ ((const u8*)stub.captured_vertices[v])[k];
+        /* Reference: every drawn index names a vertex whose x is the guest
+         * index at that position of the triangle list the engine rebuilt. */
+        for (u32 k = 0; k < stub.draw_indices && k < 24; k++) {
+            const u32 vi = stub.captured_indices[k];
+            if (vi >= 16 || vi >= stub.draw_vertices) continue;   /* beyond the capture */
+            float x; memcpy(&x, stub.captured_vertices[vi], 4);
+            int found = 0;
+            for (u32 i = 0; i < count; i++)
+                if (idx[i] != sentinel && (float)idx[i] == x) found = 1;
+            if (!found) { bad++; break; }
+        }
+        if (!has_cut && prim == RSX_PRIMITIVE_TRIANGLES) {
+            /* A list without cuts: index k of the draw is guest index k. */
+            for (u32 k = 0; k < stub.draw_indices && k < 24 && k < count; k++) {
+                const u32 vi = stub.captured_indices[k];
+                if (vi >= 16) continue;
+                float x; memcpy(&x, stub.captured_vertices[vi], 4);
+                if (x != (float)idx[k]) { bad++; break; }
+            }
+        }
+    }
+    CHECK(bad == 0 && draws > 2000 && cut_draws > 100,
+          "%d random indexed draws (%d with restart cuts) decode as the guest wrote them (%d bad)",
+          draws, cut_draws, bad);
+    printf("digest of every draw: %016llx\n", (unsigned long long)digest);
+    engine_down();
+    free(vm_base);
+    printf("index decode failures: %d\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/libs/video/tests/test_metal_bind_diff.m b/libs/video/tests/test_metal_bind_diff.m
new file mode 100644
index 00000000..65276ec3
--- /dev/null
+++ b/libs/video/tests/test_metal_bind_diff.m
@@ -0,0 +1,117 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_bind_diff.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_bind_diff
+ *
+ * eng_encode_draw binds only what differs from the draw before it in the same
+ * encoder. Several draws in one encoder -- from a persistent buffer, from the
+ * stage at two offsets (the setVertexBufferOffset path), back to the buffer,
+ * with two viewports and stencil references -- must each draw their own
+ * vertices, and the bound-state record must name what was set last. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static const char* kMSL =
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"struct VIn { float4 a0 [[attribute(0)]]; };\n"
+"struct VOut { float4 pos [[position]]; float4 c; float ps [[point_size]]; };\n"
+"vertex VOut vmain(VIn in [[stage_in]]) {\n"
+"    VOut o; o.pos = float4(-1.0 + (2.0 * in.a0.x + 1.0) / 8.0, 0.0, 0.0, 1.0);\n"
+"    o.c = in.a0; o.ps = 1.0; return o; }\n"
+"fragment float4 fmain(VOut in [[stage_in]]) { return in.c; }\n";
+
+enum { W = 8 };
+
+static void put(float (*v)[4], int i, float x, float tag)
+{
+    v[i][0] = x; v[i][1] = tag; v[i][2] = 0; v[i][3] = 1;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:@(kMSL) options:nil error:&err];
+        assert(lib);
+        rsx_vertex_layout_plan layout;
+        memset(&layout, 0, sizeof layout);
+        layout.mask = 1; layout.count = 1; layout.stride = 16;
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vmain"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fmain"];
+        pd.vertexDescriptor = eng_vertex_descriptor(&layout, 16);
+        pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA32Float;
+        pd.inputPrimitiveTopology = MTLPrimitiveTopologyClassPoint;
+        id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        assert(pso);
+        s_eng_pipe[0].pso = pso;
+        s_eng_pipe[0].ds = [s_dev newDepthStencilStateWithDescriptor:[MTLDepthStencilDescriptor new]];
+        s_eng_pipe[0].cull = MTLCullModeNone;
+        s_eng_pipe[0].winding = MTLWindingCounterClockwise;
+        s_eng_pipe_count = 1;
+
+        float a[2][4], b[2][4], c[2][4], d[2][4];
+        put(a, 0, 0, 1); put(a, 1, 1, 1);
+        put(b, 0, 2, 2); put(b, 1, 3, 2);
+        put(c, 0, 4, 3); put(c, 1, 5, 3);
+        put(d, 0, 6, 4); put(d, 1, 7, 4);
+        const u32 ha = eng_vbuf_create(NULL, a, sizeof a);
+        const u32 hd = eng_vbuf_create(NULL, d, sizeof d);
+        assert(ha && hd);
+        s_eng_pending.pipeline = 1;
+        s_eng_pending.vp[2] = W; s_eng_pending.vp[3] = 1;
+        for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) s_eng_pending.samp[u] = -1;
+        for (u32 u = 0; u < RSX_BE_MAX_VERTEX_TEXTURES; u++) s_eng_pending.vsamp[u] = -1;
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_POINTS, ha, 2, 16, NULL, 0);
+        eng_draw(NULL, RSX_TOPOLOGY_POINTS, b, 2, 16, NULL, 0);
+        s_eng_pending.stencil_ref = 7;
+        eng_draw(NULL, RSX_TOPOLOGY_POINTS, c, 2, 16, NULL, 0);
+        s_eng_pending.vp[2] = W + 0.0f;      /* the same viewport again */
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_POINTS, hd, 2, 16, NULL, 0);
+        assert(s_eng_rec_count == 4 && s_eng_rec[1].vb_off != s_eng_rec[2].vb_off);
+
+        MTLTextureDescriptor* td = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:W height:1 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModeShared;
+        id<MTLTexture> rt = [s_dev newTextureWithDescriptor:td];
+        id<MTLBuffer> stage = [s_dev newBufferWithBytes:s_eng_stage length:s_eng_stage_used
+                                                options:MTLResourceStorageModeShared];
+        id<MTLCommandQueue> q = [s_dev newCommandQueue];
+        id<MTLCommandBuffer> cb = [q commandBuffer];
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture = rt;
+        rp.colorAttachments[0].loadAction = MTLLoadActionClear;
+        rp.colorAttachments[0].clearColor = MTLClearColorMake(-1, -1, -1, -1);
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:rp];
+        s_eng_encoding_failed = 0;
+        eng_bound_reset();
+        for (u32 i = 0; i < s_eng_rec_count; i++) eng_encode_draw(enc, &s_eng_rec[i], stage);
+        /* What is bound now is the last draw's. */
+        assert(s_eng_bound.vb[0] == ENG_PTR(s_vbuf[hd - 1]) && s_eng_bound.vb_off[0] == 0);
+        assert(s_eng_bound.pso == ENG_PTR(pso) && s_eng_bound.stencil_ref == 7 &&
+               s_eng_bound.have_vp && s_eng_bound.vp.width == W);
+        [enc endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(!s_eng_encoding_failed && cb.status == MTLCommandBufferStatusCompleted);
+        float px[W][4];
+        [rt getBytes:px bytesPerRow:sizeof px fromRegion:MTLRegionMake2D(0, 0, W, 1) mipmapLevel:0];
+        for (int x = 0; x < W; x++) {
+            const float want = (float)(x / 2 + 1);
+            if (px[x][0] != (float)x || px[x][1] != want) {
+                fprintf(stderr, "pixel %d: (%g %g), want (%d %g)\n", x, (double)px[x][0],
+                        (double)px[x][1], x, (double)want);
+                return 1;
+            }
+        }
+        s_eng_rec_count = 0;
+        s_eng_stage_used = 0;
+        eng_shutdown(NULL);
+        puts("Metal encode binds only what changed, and every draw reads its own vertices");
+    }
+}
diff --git a/libs/video/tests/test_metal_depth_readback.m b/libs/video/tests/test_metal_depth_readback.m
index 75b8139c..89e2f0ef 100644
--- a/libs/video/tests/test_metal_depth_readback.m
+++ b/libs/video/tests/test_metal_depth_readback.m
@@ -52,7 +52,18 @@ int main(void)
         u32 snap=eng_depth_snapshot(NULL,depth,4,3); eng_submit_and_wait(NULL,0);
         float baseline[12]={0}; [eng_obj(snap) getBytes:baseline bytesPerRow:16 fromRegion:MTLRegionMake2D(0,0,4,3) mipmapLevel:0];
         int baseline_ok=1; for (u32 y=0;y<3;y++) for(u32 x=0;x<4;x++) baseline_ok &= fabsf(baseline[y*4+x]-expected(x,y))<1e-6;
-        CHECK(baseline_ok,"existing depth snapshot preserves nonuniform source"); eng_obj_release(NULL,snap);
+        CHECK(baseline_ok,"existing depth snapshot preserves nonuniform source");
+        /* A smaller snapshot is the top-left region 1:1, not the whole target
+         * scaled down: a texture smaller than its canvas-sized zeta. */
+        u32 crop=eng_depth_snapshot(NULL,depth,2,2); eng_submit_and_wait(NULL,0);
+        CHECK(crop && [eng_obj(crop) width]==2 && [eng_obj(crop) height]==2,"cropped snapshot size");
+        float cropped[4]={0}; if (crop) [eng_obj(crop) getBytes:cropped bytesPerRow:8 fromRegion:MTLRegionMake2D(0,0,2,2) mipmapLevel:0];
+        CHECK(fabsf(cropped[0]-expected(0,0))<1e-6 && fabsf(cropped[1]-expected(1,0))<1e-6 &&
+              fabsf(cropped[2]-expected(0,1))<1e-6 && fabsf(cropped[3]-expected(1,1))<1e-6,"cropped snapshot keeps top-left texels");
+        /* The depth target owns its snapshot: a new one releases the old. */
+        CHECK(s_eng_obj_retired[snap-1] || !s_eng_obj[snap-1],"replaced snapshot released");
+        snap=crop; eng_obj_release(NULL,snap);
+        CHECK(s_eng_depth_snap_of[depth-1]==0,"direct release forgets the snapshot");
         CHECK(s_engine_backend.depth_readback!=NULL,"backend advertises depth readback");
         float out[18]; for(int i=0;i<18;i++)out[i]=-7;
         CHECK(read_depth(depth,0,0,4,3,out,24)==0,"full depth readback with padded rows");
diff --git a/libs/video/tests/test_metal_depth_rgba8.m b/libs/video/tests/test_metal_depth_rgba8.m
new file mode 100644
index 00000000..6606e9d3
--- /dev/null
+++ b/libs/video/tests/test_metal_depth_rgba8.m
@@ -0,0 +1,240 @@
+/* A Z24S8 depth target sampled through A8R8G8B8, both ways the engine can
+ * build it: the GPU copy (depth_snapshot_rgba8) against the guest-memory path
+ * (depth_readback, the engine's 24-bit quantization, the A8R8G8B8 texture
+ * decode, an uploaded texture wearing the crossbar). The two must agree byte
+ * for byte, including the rounding ties and the ends of the range.
+ * clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_depth_rgba8.m libs/video/rsx_texture_layout.c
+ * -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore
+ * -o /tmp/test_metal_depth_rgba8 */
+#include "../rsx_metal_backend.m"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The backend's other dependencies, unused here. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+int rsx_hlsl_to_msl(const char* hlsl, int stage, char* out, u32 out_size, char* log, u32 log_size)
+{ (void)hlsl; (void)stage; (void)out; (void)out_size; (void)log; (void)log_size; return -1; }
+
+static int failures, checks;
+#define CHECK(v, name) do { checks++; if (!(v)) { failures++; fprintf(stderr, "FAIL %s\n", name); } } while (0)
+
+enum { W = 64, H = 9, N = W * H };
+
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"vertex V vs(uint i [[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],0,1)}; }\n"
+"struct D { float d [[depth(any)]]; };\n"
+"fragment D fs(V v [[stage_in]], constant float* z [[buffer(0)]]) { uint2 q = uint2(v.p.xy); return {z[q.y * 64u + q.x]}; }\n"
+"fragment float4 tap_fs(V v [[stage_in]], texture2d<float> t [[texture(0)]]) { return t.read(uint2(v.p.xy)); }\n";
+
+static int complete(id<MTLCommandBuffer> cb)
+{ [cb commit]; [cb waitUntilCompleted]; return cb.status == MTLCommandBufferStatusCompleted && !cb.error; }
+
+static id<MTLRenderPipelineState> pipeline(id<MTLLibrary> lib, const char* fn, int depth)
+{
+    MTLRenderPipelineDescriptor* p = [MTLRenderPipelineDescriptor new];
+    p.vertexFunction = [lib newFunctionWithName:@"vs"];
+    p.fragmentFunction = [lib newFunctionWithName:[NSString stringWithUTF8String:fn]];
+    if (depth) { p.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT; p.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT; }
+    else p.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA32Float;
+    NSError* error = nil;
+    id<MTLRenderPipelineState> r = [s_dev newRenderPipelineStateWithDescriptor:p error:&error];
+    CHECK(r != nil, "fixture pipeline");
+    return r;
+}
+
+/* Stencil is written too (0x5A): the guest-memory copy stores 0 there, and so
+ * must the GPU copy. */
+static int write_depth(u32 handle, id<MTLRenderPipelineState> p, const float* z)
+{
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.depthAttachment.texture = eng_obj(handle); rp.depthAttachment.loadAction = MTLLoadActionClear;
+    rp.depthAttachment.clearDepth = 1; rp.depthAttachment.storeAction = MTLStoreActionStore;
+    rp.stencilAttachment.texture = eng_obj(handle); rp.stencilAttachment.loadAction = MTLLoadActionClear;
+    rp.stencilAttachment.clearStencil = 0x5A; rp.stencilAttachment.storeAction = MTLStoreActionStore;
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+    ds.depthCompareFunction = MTLCompareFunctionAlways; ds.depthWriteEnabled = YES;
+    [e setRenderPipelineState:p];
+    [e setDepthStencilState:[s_dev newDepthStencilStateWithDescriptor:ds]];
+    [e setFragmentBytes:z length:N * sizeof(float) atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    return complete(cb);
+}
+
+/* The guest-memory path, as rsx_draw_engine.c eng_zdepth_to_guest stores the
+ * zeta and the texture cache then decodes it: RGBA8 rows of w x h. */
+static int guest_path(u32 depth, u32 w, u32 h, u8* rgba)
+{
+    float d[N];
+    if (s_engine_backend.depth_readback(NULL, depth, 0, 0, w, h, d, w * 4u) != 0) return 0;
+    u8 packed[N * 4];
+    for (u32 i = 0; i < w * h; i++) {
+        float f = d[i];
+        if (!(f > 0.0f)) f = 0.0f;
+        if (f > 1.0f) f = 1.0f;
+        const u32 v = (u32)((double)f * 16777215.0 + 0.5);
+        packed[4 * i] = (u8)(v >> 16); packed[4 * i + 1] = (u8)(v >> 8);
+        packed[4 * i + 2] = (u8)v; packed[4 * i + 3] = 0;
+    }
+    rsx_tex_layout tl;
+    rsx_texture_layout_pitched(0xE5, w, h, w * 4u, &tl);
+    rsx_texture_decode(rgba, w * 4u, packed, w, h, &tl, 0);
+    return 1;
+}
+
+static int gpu_path(u32 depth, u32 w, u32 h, u8* rgba, u32* handle)
+{
+    const u32 snap = s_engine_backend.depth_snapshot_rgba8(NULL, depth, w, h);
+    if (handle) *handle = snap;
+    if (!snap) return 0;
+    eng_submit_and_wait(NULL, 0);
+    id<MTLTexture> t = eng_obj(snap);
+    if (!t || [t pixelFormat] != MTLPixelFormatRGBA8Unorm || [t width] != w || [t height] != h) return 0;
+    [t getBytes:rgba bytesPerRow:w * 4u fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    return 1;
+}
+
+/* What a shader reads from texture `tex`, every texel, as floats. */
+static int tap(id<MTLRenderPipelineState> p, u32 tex, u32 w, u32 h, float* out)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget; td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> dst = [s_dev newTextureWithDescriptor:td];
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture = dst; rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    [e setRenderPipelineState:p]; [e setFragmentTexture:eng_obj(tex) atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [e endEncoding];
+    if (!complete(cb)) return 0;
+    [dst getBytes:out bytesPerRow:w * 16u fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    return 1;
+}
+
+static u32 first_diff(const u8* a, const u8* b, u32 n)
+{
+    for (u32 i = 0; i < n; i++) if (a[i] != b[i]) return i;
+    return n;
+}
+
+static float next_up(float f) { return nextafterf(f, 2.0f); }
+static float next_dn(float f) { return nextafterf(f, -1.0f); }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice(); CHECK(s_dev != nil, "Metal device"); if (!s_dev) return 1;
+        s_queue = [s_dev newCommandQueue];
+        CHECK(eng_init(NULL, W, H) == 0, "backend helpers (the helper library compiles)");
+        CHECK(s_engine_backend.depth_snapshot_rgba8 != NULL, "backend advertises depth_snapshot_rgba8");
+        if (!s_engine_backend.depth_snapshot_rgba8) { printf("%d checks, %d failures\n", checks, failures); return 1; }
+        NSError* error = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:[NSString stringWithUTF8String:fixture] options:nil error:&error];
+        CHECK(lib != nil, "fixture shaders"); if (!lib) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return 1; }
+        id<MTLRenderPipelineState> zp = pipeline(lib, "fs", 1), tp = pipeline(lib, "tap_fs", 0);
+
+        /* The depths: the ends, the 24-bit ties (k + 0.5) / 16777215 and
+         * their neighbours, exact steps, the powers of two (0.5 * 16777215 is
+         * itself a tie), tiny values, the float just below 1, then noise. */
+        float z[N];
+        u32 n = 0;
+        const float fixed[] = { 0.0f, 1.0f, 0.5f, 0.25f, 0.75f, 0.125f, 1.0f / 3.0f, 2.0f / 3.0f,
+                                next_dn(1.0f), next_dn(next_dn(1.0f)), 0x1p-24f, 0x1p-25f, 3 * 0x1p-25f,
+                                0x1p-26f, 0x1p-40f, 0x1p-126f, next_up(0.5f), next_dn(0.5f),
+                                0.999f, 0.001f, 0.9999999f };
+        for (u32 i = 0; i < sizeof fixed / sizeof fixed[0]; i++) z[n++] = fixed[i];
+        const u32 ks[] = { 1, 2, 3, 255, 256, 65535, 65536, 0x7FFFFF, 0x800000, 0xABCDEF,
+                           0xFFFFFD, 0xFFFFFE, 0x123456, 0xFEDCBA, 0x00FF00, 0x0000FF, 0xFF0000 };
+        for (u32 i = 0; i < sizeof ks / sizeof ks[0]; i++) {
+            const float step = (float)((double)ks[i] / 16777215.0);
+            const float tie = (float)(((double)ks[i] + 0.5) / 16777215.0);
+            z[n++] = step; z[n++] = next_up(step); z[n++] = next_dn(step);
+            z[n++] = tie;  z[n++] = next_up(tie);  z[n++] = next_dn(tie);
+        }
+        srand(12345);
+        while (n < N) {
+            float f = (float)rand() / (float)RAND_MAX;
+            if (n & 1) f = 1.0f - f * f * f * 0.01f;      /* crowd the far plane, as scenes do */
+            z[n++] = f;
+        }
+
+        u32 depth = eng_depth_target_create(NULL, W, H); CHECK(depth != 0, "depth target");
+        CHECK(write_depth(depth, zp, z), "depth and stencil written");
+
+        u8 gpu[N * 4], ref[N * 4];
+        u32 snap = 0;
+        CHECK(gpu_path(depth, W, H, gpu, &snap), "GPU copy built and read");
+        CHECK(guest_path(depth, W, H, ref), "guest-memory path built");
+        u32 d = first_diff(gpu, ref, N * 4);
+        if (d < N * 4) fprintf(stderr, "  texel %u (z %.9g): gpu %02X %02X %02X %02X, guest %02X %02X %02X %02X\n",
+                               d / 4, z[d / 4], gpu[d & ~3u], gpu[(d & ~3u) + 1], gpu[(d & ~3u) + 2], gpu[(d & ~3u) + 3],
+                               ref[d & ~3u], ref[(d & ~3u) + 1], ref[(d & ~3u) + 2], ref[(d & ~3u) + 3]);
+        CHECK(d == N * 4, "GPU copy equals the guest-memory decode byte for byte");
+        /* Spot checks of the layout itself: depth 0.5 -> 0x800000 (a tie,
+         * rounded up), 1 -> 0xFFFFFF, stencil not carried. */
+        CHECK(gpu[2 * 4 + 3] == 0x80 && gpu[2 * 4 + 0] == 0x00 && gpu[2 * 4 + 1] == 0x00 && gpu[2 * 4 + 2] == 0x00,
+              "0.5 reads A=0x80 R=0 G=0 B=0");
+        CHECK(gpu[1 * 4 + 3] == 0xFF && gpu[1 * 4 + 0] == 0xFF && gpu[1 * 4 + 1] == 0xFF && gpu[1 * 4 + 2] == 0x00,
+              "1.0 reads A=R=G=0xFF, B (stencil) 0");
+
+        /* Same size again: the same persistent copy, re-rendered in stream
+         * order, and the R32F snapshot / readback paths leave it alone. */
+        u32 again = 0;
+        CHECK(gpu_path(depth, W, H, gpu, &again) && again == snap, "same size reuses the copy");
+        CHECK(s_eng_depth_rgba_of[depth - 1] == snap, "readback did not release the colour-format copy");
+
+        /* New depth: the copy follows it. */
+        for (u32 i = 0; i < N; i++) z[i] = 1.0f - z[i];
+        CHECK(write_depth(depth, zp, z), "depth rewritten");
+        CHECK(gpu_path(depth, W, H, gpu, &again) && again == snap, "re-rendered in place");
+        CHECK(guest_path(depth, W, H, ref), "guest path of the new depth");
+        CHECK(first_diff(gpu, ref, N * 4) == N * 4, "re-rendered copy equals the guest-memory decode");
+
+        /* A texture smaller than its zeta: the top-left region 1:1. */
+        u8 crop[N * 4], cref[N * 4];
+        u32 small = 0;
+        CHECK(gpu_path(depth, 40, 5, crop, &small) && small && small != snap, "cropped copy built");
+        CHECK(s_eng_obj_retired[snap - 1] || !s_eng_obj[snap - 1], "the other-size copy was released");
+        CHECK(guest_path(depth, 40, 5, cref), "cropped guest path");
+        CHECK(first_diff(crop, cref, 40 * 5 * 4) == 40 * 5 * 4, "cropped copy equals the guest decode of that region");
+
+        /* Through the unit's crossbar: the engine binds a surface_view of the
+         * copy; the guest path an uploaded texture with the remap baked in. */
+        CHECK(gpu_path(depth, W, H, gpu, &snap) && guest_path(depth, W, H, ref), "full-size copies again");
+        const u32 remaps[] = { 0xAAE4u, 0xAA93u, 0xAA1Bu, 0xAA4Eu, 0x5500u | 0xE4u, 0x00E4u, 0xA9C6u };
+        static float a[N * 4], b[N * 4];
+        for (u32 i = 0; i < sizeof remaps / sizeof remaps[0]; i++) {
+            const u32 view = eng_surface_view(NULL, snap, remaps[i], 0xE5);
+            const u32 up = eng_texture_create(NULL, RSX_BE_FMT_R8G8B8A8, W, H, 1, 1, remaps[i], 0xE5);
+            eng_texture_upload(NULL, up, 0, 0, W, H, ref, W * 4u, H);
+            char name[96];
+            snprintf(name, sizeof name, "crossbar %04X: the view samples as the uploaded texture", remaps[i]);
+            CHECK(view && up && tap(tp, view, W, H, a) && tap(tp, up, W, H, b) && !memcmp(a, b, sizeof a), name);
+            eng_obj_release(NULL, up);
+        }
+
+        /* The depth target owns the copy: releasing it frees the copy and its views. */
+        eng_submit_and_wait(NULL, 0);
+        eng_obj_release(NULL, depth);
+        CHECK(s_eng_depth_rgba_of[depth - 1] == 0, "the depth target's release forgets the copy");
+        CHECK(s_eng_obj_retired[snap - 1] || !s_eng_obj[snap - 1], "and releases it");
+        eng_collect_retired_objects();
+        int none = 1;
+        for (u32 i = 0; i < s_eng_obj_count; i++) none &= s_eng_obj[i] == nil;
+        CHECK(none, "no live objects left");
+        CHECK(!s_eng_encoding_failed, "every record encoded");
+
+        printf("%d checks, %d failures\n", checks, failures);
+        eng_shutdown(NULL);
+        return failures ? 1 : 0;
+    }
+}
diff --git a/libs/video/tests/test_metal_host_surface.m b/libs/video/tests/test_metal_host_surface.m
new file mode 100644
index 00000000..2fa5aa0d
--- /dev/null
+++ b/libs/video/tests/test_metal_host_surface.m
@@ -0,0 +1,265 @@
+/* clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_host_surface.m
+ * libs/video/rsx_texture_layout.c libs/video/rsx_vertex_fetch.c libs/video/rsx_vp_decompiler.c
+ * libs/video/rsx_fp_decompiler.c libs/video/rsx_shader_msl.cpp -lc++ -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -framework IOSurface
+ * -o /tmp/test_metal_host_surface
+ *
+ * Host-surface mode (PS3RECOMP_HOST_SURFACES, rsx_host_surface.h) against a
+ * launcher fixture in this process: a bootstrap service on a thread that
+ * hands out a control page and IOSurfaces the way tools/host_window does.
+ *   - the surface state machine on its own (take, publish, reclaim, read);
+ *   - init attaches and opens no window; an engine present lands in a
+ *     surface, is published with a FRAME message, and reads back right;
+ *   - presents nobody reads never stall: old frames are reclaimed;
+ *   - the vtable path renders into the surface, and a display resize asks
+ *     the launcher for surfaces of the new size;
+ *   - `closed` makes the pump report the window gone;
+ *   - a second init (the image an exec brings up) attaches again, frames the
+ *     old image left RENDERING are freed, and the sequence keeps rising;
+ *   - export_window_state hands nothing over. */
+#include "../rsx_metal_backend.m"
+#include <IOSurface/IOSurface.h>
+#include <assert.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+void rsx_set_backend(rsx_backend* b) { (void)b; }
+void rsx_state_shadow_enable(int on) { (void)on; }   /* rsx_commands.c's; the backend turns the shadow off */
+void rsx_draw_engine_set_backend(const rsx_draw_backend* b) { (void)b; }
+void rsx_draw_engine_set_default(int on) { (void)on; }
+int  rsx_draw_engine_enabled(void) { return 1; }
+int  rsx_draw_engine_init(u32 w, u32 h) { return eng_init(NULL, w, h); }
+void rsx_draw_engine_shutdown(void) { eng_shutdown(NULL); }
+void rsx_draw_engine_present(void) {}
+u32  rsx_draw_engine_readback_center(void) { return 0; }
+u32  rsx_draw_engine_guest_draws(void) { return 0; }
+int  cellGcmOffsetIsDisplay(u32 off) { (void)off; return 1; }
+/* The vtable path is linked in; no draw reaches guest memory here. */
+u32  cellGcmResolveLocated(int location, u32 offset) { (void)location; return offset; }
+u32  cellGcmResolveOffset(u32 offset) { return offset; }
+u8*  vm_base;
+
+/* ---- the launcher fixture ------------------------------------------------ */
+
+static mach_port_t       f_service, f_entry;
+static rsx_host_control* f_ctl;
+static IOSurfaceRef      f_surf[RSX_HOST_SLOTS];
+static u32               f_w, f_h;
+static atomic_int        f_frames, f_attaches;
+
+static void f_make_surfaces(u32 w, u32 h)
+{
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        if (f_surf[i]) CFRelease(f_surf[i]);
+        NSDictionary* p = @{ (id)kIOSurfaceWidth: @(w), (id)kIOSurfaceHeight: @(h),
+                             (id)kIOSurfaceBytesPerElement: @4,
+                             (id)kIOSurfacePixelFormat: @((u32)'BGRA') };
+        f_surf[i] = IOSurfaceCreate((__bridge CFDictionaryRef)p);
+        assert(f_surf[i]);
+        if (atomic_load(&f_ctl->state[i]) != RSX_HOST_READING)
+            atomic_store(&f_ctl->state[i], RSX_HOST_FREE);
+    }
+    f_w = w; f_h = h;
+    f_ctl->width = w; f_ctl->height = h;
+    f_ctl->generation++;
+}
+
+static void* f_thread(void* unused)
+{
+    (void)unused;
+    for (;;) {
+        struct { rsx_host_attach_msg m; mach_msg_trailer_t t; } in;
+        memset(&in, 0, sizeof in);
+        if (mach_msg(&in.m.header, MACH_RCV_MSG, 0, sizeof in, f_service, 0, MACH_PORT_NULL))
+            continue;
+        if (in.m.header.msgh_id == RSX_HOST_MSG_FRAME) { atomic_fetch_add(&f_frames, 1); continue; }
+        assert(in.m.header.msgh_id == RSX_HOST_MSG_ATTACH);
+        assert(in.m.pid == getpid());
+        if (in.m.width && (in.m.width != f_w || in.m.height != f_h)) f_make_surfaces(in.m.width, in.m.height);
+        else rsx_host_reset_rendering(f_ctl);
+        rsx_host_surfaces_msg r;
+        memset(&r, 0, sizeof r);
+        r.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_MOVE_SEND_ONCE, 0) | MACH_MSGH_BITS_COMPLEX;
+        r.header.msgh_size = sizeof r;
+        r.header.msgh_remote_port = in.m.header.msgh_remote_port;
+        r.header.msgh_id = RSX_HOST_MSG_SURFACES;
+        r.body.msgh_descriptor_count = 1 + RSX_HOST_SLOTS;
+        r.control.name = f_entry; r.control.disposition = MACH_MSG_TYPE_COPY_SEND;
+        r.control.type = MACH_MSG_PORT_DESCRIPTOR;
+        for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+            r.surface[i].name = IOSurfaceCreateMachPort(f_surf[i]);
+            r.surface[i].disposition = MACH_MSG_TYPE_MOVE_SEND;
+            r.surface[i].type = MACH_MSG_PORT_DESCRIPTOR;
+        }
+        r.width = f_w; r.height = f_h; r.generation = f_ctl->generation; r.launcher_pid = getpid();
+        assert(mach_msg(&r.header, MACH_SEND_MSG, sizeof r, 0, MACH_PORT_NULL, 0, MACH_PORT_NULL) == KERN_SUCCESS);
+        atomic_fetch_add(&f_attaches, 1);
+    }
+    return NULL;
+}
+
+static void f_start(void)
+{
+    char name[128];
+    snprintf(name, sizeof name, "org.ps3recomp.test-host-surface.%d", getpid());
+    assert(bootstrap_check_in(bootstrap_port, name, &f_service) == KERN_SUCCESS);
+    vm_address_t a = 0;
+    assert(vm_allocate(mach_task_self(), &a, RSX_HOST_CONTROL_BYTES, VM_FLAGS_ANYWHERE) == KERN_SUCCESS);
+    memory_object_size_t sz = RSX_HOST_CONTROL_BYTES;
+    assert(mach_make_memory_entry_64(mach_task_self(), &sz, a, VM_PROT_READ | VM_PROT_WRITE,
+                                     &f_entry, MACH_PORT_NULL) == KERN_SUCCESS);
+    f_ctl = (rsx_host_control*)a;
+    f_ctl->magic = RSX_HOST_MAGIC; f_ctl->version = RSX_HOST_VERSION; f_ctl->launcher_pid = getpid();
+    f_make_surfaces(64, 32);
+    pthread_t t;
+    assert(pthread_create(&t, NULL, f_thread, NULL) == 0);
+    setenv(RSX_HOST_SURFACE_ENV, name, 1);
+}
+
+/* Wait until `n` frames are published (a FRAME wake may be dropped when the
+ * queue is full, so count publishes, not messages), then take the newest
+ * frame as the launcher would and return its centre pixel (BGRA, as a
+ * little-endian u32). */
+static u32 f_read_newest(int n, uint64_t* seq_out)
+{
+    for (int i = 0; i < 400 && atomic_load(&f_ctl->published) < (uint64_t)n; i++) usleep(5000);
+    assert(atomic_load(&f_ctl->published) >= (uint64_t)n);
+    for (int i = 0; i < 400 && atomic_load(&f_frames) == 0; i++) usleep(5000);
+    assert(atomic_load(&f_frames) > 0);
+    static uint64_t shown;
+    uint64_t seq = 0;
+    const int slot = rsx_host_begin_read(f_ctl, shown, &seq);
+    assert(slot >= 0 && seq > shown);
+    shown = seq;
+    IOSurfaceRef s = f_surf[slot];
+    IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+    const u8* base = IOSurfaceGetBaseAddress(s);
+    u32 px;
+    memcpy(&px, base + (f_h / 2) * IOSurfaceGetBytesPerRow(s) + (f_w / 2) * 4, 4);
+    IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+    rsx_host_end_read(f_ctl, slot);
+    if (seq_out) *seq_out = seq;
+    return px;
+}
+
+static id<MTLTexture> solid(u32 w, u32 h, u32 bgra)
+{
+    MTLTextureDescriptor* d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+    d.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [s_dev newTextureWithDescriptor:d];
+    u32* px = malloc((size_t)w * h * 4);
+    for (u32 i = 0; i < w * h; i++) px[i] = bgra;
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+/* ---- the state machine alone --------------------------------------------- */
+
+static void check_states(void)
+{
+    static rsx_host_control c;
+    memset(&c, 0, sizeof c);
+    int r[RSX_HOST_SLOTS];
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) { r[i] = rsx_host_begin_render(&c); assert(r[i] == i); }
+    assert(rsx_host_begin_render(&c) == -1 && c.skipped == 1);      /* all rendering */
+    rsx_host_end_render(&c, r[0], 1, 1);
+    rsx_host_end_render(&c, r[1], 1, 2);
+    rsx_host_end_render(&c, r[2], 0, 3);                            /* failed frame: back to FREE */
+    assert(c.state[2] == RSX_HOST_FREE && c.published == 2);
+    assert(rsx_host_begin_render(&c) == 2);
+    assert(rsx_host_begin_render(&c) == 0 && c.reclaimed == 1);     /* oldest READY taken back */
+    uint64_t q = 0;
+    assert(rsx_host_begin_read(&c, 0, &q) == 1 && q == c.seq[1]);
+    assert(rsx_host_begin_read(&c, q, &q) == -1);                   /* nothing newer */
+    rsx_host_end_read(&c, 1);
+    assert(c.state[1] == RSX_HOST_FREE);
+    /* Several READY: the newest is read and the older ones are freed. */
+    memset(&c, 0, sizeof c);
+    for (int i = 0; i < 3; i++) { assert(rsx_host_begin_render(&c) == i); }
+    for (int i = 0; i < 3; i++) rsx_host_end_render(&c, i, 1, 10 + i);
+    assert(rsx_host_begin_read(&c, 0, &q) == 2 && q == 3);
+    assert(c.state[0] == RSX_HOST_FREE && c.state[1] == RSX_HOST_FREE && c.state[2] == RSX_HOST_READING);
+    /* A reader never takes a frame at or below the one it last showed. */
+    rsx_host_end_read(&c, 2);
+    assert(rsx_host_begin_render(&c) == 0);
+    atomic_store(&c.seq[0], 2); atomic_store(&c.state[0], RSX_HOST_READY);
+    assert(rsx_host_begin_read(&c, 3, &q) == -1);
+    rsx_host_reset_rendering(&c);
+    puts("state machine: ok");
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        check_states();
+        f_start();
+
+        assert(rsx_metal_backend_init(64, 32, "test") == 0);
+        assert(s_host && !s_headless && s_window == nil && NSApp == nil);
+        assert(s_host_w == 64 && s_host_h == 32 && s_eng_active);
+        assert(atomic_load(&f_ctl->producer_pid) == getpid());
+
+        /* Engine present: the source lands in a host surface. */
+        eng_encode_and_commit(solid(64, 32, 0xFF3366CCu));
+        assert(f_read_newest(1, NULL) == 0xFF3366CCu);
+        puts("engine present: ok");
+
+        /* Nobody reading: no stall, older frames reclaimed. */
+        id<MTLTexture> red = solid(64, 32, 0xFFFF0000u);
+        for (int i = 0; i < 40; i++) eng_encode_and_commit(red);
+        host_drain();
+        assert(atomic_load(&f_ctl->published) == 41 && atomic_load(&f_ctl->skipped) == 0);
+        assert(atomic_load(&f_ctl->reclaimed) > 0);
+        uint64_t seq1 = 0;
+        assert(f_read_newest(41, &seq1) == 0xFFFF0000u && seq1 == 41);
+        printf("40 unread presents: published 41, reclaimed %llu\n",
+               (unsigned long long)atomic_load(&f_ctl->reclaimed));
+
+        /* Guest frames reach the launcher's counter. */
+        rsx_metal_backend_note_guest_frame();
+        assert(atomic_load(&f_ctl->guest_frames) == 1);
+
+        /* The vtable path: the frame's first pass clears to the guest colour,
+         * straight into the surface. Then a display resize. */
+        s_eng_active = 0;
+        s_clear_argb = 0xFF00FF00u;
+        rsx_metal_backend_present();
+        assert(f_read_newest(42, NULL) == 0xFF00FF00u);
+        s_width = 128; s_height = 64;
+        assert(create_depth() == 0);
+        rsx_metal_backend_present();
+        assert(s_host_w == 128 && s_host_h == 64 && f_w == 128 && f_ctl->generation == 2);
+        assert(f_read_newest(43, NULL) == 0xFF00FF00u);
+        puts("vtable present and resize: ok");
+
+        /* The launcher closing its window. */
+        assert(rsx_metal_backend_pump_messages() == 0);
+        atomic_store(&f_ctl->closed, 1);
+        rsx_metal_backend_present();
+        assert(rsx_metal_backend_pump_messages() == -1);
+        atomic_store(&f_ctl->closed, 0);
+        puts("closed -> pump -1: ok");
+
+        /* What an exec brings up: shutdown (the old image is gone), a frame
+         * it left RENDERING, a fresh init that attaches again. */
+        rsx_metal_backend_export_window_state();
+        assert(getenv("PS3RECOMP_WINDOW_STATE") == NULL);
+        rsx_metal_backend_shutdown();
+        assert(!s_host && !s_host_ctl);
+        assert(rsx_host_begin_render(f_ctl) >= 0);          /* left behind */
+        const int before = atomic_load(&f_attaches);
+        assert(rsx_metal_backend_init(128, 64, "test") == 0);
+        assert(s_host && atomic_load(&f_attaches) == before + 1);
+        for (int i = 0; i < RSX_HOST_SLOTS; i++)
+            assert(atomic_load(&f_ctl->state[i]) != RSX_HOST_RENDERING);
+        eng_encode_and_commit(solid(128, 64, 0xFF0000FFu));
+        uint64_t seq2 = 0;
+        assert(f_read_newest(45, &seq2) == 0xFF0000FFu && seq2 == 45 && seq2 > seq1);   /* 44: the present that saw `closed` */
+        puts("re-attach after exec: ok");
+        rsx_metal_backend_shutdown();
+        puts("test_metal_host_surface: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_image_io.m b/libs/video/tests/test_metal_image_io.m
new file mode 100644
index 00000000..bcfafc1c
--- /dev/null
+++ b/libs/video/tests/test_metal_image_io.m
@@ -0,0 +1,61 @@
+/* The Metal backend's image files for texture packs (eng_image_load /
+ * eng_image_save, PS3_MODS and PS3_MODS_DUMP): what the dump writes reads
+ * back byte for byte, straight alpha included; a grey PNG and a file that is
+ * not an image.
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_image_io.m \
+ *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
+ *     -o /tmp/test_metal_image_io && /tmp/test_metal_image_io
+ */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        char dir[] = "/tmp/metal_image_io_XXXXXX";
+        assert(mkdtemp(dir));
+        char path[256];
+        snprintf(path, sizeof path, "%s/sub.png", dir);
+
+        /* 3x2 with a padded source row, translucent texels and alpha 0 */
+        enum { W = 3, H = 2, ROW = 16 };
+        u8 src[ROW * H];
+        memset(src, 0xEE, sizeof src);
+        for (u32 y = 0; y < H; y++)
+            for (u32 x = 0; x < W; x++) {
+                u8* p = src + y * ROW + x * 4;
+                p[0] = (u8)(40 * x + 7); p[1] = (u8)(90 * y + 3); p[2] = 200; p[3] = (u8)(x == 0 ? 0 : x == 1 ? 0x80 : 0xFF);
+            }
+        assert(eng_image_save(NULL, path, src, W, H, ROW));
+        for (int i = 0; i < 200 && access(path, F_OK) != 0; i++) usleep(10 * 1000);   /* written later */
+        usleep(50 * 1000);
+        u8* back = NULL; u32 w = 0, h = 0;
+        assert(eng_image_load(NULL, path, &back, &w, &h) && back && w == W && h == H);
+        for (u32 y = 0; y < H; y++)
+            assert(!memcmp(back + y * W * 4, src + y * ROW, W * 4));   /* exact, alpha 0 too */
+        free(back);
+
+        /* a grey PNG reads as grey RGBA */
+        NSBitmapImageRep* g = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:2 pixelsHigh:1
+            bitsPerSample:8 samplesPerPixel:1 hasAlpha:NO isPlanar:NO colorSpaceName:NSDeviceWhiteColorSpace
+            bytesPerRow:2 bitsPerPixel:8];
+        g.bitmapData[0] = 17; g.bitmapData[1] = 250;
+        snprintf(path, sizeof path, "%s/grey.png", dir);
+        assert([[g representationUsingType:NSBitmapImageFileTypePNG properties:@{}] writeToFile:@(path) atomically:YES]);
+        assert(eng_image_load(NULL, path, &back, &w, &h) && w == 2 && h == 1);
+        assert(back[0] == 17 && back[1] == 17 && back[2] == 17 && back[3] == 255 && back[4] == 250);
+        free(back);
+
+        /* not an image */
+        snprintf(path, sizeof path, "%s/notes.png", dir);
+        FILE* f = fopen(path, "w"); fputs("hello", f); fclose(f);
+        assert(!eng_image_load(NULL, path, &back, &w, &h) && back == NULL);
+        snprintf(path, sizeof path, "rm -rf '%s'", dir);
+        if (system(path) != 0) fprintf(stderr, "could not remove %s\n", dir);
+        puts("test_metal_image_io: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_occlusion.m b/libs/video/tests/test_metal_occlusion.m
new file mode 100644
index 00000000..6e9c0967
--- /dev/null
+++ b/libs/video/tests/test_metal_occlusion.m
@@ -0,0 +1,168 @@
+/* The Metal backend's ZPASS counting and polygon offset, on the GPU, with
+ * synthetic programs and no title data: samples counted per query, nothing
+ * reported before the draws are submitted, a query that drew nothing behind
+ * the depth buffer reports 0, scissored draws count only their pixels, and
+ * the depth bias (set_depth_bias) moves a coplanar draw in front of or behind
+ * the depth it is tested against.
+ *
+ * clang -fobjc-arc -I include -I libs/video
+ *   libs/video/tests/test_metal_occlusion.m libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp -lc++
+ *   -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore
+ *   -o /tmp/test_metal_occlusion && /tmp/test_metal_occlusion
+ */
+#include "../rsx_metal_backend.m"
+#include <stdio.h>
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static int failures, checks;
+#define CHECK(v, name) do { checks++; if (!(v)) { failures++; fprintf(stderr, "FAIL %s\n", name); } \
+                            else printf("[PASS] %s\n", name); } while (0)
+
+/* A full-viewport triangle at a fixed depth per vertex function. */
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"static V at(uint i, float z) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],z,1)}; }\n"
+"vertex V vs_front(uint i [[vertex_id]]) { return at(i, 0.25f); }\n"
+"vertex V vs_mid(uint i [[vertex_id]])   { return at(i, 0.5f); }\n"
+"vertex V vs_back(uint i [[vertex_id]])  { return at(i, 0.75f); }\n"
+"vertex V vs_step(uint i [[vertex_id]])  { return at(i, 0.5f + 100.0f / 16777216.0f); }\n"
+"fragment float4 fs(V v [[stage_in]]) { return float4(1,0,0,1); }\n";
+
+static id<MTLLibrary> s_lib;
+
+/* Put a pipeline straight into the backend's table: the HLSL translator is
+ * not linked into this test, and what is under test is the encoding. */
+static u32 add_pipeline(const char* vs, MTLCompareFunction cmp, BOOL write)
+{
+    MTLRenderPipelineDescriptor* p = [MTLRenderPipelineDescriptor new];
+    p.vertexFunction = [s_lib newFunctionWithName:[NSString stringWithUTF8String:vs]];
+    p.fragmentFunction = [s_lib newFunctionWithName:@"fs"];
+    p.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    p.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+    p.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+    NSError* err = nil;
+    id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:p error:&err];
+    if (!pso) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 0; }
+    MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+    ds.depthCompareFunction = cmp;
+    ds.depthWriteEnabled = write;
+    EngPipeline* e = &s_eng_pipe[s_eng_pipe_count++];
+    e->pso = pso;
+    e->ds = [s_dev newDepthStencilStateWithDescriptor:ds];
+    e->cull = MTLCullModeNone;
+    e->winding = MTLWindingCounterClockwise;
+    e->building = 0;
+    return s_eng_pipe_count;
+}
+
+static void draw(u32 pipeline, u32 query, float slope, float units, u32 bits)
+{
+    static const float verts[3][4];
+    eng_bind_pipeline(NULL, pipeline);
+    eng_set_depth_bias(NULL, slope, units, bits);
+    eng_set_occlusion(NULL, query);
+    eng_draw(NULL, RSX_TOPOLOGY_TRIANGLES, verts, 3, 16, NULL, 0);
+}
+
+static int result(u32 query, u64* n) { *n = ~0ull; return eng_occlusion_result(NULL, query, n); }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice(); CHECK(s_dev != nil, "Metal device"); if (!s_dev) return 1;
+        s_queue = [s_dev newCommandQueue];
+        CHECK(eng_init(NULL, 8, 8) == 0, "backend helpers");
+        NSError* err = nil;
+        s_lib = [s_dev newLibraryWithSource:[NSString stringWithUTF8String:fixture] options:nil error:&err];
+        if (!s_lib) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 1; }
+        const u32 color = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 8, 8, NULL, 0);
+        const u32 depth = eng_depth_target_create(NULL, 8, 8);
+        CHECK(color && depth, "targets");
+        const u32 mid_write = add_pipeline("vs_mid", MTLCompareFunctionLess, YES);
+        const u32 back_test = add_pipeline("vs_back", MTLCompareFunctionLess, NO);
+        const u32 front_test = add_pipeline("vs_front", MTLCompareFunctionLess, NO);
+        const u32 mid_less = add_pipeline("vs_mid", MTLCompareFunctionLess, NO);
+        const u32 mid_lequal = add_pipeline("vs_mid", MTLCompareFunctionLessEqual, NO);
+        CHECK(mid_write && back_test && front_test && mid_less && mid_lequal, "pipelines");
+
+        eng_bind_targets(NULL, &color, 1, depth);
+        eng_set_viewport(NULL, 0, 0, 8, 8);
+        eng_set_scissor(NULL, 0, 0, 8, 8);
+        eng_set_stencil_ref(NULL, 0);
+        eng_clear_depth_stencil(NULL, depth, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL, 1.0f, 0);
+
+        u64 n;
+        /* 1: the whole 8x8 target at 0.5, writing depth. */
+        draw(mid_write, 1, 0, 0, 24);
+        /* 2: everything behind it. */
+        draw(back_test, 2, 0, 0, 24);
+        /* 3: in front of it, but scissored to 4x2. */
+        eng_set_scissor(NULL, 2, 3, 4, 2);
+        draw(front_test, 3, 0, 0, 24);
+        eng_set_scissor(NULL, 0, 0, 8, 8);
+        /* 4: two draws into one query: 64 + 64. */
+        draw(front_test, 4, 0, 0, 24);
+        draw(front_test, 4, 0, 0, 24);
+        /* A draw that is not counted. */
+        draw(front_test, 0, 0, 0, 24);
+        /* 5, 6: coplanar with the depth it tests against, LESS: rejected
+         * without a bias, passes when pulled toward the viewer (-1 slope,
+         * -256 units, Resistance's decal offset). 7: LEQUAL pushed away. */
+        draw(mid_less, 5, 0, 0, 24);
+        draw(mid_less, 6, -1.0f, -256.0f, 24);
+        draw(mid_lequal, 7, 0, 256.0f, 24);
+
+        CHECK(result(1, &n) == 2, "a recorded, unsubmitted query says so");
+        CHECK(result(99, &n) == -1, "an unknown query is unknown");
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(1, &n) == 1 && n == 64, "full-target draw counts every sample");
+        CHECK(result(2, &n) == 1 && n == 0, "a draw behind the depth buffer counts 0");
+        CHECK(result(3, &n) == 1 && n == 8, "a scissored draw counts its pixels only");
+        CHECK(result(4, &n) == 1 && n == 128, "two draws in one query add up");
+        CHECK(result(5, &n) == 1 && n == 0, "coplanar LESS without bias is rejected");
+        CHECK(result(6, &n) == 1 && n == 64, "negative polygon offset pulls the draw in front");
+        CHECK(result(7, &n) == 1 && n == 0, "positive polygon offset pushes it behind (LEQUAL)");
+
+
+        /* A Z16 unit is 256 of Z24's. Against a depth 100 Z24 units behind
+         * 0.5, a draw at 0.5 pushed back one Z24 unit still passes LESS; one
+         * pushed back one Z16 unit (256 Z24 units) does not. */
+        const u32 depth2 = eng_depth_target_create(NULL, 8, 8);
+        const u32 step_write = add_pipeline("vs_step", MTLCompareFunctionAlways, YES);
+        eng_bind_targets(NULL, &color, 1, depth2);
+        eng_clear_depth_stencil(NULL, depth2, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL, 1.0f, 0);
+        draw(step_write, 0, 0, 0, 24);
+        draw(mid_less, 11, 0, 1.0f, 24);
+        draw(mid_less, 12, 0, 1.0f, 16);
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(11, &n) == 1 && n == 64, "one Z24 unit of bias stays in front of a 100-unit step");
+        CHECK(result(12, &n) == 1 && n == 0, "one Z16 unit of bias is 256 Z24 units");
+        eng_bind_targets(NULL, &color, 1, depth);
+
+        /* Queries across commits: the slots of the first commit are free. */
+        draw(front_test, 9, 0, 0, 24);
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(9, &n) == 1 && n == 64, "a later commit counts again");
+        CHECK(result(1, &n) == 1 && n == 64, "an earlier result stays readable");
+
+        /* An asynchronous commit (a windowed present): the count is pending
+         * while the command buffer runs and harvested once it has completed. */
+        draw(front_test, 13, 0, 0, 24);
+        {
+            id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+            eng_encode_records(cb, s_eng_slot >= 0 ? s_eng_slot_buf[s_eng_slot] : nil);
+            [cb commit];
+            eng_vis_committed(cb, 0);
+            s_eng_rec_count = 0; s_eng_stage_used = 0; s_eng_slot = -1;
+            const int r = result(13, &n);
+            CHECK(r == 0 || r == 1, "an in-flight query is pending, never 'unsubmitted'");
+            [cb waitUntilCompleted];
+            CHECK(result(13, &n) == 1 && n == 64, "harvested once its command buffer completes");
+        }
+
+        printf("%d checks, %d failures\n", checks, failures);
+        eng_shutdown(NULL);
+        return failures ? 1 : 0;
+    }
+}
diff --git a/libs/video/tests/test_metal_present_post.m b/libs/video/tests/test_metal_present_post.m
index 357ec012..a8820fcf 100644
--- a/libs/video/tests/test_metal_present_post.m
+++ b/libs/video/tests/test_metal_present_post.m
@@ -1,6 +1,8 @@
-/* The draw engine's present pass with PS3_AA=fxaa and PS3_SHARPEN: what each
- * one does to a small synthetic display buffer, and that with both off the
- * present is still an exact copy. Needs a Metal device; no window.
+/* The draw engine's present pass with PS3_AA=fxaa or smaa, PS3_SHARPEN and the
+ * colour filters (PS3_VIBRANCE, PS3_CONTRAST, PS3_LUT, PS3_VIGNETTE,
+ * PS3_GRAIN): what each one does to a small synthetic display buffer, and
+ * that with all of them off the present is still an exact copy. Needs a
+ * Metal device; no window.
  *
  *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_present_post.m \
  *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
@@ -43,6 +45,36 @@ static void present(const px4* in, px4* out, int fxaa, float sharpen)
 
 static void grey(px4 p, unsigned v, unsigned a) { p[0] = p[1] = p[2] = (unsigned char)v; p[3] = (unsigned char)a; }
 
+/* The colour filters, as eng_post_options would have read them. */
+static void filters(float vib, float con, float vig, float grain)
+{
+    s_eng_post_read = 1;
+    s_eng_vibrance = vib; s_eng_contrast = con; s_eng_vignette = vig; s_eng_grain = grain;
+}
+
+/* A ReShade-layout LUT of n^3 (n*n x n), identity or inverted. */
+static void make_lut(int n, int invert)
+{
+    MTLTextureDescriptor* d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                  width:n * n height:n mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead;
+    id<MTLTexture> t = [s_dev newTextureWithDescriptor:d];
+    unsigned char* px = malloc((size_t)n * n * n * 4);
+    for (int g = 0; g < n; g++)
+        for (int b = 0; b < n; b++)
+            for (int r = 0; r < n; r++) {
+                unsigned char* q = px + ((size_t)g * n * n + b * n + r) * 4;
+                const int R = r * 255 / (n - 1), G = g * 255 / (n - 1), B = b * 255 / (n - 1);
+                q[0] = (unsigned char)(invert ? 255 - R : R); q[1] = (unsigned char)(invert ? 255 - G : G);
+                q[2] = (unsigned char)(invert ? 255 - B : B); q[3] = 255;
+            }
+    [t replaceRegion:MTLRegionMake2D(0, 0, n * n, n) mipmapLevel:0 withBytes:px bytesPerRow:n * n * 4];
+    free(px);
+    s_eng_lut = t;
+    s_eng_lut_size = (float)n;
+    s_eng_lut_strength = 1.0f;
+}
+
 int main(void)
 {
     @autoreleasepool {
@@ -85,6 +117,29 @@ int main(void)
         printf("FXAA: %d staircase pixels blended\n", blended);
         assert(blended >= 10);
 
+        /* SMAA (PS3_AA=smaa): the same staircase, edges blended, the flat
+         * areas exact. */
+        s_eng_smaa = 1;
+        present(in, out, 0, 0.0f);
+        assert(s_eng_smaa);                                   /* it set up */
+        blended = 0;
+        for (int y = 1; y < 15; y++)
+            for (int x = 1; x < W - 1; x++) {
+                const unsigned char* o = out[y * W + x];
+                int near = 0;
+                for (int dy = -3; dy <= 3; dy++)
+                    for (int dx = -3; dx <= 3; dx++) {
+                        const int xx = x + dx, yy = y + dy;
+                        if (xx < 0 || yy < 0 || xx >= W || yy >= 16) continue;
+                        near |= in[yy * W + xx][0] != in[y * W + x][0];
+                    }
+                if (!near) assert(o[0] == in[y * W + x][0]);
+                if (o[0] > 8 && o[0] < 247) blended++;
+            }
+        printf("SMAA: %d staircase pixels blended\n", blended);
+        assert(blended >= 10);
+        s_eng_smaa = 0;
+
         /* CAS: a soft edge (64, 80, 128, 176, 192 across the columns) gets
          * steeper: its dark shoulder darker, its bright shoulder brighter,
          * the middle and the flat areas unchanged. (CAS holds back where a
@@ -110,6 +165,70 @@ int main(void)
         present(in, out, 1, 1.0f);
         assert(!memcmp(out[row + 5], in[row + 5], 4) && !memcmp(out[row + 26], in[row + 26], 4));
 
+        /* ---- the colour filters ---- */
+        /* a dull colour (B 100, G 120, R 140) left half, mid grey right half */
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) {
+                unsigned char* q = in[y * W + x];
+                if (x < W / 2) { q[0] = 100; q[1] = 120; q[2] = 140; q[3] = 0xFF; }
+                else grey(q, 128, 0xFF);
+            }
+        filters(0.0f, 1.0f, 0.0f, 0.0f);
+        present(in, out, 0, 0.0f);
+        assert(!memcmp(in, out, sizeof in));                 /* all neutral: exact copy */
+
+        /* vibrance: the dull colour spreads away from its grey, grey stays */
+        filters(1.0f, 1.0f, 0.0f, 0.0f);
+        present(in, out, 0, 0.0f);
+        printf("vibrance 1: (140,120,100) -> (%u,%u,%u)\n", out[row + 4][2], out[row + 4][1], out[row + 4][0]);
+        assert(out[row + 4][2] > 140 + 10 && out[row + 4][0] < 100 - 10);
+        assert(abs((int)out[row + 24][0] - 128) <= 1 && abs((int)out[row + 24][2] - 128) <= 1);
+        filters(-1.0f, 1.0f, 0.0f, 0.0f);                   /* negative mutes it */
+        present(in, out, 0, 0.0f);
+        assert(out[row + 4][2] < 140 && out[row + 4][0] > 100);
+
+        /* contrast 1.5: away from mid grey; mid grey stays */
+        filters(0.0f, 1.5f, 0.0f, 0.0f);
+        present(in, out, 0, 0.0f);
+        assert(out[row + 4][2] > 140 && out[row + 4][0] < 100);
+        assert(abs((int)out[row + 24][0] - 128) <= 1);
+
+        /* vignette: the corners darker, the middle as it was */
+        for (int i = 0; i < W * H; i++) grey(in[i], 200, 0xFF);
+        filters(0.0f, 1.0f, 1.0f, 0.0f);
+        present(in, out, 0, 0.0f);
+        printf("vignette 1: corner %u, middle %u\n", out[0][0], out[(H / 2) * W + W / 2][0]);
+        assert(out[0][0] < 120 && out[(H / 2) * W + W / 2][0] == 200);
+
+        /* grain: a flat picture gets noise around its level */
+        filters(0.0f, 1.0f, 0.0f, 1.0f);
+        present(in, out, 0, 0.0f);
+        { int changed = 0; long sum = 0;
+          for (int i = 0; i < W * H; i++) { changed += out[i][0] != 200; sum += out[i][0]; }
+          printf("grain 1: %d of %d pixels moved, mean %.1f\n", changed, W * H, (double)sum / (W * H));
+          assert(changed > W * H / 2 && labs(sum / (W * H) - 200) <= 3); }
+
+        /* LUT: identity keeps the picture, an inverted one inverts it */
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) { unsigned char* q = in[y * W + x];
+                q[0] = (unsigned char)(x * 8); q[1] = (unsigned char)(y * 8); q[2] = 77; q[3] = 0xFF; }
+        filters(0.0f, 1.0f, 0.0f, 0.0f);
+        make_lut(16, 0);
+        present(in, out, 0, 0.0f);
+        { int worst = 0;
+          for (int i = 0; i < W * H; i++)
+              for (int c = 0; c < 3; c++) { const int d = abs((int)out[i][c] - (int)in[i][c]); if (d > worst) worst = d; }
+          printf("identity LUT 16^3: worst error %d\n", worst);
+          assert(worst <= 3); }
+        make_lut(16, 1);
+        present(in, out, 0, 0.0f);
+        assert(abs((int)out[row + 5][0] - (255 - in[row + 5][0])) <= 3);
+        assert(abs((int)out[row + 5][2] - (255 - 77)) <= 3);
+        s_eng_lut_strength = 0.5f;                           /* half strength: half way */
+        present(in, out, 0, 0.0f);
+        assert(abs((int)out[row + 5][2] - (77 + (255 - 77)) / 2) <= 3);
+        s_eng_lut = nil;
+
         puts("test_metal_present_post: ok");
     }
     return 0;
diff --git a/libs/video/tests/test_metal_rect_clears.m b/libs/video/tests/test_metal_rect_clears.m
new file mode 100644
index 00000000..afc25ac3
--- /dev/null
+++ b/libs/video/tests/test_metal_rect_clears.m
@@ -0,0 +1,139 @@
+/*
+ * The Metal backend's rectangle clears (rsx_draw_backend.clear_color_rect,
+ * clear_depth_stencil_rect): a clear limited to part of a target leaves the
+ * rest of it as it was. Resistance's co-op split screen clears player 2's
+ * half of the scene target after player 1's view is drawn into the other
+ * half; a clear folded into a pass's load action covers the whole attachment
+ * and took player 1's view with it.
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_rect_clears.m \
+ *     libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp -lc++ -Wl,-dead_strip \
+ *     -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_rect_clears
+ */
+#include "../rsx_metal_backend.m"
+
+static int g_fail;
+
+#define CHECK(cond, ...)                                                      \
+    do {                                                                      \
+        if (cond) { printf("[PASS] " __VA_ARGS__); printf("\n"); }            \
+        else { printf("[FAIL] " __VA_ARGS__); printf("\n"); g_fail++; }       \
+    } while (0)
+
+#define W 8u
+#define H 4u
+
+static id<MTLTexture> color_texture(void)
+{
+    MTLTextureDescriptor* d =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                           width:W height:H mipmapped:NO];
+    d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    d.storageMode = MTLStorageModeShared;
+    return [s_dev newTextureWithDescriptor:d];
+}
+
+static id<MTLTexture> depth_texture(void)
+{
+    MTLTextureDescriptor* d =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTL_DEPTH_FORMAT
+                                                           width:W height:H mipmapped:NO];
+    d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    d.storageMode = MTLStorageModePrivate;
+    return [s_dev newTextureWithDescriptor:d];
+}
+
+static int encode_and_wait(void)
+{
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    eng_encode_records(cb, nil);
+    s_eng_rec_count = 0;
+    [cb commit];
+    [cb waitUntilCompleted];
+    return cb.status == MTLCommandBufferStatusCompleted;
+}
+
+/* Columns [0, split) hold `left`, [split, W) hold `right` (R,G,B,A). */
+static int color_halves(id<MTLTexture> t, u32 split, const u8 left[4], const u8 right[4])
+{
+    u8 px[W * H * 4];
+    [t getBytes:px bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+    for (u32 y = 0; y < H; y++)
+        for (u32 x = 0; x < W; x++)
+            if (memcmp(px + (y * W + x) * 4, x < split ? left : right, 4)) return 0;
+    return 1;
+}
+
+/* Depth and stencil per column as above. */
+static int depth_halves(id<MTLTexture> t, u32 split, float zl, u8 sl, float zr, u8 sr)
+{
+    const NSUInteger drow = W * 4, srow = W, dsize = drow * H, ssize = srow * H;
+    id<MTLBuffer> db = [s_dev newBufferWithLength:dsize options:MTLResourceStorageModeShared];
+    id<MTLBuffer> sb = [s_dev newBufferWithLength:ssize options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+               sourceSize:MTLSizeMake(W, H, 1) toBuffer:db destinationOffset:0
+   destinationBytesPerRow:drow destinationBytesPerImage:dsize
+                  options:MTLBlitOptionDepthFromDepthStencil];
+    [blit copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+               sourceSize:MTLSizeMake(W, H, 1) toBuffer:sb destinationOffset:0
+   destinationBytesPerRow:srow destinationBytesPerImage:ssize
+                  options:MTLBlitOptionStencilFromDepthStencil];
+    [blit endEncoding];
+    [cb commit];
+    [cb waitUntilCompleted];
+    for (u32 y = 0; y < H; y++)
+        for (u32 x = 0; x < W; x++) {
+            float z;
+            memcpy(&z, (const u8*)db.contents + y * drow + x * 4, 4);
+            const u8 s = *((const u8*)sb.contents + y * srow + x);
+            if (fabsf(z - (x < split ? zl : zr)) > 1e-6f || s != (x < split ? sl : sr))
+                return 0;
+        }
+    return 1;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { puts("no Metal device: skipped"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        if (eng_init(NULL, W, H) != 0) { puts("[FAIL] eng_init"); return 1; }
+
+        id<MTLTexture> c = color_texture();
+        id<MTLTexture> z = depth_texture();
+        const u32 hc = eng_obj_add(c), hz = eng_obj_add(z);
+        const float red[4] = { 1, 0, 0, 1 }, green[4] = { 0, 1, 0, 1 };
+        const u8 r8[4] = { 255, 0, 0, 255 }, g8[4] = { 0, 255, 0, 255 };
+
+        /* Player 1's half, then player 2's clear of the other half. */
+        eng_clear_color(NULL, hc, red);
+        eng_clear_depth_stencil(NULL, hz, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL, 0.25f, 7);
+        eng_clear_color_rect(NULL, hc, green, W / 2, 0, W / 2, H);
+        eng_clear_depth_stencil_rect(NULL, hz, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL,
+                                     0.75f, 11, W / 2, 0, W / 2, H);
+        CHECK(encode_and_wait(), "the frame with rectangle clears executes");
+        CHECK(color_halves(c, W / 2, r8, g8),
+              "a colour clear of the right half keeps the left half");
+        CHECK(depth_halves(z, W / 2, 0.25f, 7, 0.75f, 11),
+              "a depth and stencil clear of the right half keeps the left half");
+
+        /* Depth alone leaves the stencil; a rectangle past the target's edge
+         * is clipped to it. */
+        eng_clear_depth_stencil_rect(NULL, hz, RSX_BE_CLEAR_DEPTH, 0.5f, 99, 0, 0, W / 2, H * 4);
+        CHECK(encode_and_wait(), "a depth-only rectangle clear executes");
+        CHECK(depth_halves(z, W / 2, 0.5f, 7, 0.75f, 11),
+              "a depth-only clear keeps the stencil and the other half");
+
+        /* A whole clear queued right after a rectangle one still covers the
+         * whole target, and the rectangle is not folded into it. */
+        eng_clear_color_rect(NULL, hc, red, 0, 0, 1, 1);
+        eng_clear_color(NULL, hc, green);
+        CHECK(encode_and_wait() && color_halves(c, W, g8, g8),
+              "a whole clear after a rectangle clear covers the target");
+    }
+    printf(g_fail ? "%d check(s) FAILED\n" : "all checks passed\n", g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_metal_res_scale.m b/libs/video/tests/test_metal_res_scale.m
new file mode 100644
index 00000000..d574cd9b
--- /dev/null
+++ b/libs/video/tests/test_metal_res_scale.m
@@ -0,0 +1,124 @@
+/* PS3_RES_SCALE in the Metal backend: the knob's spellings; targets made at
+ * the scaled size (a seeded colour target filled nearest-neighbour); views and
+ * copies that inherit it; viewports and scissors that follow; and readbacks,
+ * colour and depth, that hand the guest its own pixels back. Needs a Metal
+ * device; no window.
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_res_scale.m \
+ *     libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp -lc++ -Wl,-dead_strip \
+ *     -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_res_scale && /tmp/test_metal_res_scale
+ */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+#include <math.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"vertex V vs(uint i [[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],0,1)}; }\n"
+/* every 2x2 block one value: the guest pixel it stands for */
+"struct D { float d [[depth(any)]]; }; fragment D fs(V v [[stage_in]]) {"
+" return {0.125f + floor(v.p.x * 0.5f) * 0.125f + floor(v.p.y * 0.5f) * 0.0625f}; }\n";
+static float expected(u32 x, u32 y) { return .125f + x * .125f + y * .0625f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        /* the knob */
+        assert(res_scale_from(NULL) == 1.0f && res_scale_from("") == 1.0f);
+        assert(res_scale_from("2") == 2.0f && res_scale_from("1.5") == 1.5f && res_scale_from("2x") == 2.0f);
+        assert(res_scale_from("1080p") == 1.5f && res_scale_from("1440P") == 2.0f && res_scale_from("4k") == 3.0f);
+        assert(res_scale_from("720p") == 1.0f && res_scale_from("1.6") == 1.5f);   /* quarter steps */
+        assert(res_scale_from("5") == 1.0f && res_scale_from("0.5") == 1.0f && res_scale_from("big") == 1.0f);
+
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { puts("test_metal_res_scale: no Metal device, skipped"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        s_res_scale = 2.0f;
+        assert(res_px(4) == 8 && res_px(3) == 6 && res_px(0) == 0);
+        assert(eng_init(NULL, 4, 3) == 0);
+
+        /* a seeded colour target: 8x6, each guest pixel a 2x2 block */
+        u8 seed[4 * 3 * 4];
+        for (u32 i = 0; i < 12; i++) { seed[i * 4] = (u8)(i * 20); seed[i * 4 + 1] = (u8)(255 - i); seed[i * 4 + 2] = 7; seed[i * 4 + 3] = 255; }
+        const u32 color = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, seed, 16);
+        assert(color && eng_obj_is_scaled(color));
+        assert([eng_obj(color) width] == 8 && [eng_obj(color) height] == 6);
+        u8 big[8 * 6 * 4];
+        [eng_obj(color) getBytes:big bytesPerRow:32 fromRegion:MTLRegionMake2D(0, 0, 8, 6) mipmapLevel:0];
+        assert(!memcmp(big + (3 * 8 + 5) * 4, seed + (1 * 4 + 2) * 4, 4));   /* (5,3) -> guest (2,1) */
+        /* read back at the guest's size: the seed, exactly */
+        u8 back[4 * 3 * 4];
+        memset(back, 0xCD, sizeof back);
+        eng_readback(NULL, color, 0, 0, 4, 3, back, 16);
+        assert(!memcmp(back, seed, sizeof seed));
+        u8 roi[2 * 2 * 4 + 4];
+        memset(roi, 0xCD, sizeof roi);
+        eng_readback(NULL, color, 1, 1, 2, 2, roi, 12);                     /* padded rows */
+        assert(!memcmp(roi, seed + (1 * 4 + 1) * 4, 8) && !memcmp(roi + 12, seed + (2 * 4 + 1) * 4, 8));
+        assert(roi[8] == 0xCD);
+
+        /* a view and a copy of it are scaled too; a guest texture is not */
+        const u32 view = eng_surface_view(NULL, color, 0xAAE4, 0x85);
+        assert(view && eng_obj_is_scaled(view));
+        const u32 copy = eng_color_snapshot(NULL, color);
+        assert(copy && eng_obj_is_scaled(copy) && [eng_obj(copy) width] == 8);
+        const u32 tex = eng_texture_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, 1, 1, 0xAAE4, 0x85);
+        assert(tex && !eng_obj_is_scaled(tex) && [eng_obj(tex) width] == 4);
+
+        /* viewport and scissor follow the targets */
+        eng_set_viewport(NULL, 0.0f, 0.0f, 4.0f, 3.0f);
+        assert(s_eng_pending.vp[2] == 8.0f && s_eng_pending.vp[3] == 6.0f);
+        eng_set_scissor(NULL, 1, 1, 3, 2);
+        assert(s_eng_pending.sc[0] == 2 && s_eng_pending.sc[1] == 2 && s_eng_pending.sc[2] == 6 && s_eng_pending.sc[3] == 4);
+
+        /* depth: 8x6, its snapshot 8x6, its readback the guest's 4x3 */
+        const u32 depth = eng_depth_target_create(NULL, 4, 3);
+        assert(depth && eng_obj_is_scaled(depth) && [eng_obj(depth) width] == 8);
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:@(fixture) options:nil error:&err];
+        assert(lib);
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+        pd.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT; pd.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+        id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        assert(pso);
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.depthAttachment.texture = eng_obj(depth); rp.depthAttachment.loadAction = MTLLoadActionClear;
+        rp.depthAttachment.clearDepth = 1; rp.depthAttachment.storeAction = MTLStoreActionStore;
+        rp.stencilAttachment.texture = eng_obj(depth); rp.stencilAttachment.loadAction = MTLLoadActionClear;
+        rp.stencilAttachment.storeAction = MTLStoreActionStore;
+        id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+        MTLDepthStencilDescriptor* dsd = [MTLDepthStencilDescriptor new];
+        dsd.depthCompareFunction = MTLCompareFunctionAlways; dsd.depthWriteEnabled = YES;
+        [e setRenderPipelineState:pso]; [e setDepthStencilState:[s_dev newDepthStencilStateWithDescriptor:dsd]];
+        [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+        [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        assert(cb.status == MTLCommandBufferStatusCompleted);
+        const u32 snap = eng_depth_snapshot(NULL, depth, 4, 3);
+        assert(snap && eng_obj_is_scaled(snap) && [eng_obj(snap) width] == 8 && [eng_obj(snap) height] == 6);
+        float dz[4 * 3 + 2];
+        for (int i = 0; i < 14; i++) dz[i] = -7.0f;
+        assert(eng_depth_readback(NULL, depth, 0, 0, 4, 3, dz, 16) == 0);
+        for (u32 y = 0; y < 3; y++)
+            for (u32 x = 0; x < 4; x++) assert(fabsf(dz[y * 4 + x] - expected(x, y)) < 1e-6f);
+        float droi[3] = { -9, -9, -9 };
+        assert(eng_depth_readback(NULL, depth, 2, 1, 2, 1, droi, 12) == 0);
+        assert(fabsf(droi[0] - expected(2, 1)) < 1e-6f && fabsf(droi[1] - expected(3, 1)) < 1e-6f && droi[2] == -9);
+        const u32 rgba = eng_depth_snapshot_rgba8(NULL, depth, 4, 3);
+        assert(rgba && eng_obj_is_scaled(rgba) && [eng_obj(rgba) width] == 8);
+
+        /* at 1, nothing is scaled */
+        s_res_scale = 1.0f;
+        const u32 plain = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, seed, 16);
+        assert(plain && !eng_obj_is_scaled(plain) && [eng_obj(plain) width] == 4);
+        eng_set_viewport(NULL, 0.0f, 0.0f, 4.0f, 3.0f);
+        assert(s_eng_pending.vp[2] == 4.0f);
+        puts("test_metal_res_scale: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_shader_cache.m b/libs/video/tests/test_metal_shader_cache.m
new file mode 100644
index 00000000..ae780793
--- /dev/null
+++ b/libs/video/tests/test_metal_shader_cache.m
@@ -0,0 +1,77 @@
+/* PS3_SHADER_CACHE and PS3_SHADER_ASYNC on the engine's pipeline path.
+ *
+ * clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_shader_cache.m
+ *   libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp
+ *   libs/video/rsx_shader_spirv.cpp (and the glslang / spirv-cross libraries the
+ *   backend links) -framework Metal -framework Cocoa -framework QuartzCore
+ *
+ * Run as: test_metal_shader_cache <cache dir> <sync|async>. A first run into
+ * an empty directory writes one translation per stage; a second run reads
+ * them back; an async run builds the pipeline on the queue, its draw is
+ * skipped until the state is ready and then encodes. */
+#include "rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+u32 cellGcmResolveLocated(int local, u32 off) { (void)local; return off; }
+
+static const char* k_vs =
+    "struct VSIn { float4 a0 : ATTR0; };\n"
+    "struct VSOut { float4 pos : SV_Position; };\n"
+    "VSOut main(VSIn i) { VSOut o; o.pos = i.a0; return o; }\n";
+static const char* k_ps =
+    "float4 main() : SV_Target0 { return float4(1.0, 0.5, 0.25, 1.0); }\n";
+
+static u32 count_msl(const char* dir)
+{
+    u32 n = 0;
+    DIR* d = opendir(dir);
+    if (!d) return 0;
+    struct dirent* de;
+    while ((de = readdir(d))) if (strstr(de->d_name, ".msl")) n++;
+    closedir(d);
+    return n;
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        assert(argc == 3);
+        setenv("PS3_SHADER_CACHE", argv[1], 1);
+        const int async = !strcmp(argv[2], "async");
+        if (async) setenv("PS3_SHADER_ASYNC", "1", 1);
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { fprintf(stderr, "no Metal device\n"); return 2; }
+        s_queue = [s_dev newCommandQueue];
+        s_guest_shaders = rsx_hlsl_to_msl_available();
+        if (!s_guest_shaders) { fprintf(stderr, "no HLSL->MSL translator\n"); return 2; }
+
+        rsx_be_render_state rs; memset(&rs, 0, sizeof rs);
+        rs.color_mask = 0xFFFFFFFFu;
+        rsx_vertex_layout_plan layout; memset(&layout, 0, sizeof layout);
+        layout.count = 1; layout.stride = 16;
+        const u32 h = eng_pipeline_create(NULL, k_vs, k_ps, &rs, &layout, 16,
+                                          RSX_BE_FMT_R8G8B8A8, 1);
+        assert(h);
+        if (async) {
+            /* The handle exists at once; the state follows on the queue. */
+            dispatch_sync(s_sc_queue, ^{});
+        }
+        assert(__atomic_load_n(&s_eng_pipe[h - 1].building, __ATOMIC_ACQUIRE) == 0);
+        assert(s_eng_pipe[h - 1].pso != nil);
+
+        /* A pipeline still building is skipped, not an encoding failure. */
+        __atomic_store_n(&s_eng_pipe[h - 1].building, 1, __ATOMIC_RELEASE);
+        EngRecord r; memset(&r, 0, sizeof r); r.pipeline = h;
+        const u32 skipped = s_sc_async_skipped;
+        eng_encode_draw(nil, &r, nil);
+        assert(s_sc_async_skipped == skipped + 1 && !s_eng_encoding_failed);
+        __atomic_store_n(&s_eng_pipe[h - 1].building, 0, __ATOMIC_RELEASE);
+
+        printf("shader cache: %s %u hit(s) %u new, %u file(s) in %s\n", argv[2],
+               s_sc_hits, s_sc_miss, count_msl(s_sc_dir), s_sc_dir);
+        assert(s_sc_hits + s_sc_miss == 2);
+        assert(count_msl(s_sc_dir) == 2);
+        eng_shutdown(NULL);
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_stage_ring.m b/libs/video/tests/test_metal_stage_ring.m
new file mode 100644
index 00000000..016f9fa7
--- /dev/null
+++ b/libs/video/tests/test_metal_stage_ring.m
@@ -0,0 +1,71 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_stage_ring.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_stage_ring
+ *
+ * The Metal engine's staging arena is a ring of shared MTLBuffers written in
+ * place: staged bytes are in the slot's buffer itself (nothing copied at
+ * commit), each submission takes the next slot, growth keeps what was
+ * already staged, a slot still marked in flight is waited for, and shutdown
+ * lets every slot go. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+        s_queue = [s_dev newCommandQueue];
+        assert(s_queue);
+
+        u8 a[64], b[64];
+        for (u32 i = 0; i < 64; i++) { a[i] = (u8)i; b[i] = (u8)(0xFF - i); }
+
+        /* The first data of a submission takes a slot and lands in its buffer. */
+        u32 off = 0;
+        assert(s_eng_slot < 0);
+        assert(eng_stage_copy(a, sizeof a, &off));
+        const int k0 = s_eng_slot;
+        assert(k0 >= 0 && s_eng_slot_buf[k0]);
+        assert((u8*)[s_eng_slot_buf[k0] contents] == s_eng_stage);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k0] contents] + off, a, sizeof a));
+
+        /* A commit hands that buffer over; the next submission uses the next slot. */
+        eng_encode_and_commit(nil);
+        assert(s_eng_slot < 0 && s_eng_stage_used == 0 && !s_eng_encoding_failed);
+        id<MTLBuffer> first = s_eng_slot_buf[k0];
+        assert(eng_stage_copy(b, sizeof b, &off));
+        const int k1 = s_eng_slot;
+        assert(k1 == (k0 + 1) % ENG_STAGE_SLOTS && s_eng_slot_buf[k1] != first);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k1] contents] + off, b, sizeof b));
+        assert(!memcmp([first contents], a, sizeof a));   /* the committed slot is untouched */
+
+        /* Growing a slot keeps what this submission staged before. */
+        const u32 b_off = off;
+        const u32 big = (u32)[s_eng_slot_buf[k1] length] + 4096u;
+        u32 big_off = 0;
+        assert(eng_stage_reserve(big, &big_off));
+        assert([s_eng_slot_buf[k1] length] >= big_off + big);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k1] contents] + b_off, b, sizeof b));
+        eng_encode_and_commit(nil);
+
+        /* A slot still in flight is waited for, not overwritten. */
+        const int k2 = (int)(s_eng_slot_next % ENG_STAGE_SLOTS);
+        s_eng_slot_busy[k2] = 1;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_MSEC),
+                       dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+                           __atomic_store_n(&s_eng_slot_busy[k2], 0, __ATOMIC_RELEASE);
+                       });
+        const unsigned long waits = s_eng_slot_waits;
+        assert(eng_stage_copy(a, sizeof a, &off));
+        assert(s_eng_slot == k2 && s_eng_slot_waits == waits + 1 && !s_eng_slot_busy[k2]);
+        eng_encode_and_commit(nil);
+
+        eng_shutdown(NULL);
+        for (int k = 0; k < ENG_STAGE_SLOTS; k++) assert(!s_eng_slot_buf[k]);
+        assert(s_eng_slot < 0 && !s_eng_stage && !s_eng_stage_cap);
+        puts("Metal staging ring: staged in place, one slot per submission, in-flight slots waited for");
+    }
+}
diff --git a/libs/video/tests/test_metal_vbuf.m b/libs/video/tests/test_metal_vbuf.m
new file mode 100644
index 00000000..2650df6a
--- /dev/null
+++ b/libs/video/tests/test_metal_vbuf.m
@@ -0,0 +1,64 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_vbuf.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_vbuf
+ *
+ * The Metal backend's persistent vertex buffers (the draw engine's vertex
+ * cache): a buffer holds the bytes it was made from, a draw records its
+ * handle, and a released handle keeps naming the same MTLBuffer until no
+ * recorded draw is left, so a draw recorded before the release never encodes
+ * another buffer's vertices. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table checked below. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+        u8 a[64], b[64];
+        for (u32 i = 0; i < 64; i++) { a[i] = (u8)i; b[i] = (u8)(0xFF - i); }
+
+        u32 ha = eng_vbuf_create(NULL, a, sizeof a);
+        assert(ha);
+        id<MTLBuffer> ba = s_vbuf[ha - 1];
+        assert(ba && [ba length] == sizeof a && !memcmp([ba contents], a, sizeof a));
+        assert(!eng_vbuf_create(NULL, NULL, 16) && !eng_vbuf_create(NULL, a, 0));
+
+        /* A draw from it records the handle, with its indices staged. */
+        const u32 idx[3] = { 2, 1, 0 };
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_TRIANGLES, ha, 4, 16, idx, 3);
+        assert(s_eng_rec_count == 1);
+        const EngRecord* r = &s_eng_rec[0];
+        assert(r->kind == ENG_REC_DRAW && r->vb_buf == ha && r->vertex_count == 4 &&
+               r->stride == 16 && r->index_count == 3);
+        assert(!memcmp(s_eng_stage + r->ib_off, idx, sizeof idx));
+        /* An ordinary draw still stages its vertices and names no buffer. */
+        eng_draw(NULL, RSX_TOPOLOGY_TRIANGLES, a, 4, 16, NULL, 0);
+        assert(s_eng_rec_count == 2 && s_eng_rec[1].vb_buf == 0);
+
+        /* Released while recorded: the slot is not recycled yet. */
+        eng_vbuf_release(NULL, ha);
+        eng_vbuf_release(NULL, ha);            /* a second release is harmless */
+        assert(s_vbuf[ha - 1] == ba);
+        u32 hb = eng_vbuf_create(NULL, b, sizeof b);
+        assert(hb && hb != ha && !memcmp([s_vbuf[hb - 1] contents], b, sizeof b));
+        /* A draw naming a retired handle is not recorded. */
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_TRIANGLES, ha, 4, 16, NULL, 0);
+        assert(s_eng_rec_count == 2);
+
+        /* Once everything recorded has been encoded, the slot is free. */
+        s_eng_rec_count = 0;
+        s_eng_stage_used = 0;
+        eng_collect_retired_objects();
+        assert(!s_vbuf[ha - 1] && s_vbuf[hb - 1]);
+        u32 hc = eng_vbuf_create(NULL, a, 32);
+        assert(hc == ha && [s_vbuf[hc - 1] length] == 32);
+
+        eng_shutdown(NULL);
+        assert(!s_vbuf_count && !s_vbuf_free_count && !s_vbuf[ha - 1] && !s_vbuf[hb - 1]);
+        assert(s_engine_backend.vbuf_create && s_engine_backend.vbuf_release &&
+               s_engine_backend.draw_vbuf);
+        puts("Metal persistent vertex buffers keep their bytes until no draw names them");
+    }
+}
diff --git a/libs/video/tests/test_metal_vstreams.m b/libs/video/tests/test_metal_vstreams.m
new file mode 100644
index 00000000..5dc31323
--- /dev/null
+++ b/libs/video/tests/test_metal_vstreams.m
@@ -0,0 +1,145 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_vstreams.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_vstreams
+ *
+ * The Metal backend's split vertex streams (rsx_draw_backend.draw_vbufs, the
+ * draw engine's per-stream vertex cache):
+ *   - the vertex descriptor for a stream map puts each stream in its own
+ *     buffer, its slots packed in ascending order, and refuses a map that
+ *     names a stream out of range or leaves one empty;
+ *   - a split draw records each stream as a persistent buffer or as staged
+ *     bytes, and a draw naming a retired buffer is not recorded;
+ *   - on the GPU, a pipeline made from that descriptor and a record encoded
+ *     by eng_encode_draw read every attribute from the right stream. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table checked below. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static const char* kMSL =
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"struct VIn { float4 a0 [[attribute(0)]]; float4 a1 [[attribute(1)]]; float4 a2 [[attribute(2)]]; };\n"
+"struct VOut { float4 pos [[position]]; float4 c; float ps [[point_size]]; };\n"
+"vertex VOut vmain(VIn in [[stage_in]], uint vid [[vertex_id]]) {\n"
+"    VOut o; o.pos = float4(-1.0 + (2.0 * vid + 1.0) / 4.0, 0.0, 0.0, 1.0);\n"
+"    o.c = float4(in.a0.x, in.a1.y, in.a2.z, in.a0.w + in.a1.w + in.a2.w); o.ps = 1.0; return o; }\n"
+"fragment float4 fmain(VOut in [[stage_in]]) { return in.c; }\n";
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+
+        /* Three slots; slot 1 in stream 1, slots 0 and 2 in stream 0. */
+        rsx_vertex_layout_plan layout;
+        memset(&layout, 0, sizeof layout);
+        layout.mask = 0x7u; layout.count = 3; layout.stride = 48;
+        for (u8 a = 0; a < 3; a++) layout.attrs[a] = a;
+        MTLVertexDescriptor* one = eng_vertex_descriptor(&layout, layout.stride);
+        assert(one && one.attributes[2].offset == 32 && one.attributes[2].bufferIndex == MTL_VB_INDEX &&
+               one.layouts[MTL_VB_INDEX].stride == 48);
+        layout.stream_map = 1ull << 4;
+        layout.n_streams = 2;
+        MTLVertexDescriptor* vd = eng_vertex_descriptor(&layout, layout.stride);
+        assert(vd);
+        assert(vd.attributes[0].bufferIndex == MTL_VB_INDEX && vd.attributes[0].offset == 0);
+        assert(vd.attributes[1].bufferIndex == MTL_VB_INDEX - 1 && vd.attributes[1].offset == 0);
+        assert(vd.attributes[2].bufferIndex == MTL_VB_INDEX && vd.attributes[2].offset == 16);
+        assert(vd.layouts[MTL_VB_INDEX].stride == 32 && vd.layouts[MTL_VB_INDEX - 1].stride == 16);
+        rsx_vertex_layout_plan bad = layout;
+        bad.stream_map = 2ull << 4;                  /* stream 2 of 2 */
+        assert(!eng_vertex_descriptor(&bad, bad.stride));
+        bad.stream_map = 0x111ull;                   /* stream 0 empty */
+        assert(!eng_vertex_descriptor(&bad, bad.stride));
+
+        /* Stream 0 resident, stream 1 staged. Vertex v: a0 = (v, 0, 0, 1),
+         * a2 = (0, 0, 10 + v, 2), a1 = (0, 100 + v, 0, 4). */
+        enum { N = 4 };
+        float s0[N][8], s1[N][4];
+        memset(s0, 0, sizeof s0); memset(s1, 0, sizeof s1);
+        for (int v = 0; v < N; v++) {
+            s0[v][0] = (float)v; s0[v][3] = 1.0f;
+            s0[v][6] = 10.0f + v; s0[v][7] = 2.0f;
+            s1[v][1] = 100.0f + v; s1[v][3] = 4.0f;
+        }
+        const u32 h0 = eng_vbuf_create(NULL, s0, sizeof s0);
+        assert(h0);
+        s_eng_pending.vp[2] = 4.0f; s_eng_pending.vp[3] = 1.0f;
+        s_eng_pending.pipeline = 1;
+        for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) s_eng_pending.samp[u] = -1;
+        for (u32 u = 0; u < RSX_BE_MAX_VERTEX_TEXTURES; u++) s_eng_pending.vsamp[u] = -1;
+        const rsx_be_vstream st[2] = { { h0, NULL, 32 }, { 0, s1, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, st, 2, N, NULL, 0);
+        assert(s_eng_rec_count == 1);
+        const EngRecord* r = &s_eng_rec[0];
+        assert(r->kind == ENG_REC_DRAW && r->n_vb == 2 && r->vb_buf == h0 && r->vb2_buf[0] == 0 &&
+               r->vertex_count == N && r->stride == 32 && r->index_count == 0);
+        assert(!memcmp(s_eng_stage + r->vb2_off[0], s1, sizeof s1));
+        /* Bad streams are not recorded: a zero stride, missing data, a dead buffer. */
+        const rsx_be_vstream z[2] = { { h0, NULL, 32 }, { 0, s1, 0 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, z, 2, N, NULL, 0);
+        const rsx_be_vstream nd[2] = { { h0, NULL, 32 }, { 0, NULL, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, nd, 2, N, NULL, 0);
+        const rsx_be_vstream dead[2] = { { 999, NULL, 32 }, { 0, s1, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, dead, 2, N, NULL, 0);
+        assert(s_eng_rec_count == 1);
+
+        /* On the GPU. */
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:@(kMSL) options:nil error:&err];
+        assert(lib);
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vmain"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fmain"];
+        pd.vertexDescriptor = vd;
+        pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA32Float;
+        pd.inputPrimitiveTopology = MTLPrimitiveTopologyClassPoint;
+        id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        if (!pso) { fprintf(stderr, "%s\n", [[err localizedDescription] UTF8String]); return 1; }
+        s_eng_pipe[0].pso = pso;
+        s_eng_pipe[0].ds = [s_dev newDepthStencilStateWithDescriptor:[MTLDepthStencilDescriptor new]];
+        s_eng_pipe[0].cull = MTLCullModeNone;
+        s_eng_pipe[0].winding = MTLWindingCounterClockwise;
+        s_eng_pipe_count = 1;
+
+        MTLTextureDescriptor* td = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:N height:1 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModeShared;
+        id<MTLTexture> rt = [s_dev newTextureWithDescriptor:td];
+        id<MTLBuffer> stage = [s_dev newBufferWithBytes:s_eng_stage length:s_eng_stage_used
+                                                options:MTLResourceStorageModeShared];
+        id<MTLCommandQueue> q = [s_dev newCommandQueue];
+        id<MTLCommandBuffer> cb = [q commandBuffer];
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture = rt;
+        rp.colorAttachments[0].loadAction = MTLLoadActionClear;
+        rp.colorAttachments[0].clearColor = MTLClearColorMake(-1, -1, -1, -1);
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:rp];
+        s_eng_encoding_failed = 0;
+        eng_encode_draw(enc, r, stage);
+        [enc endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(!s_eng_encoding_failed && cb.status == MTLCommandBufferStatusCompleted);
+        float px[N][4];
+        [rt getBytes:px bytesPerRow:sizeof px fromRegion:MTLRegionMake2D(0, 0, N, 1) mipmapLevel:0];
+        for (int v = 0; v < N; v++) {
+            if (px[v][0] != (float)v || px[v][1] != 100.0f + v || px[v][2] != 10.0f + v ||
+                px[v][3] != 7.0f) {
+                fprintf(stderr, "vertex %d: (%g %g %g %g)\n", v, (double)px[v][0], (double)px[v][1],
+                        (double)px[v][2], (double)px[v][3]);
+                return 1;
+            }
+        }
+
+        s_eng_rec_count = 0;
+        s_eng_stage_used = 0;
+        eng_shutdown(NULL);
+        assert(s_engine_backend.draw_vbufs == eng_draw_vbufs);
+        puts("Metal split vertex streams: each attribute read from its own stream");
+    }
+}
