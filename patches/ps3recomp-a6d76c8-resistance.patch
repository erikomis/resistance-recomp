+#define PARAM  0x3100u
+#define TICKET 0x4000u
+#define CB     0x5000u
+#define CBARG  0x6000u
+
+static u32 be32(const u8* p) { return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+
+int main(void)
+{
+    vm_base = calloc(1, 0x10000); assert(vm_base);
+    memcpy(vm_base + SVC, "UP9000-BCUS98107_00", 20);
+    assert(sceNpInit(0, NULL) == CELL_OK);
+
+    /* PS3_NP_SIGNIN alone is not enough: still offline. */
+    setenv("PS3_NP_SIGNIN", "1", 1);
+    unsetenv("PS3_NET_ONLINE");
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == (s32)SCE_NP_ERROR_OFFLINE);
+    assert(sceNpManagerGetStatus((s32*)(uintptr_t)SIZE) == CELL_OK);
+    assert((s32)vm_read32(SIZE) == SCE_NP_MANAGER_STATUS_OFFLINE);
+
+    setenv("PS3_NET_ONLINE", "1", 1);
+    assert(sceNpManagerGetStatus((s32*)(uintptr_t)SIZE) == CELL_OK);
+    assert((s32)vm_read32(SIZE) == SCE_NP_MANAGER_STATUS_ONLINE);
+
+    /* Registering tells the title it is signed in. */
+    assert(sceNpManagerRegisterCallback((SceNpManagerCallback)(uintptr_t)CB, (void*)(uintptr_t)CBARG) == CELL_OK);
+    assert(s_queued == 1 && s_opd == CB && (s32)s_args[0] == SCE_NP_MANAGER_STATUS_ONLINE);
+
+    /* No ticket yet. */
+    assert(sceNpManagerGetTicketParam(5, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_STATE);
+    vm_write32(SIZE, 0);
+    assert(sceNpManagerGetTicket(NULL, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == 0);
+
+    /* The request: GOT_TICKET with the size, then the ticket itself. */
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == CELL_OK);
+    assert(s_queued == 2 && s_opd == CB);
+    assert(s_args[0] == 255 && s_args[2] == CBARG);
+    const u32 n = (u32)s_args[1];
+    assert(n > 140 && n <= NP_TICKET_MAX);
+
+    vm_write32(SIZE, 0);
+    assert(sceNpManagerGetTicket(NULL, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == n);
+    vm_write32(SIZE, n - 1);
+    assert(sceNpManagerGetTicket((void*)(uintptr_t)TICKET, (u32*)(uintptr_t)SIZE) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+    vm_write32(SIZE, 1024);
+    assert(sceNpManagerGetTicket((void*)(uintptr_t)TICKET, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == n);
+
+    const u8* t = vm_base + TICKET;
+    assert(be32(t) == 0x21010000u && be32(t + 4) == n - 8);       /* version 2.1, size of the rest */
+    assert(t[8] == 0x30 && t[9] == 0x00);                          /* the body section */
+    assert(be32(t + 80) == 0x00040020u);                           /* online ID: string, 32 bytes */
+    assert(!strcmp((const char*)t + 84, "Resident_01"));
+    assert(be32(t + 132) == 0x00080018u);                          /* service ID: binary, 24 bytes */
+    assert(!strcmp((const char*)t + 136, "UP9000-BCUS98107_00"));
+    const u32 body = ((u32)t[10] << 8) | t[11];
+    assert(t[12 + body] == 0x30 && t[13 + body] == 0x02);          /* then the footer */
+    assert(12 + body + 4 + (((u32)t[14 + body] << 8) | t[15 + body]) == n);
+
+    /* The fields a title can ask for. */
+    assert(sceNpManagerGetTicketParam(5, (void*)(uintptr_t)PARAM) == CELL_OK);
+    assert(!strcmp((const char*)vm_base + PARAM, "Resident_01"));
+    assert(sceNpManagerGetTicketParam(8, (void*)(uintptr_t)PARAM) == CELL_OK);
+    assert(!strcmp((const char*)vm_base + PARAM, "UP9000-BCUS98107_00"));
+    assert(sceNpManagerGetTicketParam(1, (void*)(uintptr_t)PARAM) == CELL_OK && vm_read32(PARAM) == 0x100);
+    assert(sceNpManagerGetTicketParam(12, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+
+    printf("test_np_ticket_local: all passed (%u-byte ticket)\n", n);
+    return 0;
+}
