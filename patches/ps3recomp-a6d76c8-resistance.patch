+        u32 p = (u32)(key ^ (key >> 32)) & (s_mods.idx_size - 1u);
+        while (s_mods.idx[p]) p = (p + 1) & (s_mods.idx_size - 1u);
+        s_mods.idx[p] = s_mods.n;
+    }
