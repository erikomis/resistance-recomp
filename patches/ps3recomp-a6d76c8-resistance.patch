@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Check the licence-area system parameter: North America by default, $PS3_LICENSE_AREA overrides."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+if sys.platform == "win32":
+    print("SKIP: licence area fixture requires a POSIX C toolchain")
+    raise SystemExit(0)
+
+root = Path(__file__).resolve().parents[1]
+env = {key: value for key, value in os.environ.items()
+       if key != "PS3_LICENSE_AREA"}
+gc_flag = "-Wl,-dead_strip" if sys.platform == "darwin" else "-Wl,--gc-sections"
+with tempfile.TemporaryDirectory(prefix="license-area-") as temporary:
+    binary = Path(temporary) / "test_license_area"
+    subprocess.run([
+        os.environ.get("CC", "cc"), "-std=gnu17", "-O1", "-UNDEBUG",
+        "-ffunction-sections", "-fdata-sections", "-I" + str(root / "include"),
+        str(root / "libs/system/tests/test_license_area.c"),
+        str(root / "libs/system/cellSysutil.c"),
+        "-pthread", gc_flag, "-o", str(binary),
+        *(["-framework", "CoreFoundation"] if sys.platform == "darwin" else []),   # cellSysutil.c reads the host language
+    ], check=True, timeout=60, env=env, cwd=temporary)
+    subprocess.run([str(binary)], check=True, timeout=10, env=env, cwd=temporary)
diff --git a/tools/test_ppu_fs_rw_switch.py b/tools/test_ppu_fs_rw_switch.py
new file mode 100644
index 00000000..c24ed9f9
--- /dev/null
+++ b/tools/test_ppu_fs_rw_switch.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""cellFs read after write, and write after read, on one fd (runtime/ppu/ppu_fs.cpp).
+
+ppu_fs.cpp keeps files as stdio streams, and C leaves a read straight after a
+write (or a write straight after a read) undefined unless the stream is
+flushed or repositioned in between; cellFs has no such rule. FIOS writes a
+header into its new HDD cache index and reads on: on the MSVC CRT the read
+returned stale buffer bytes and the header never reached the file, so the
+cache never validated. This builds runtime/ppu/tests/test_fs_rw_switch.cpp
+(which includes ppu_fs.cpp) against a ppu_recomp.h made from the lifter's own
+HEADER_PREAMBLE and runs it.
+
+The undefined case shows on the MSVC CRT (clang++ or clang-cl on Windows);
+other C libraries may pass on both sides.
+
+It needs a host C++ compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_ppu_fs_rw_switch.py [--exe-out PATH] [--build-only]
+"""
+
+import argparse
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+FIXTURE = os.path.join(ROOT, "runtime", "ppu", "tests", "test_fs_rw_switch.cpp")
+INCLUDE_DIRS = ["include", "runtime/ppu", "runtime/memory", "runtime", "libs", "."]
+
+
+def _cxx():
+    return (shutil.which(os.environ.get("CXX", "c++")) or shutil.which("g++")
+            or shutil.which("clang++"))
+
+
+def _stub_header():
+    spec = importlib.util.spec_from_file_location(
+        "ppu_lifter", os.path.join(TOOLS, "ppu_lifter.py"))
+    lifter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(lifter)
+    return lifter.HEADER_PREAMBLE
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--exe-out", help="keep the built test program at this path")
+    ap.add_argument("--build-only", action="store_true",
+                    help="build (for another machine, e.g. a Windows target) and stop")
+    args = ap.parse_args()
+
+    cxx = _cxx()
+    if cxx is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C++ compiler found")
+            return 1
+        print("skip test_ppu_fs_rw_switch: no C++ compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        with open(os.path.join(td, "ppu_recomp.h"), "w") as fh:
+            fh.write(_stub_header())
+        exe = args.exe_out or os.path.join(td, "test_fs_rw_switch")
+        cmd = [cxx, "-std=gnu++17", "-w", "-I" + td]
+        cmd += ["-I" + os.path.join(ROOT, d) for d in INCLUDE_DIRS]
+        cmd += ["-o", exe, FIXTURE]
+        if "mingw" in os.path.basename(cxx):
+            cmd += ["-static"]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        if args.build_only:
+            print(f"built {exe}")
+            return 0
+        r = subprocess.run([exe, td], capture_output=True, text=True)
+        sys.stdout.write(r.stdout)
+        sys.stderr.write(r.stderr)
+        return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/test_ppu_lifter_insn_patches.py b/tools/test_ppu_lifter_insn_patches.py
new file mode 100644
index 00000000..f466a820
--- /dev/null
+++ b/tools/test_ppu_lifter_insn_patches.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""--insn-patches: a patched instruction is lifted in both forms behind its guard.
+
+1. Each patch becomes `if (guard) { <new> } else { <original> }`, the guard is
+   declared before the function, and the original's branch label survives.
+2. A patch whose `orig` is not the word in the input stops the lift (serial
+   and parallel: a worker must not hang the pool).
+3. A patch at an address no lifted function covers stops the lift.
+
+Run: python tools/test_ppu_lifter_insn_patches.py
+"""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+CODE = bytes.fromhex(
+    "2f830002"   # 0x10000 cmpwi cr7, r3, 2
+    "419d0008"   # 0x10004 bgt   cr7, 0x1000C
+    "38600002"   # 0x10008 li    r3, 2
+    "4e800020")  # 0x1000C blr
+
+
+def lift(root, patches, jobs="1"):
+    (root / "patches.json").write_text(json.dumps({"patches": patches}))
+    out = root / ("out" + jobs)
+    cmd = [sys.executable, str(Path(__file__).with_name("ppu_lifter.py")),
+           str(root / "code.bin"), "--raw", "--base", "0x10000",
+           "--functions", str(root / "functions.json"), "--jobs", jobs,
+           "--insn-patches", str(root / "patches.json"), "--output", str(out)]
+    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                       text=True, timeout=120)
+    text = "".join(p.read_text() for p in sorted(out.glob("ppu_recomp_*.cpp"))) \
+        if r.returncode == 0 else ""
+    return r, text
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        root = Path(tmp)
+        (root / "code.bin").write_bytes(CODE)
+        (root / "functions.json").write_text(
+            json.dumps([{"start": "0x10000", "end": "0x10010"}]))
+        good = [
+            {"addr": "0x10004", "orig": "0x419D0008", "new": "0x60000000", "guard": "g_a"},
+            {"addr": "0x10008", "orig": "0x38600002", "new": "0x38600001", "guard": "g_b"},
+        ]
+        r, text = lift(root, good)
+        assert r.returncode == 0, r.stderr
+        assert 'extern "C" int g_a;' in text and 'extern "C" int g_b;' in text, text
+        assert "if (g_a) { /* nop */; } else { if (" in text, text
+        assert "goto loc_0001000C; }  /* insn patch 0x00010004: 419D0008 -> 60000000 */" in text, text
+        assert ("if (g_b) { ctx->gpr[3] = (int64_t)(int32_t)(1); } else "
+                "{ ctx->gpr[3] = (int64_t)(int32_t)(2); }") in text, text
+        assert "loc_0001000C:" in text, text
+
+        bad = [dict(good[0], orig="0x419D0010")]
+        for jobs in ("1", "2"):
+            r, _ = lift(root, bad, jobs)
+            assert r.returncode != 0 and "the patch expects 0x419D0010" in r.stderr, \
+                (jobs, r.stderr[-400:])
+
+        r, _ = lift(root, [dict(good[0], addr="0x20000")])
+        assert r.returncode != 0 and "0x00020000" in r.stderr, r.stderr[-400:]
+    print("PASS: insn patches lift both forms behind their guard and refuse a mismatch")
+
+
+if __name__ == "__main__":
+    main()
