+    "    return out;\n"
+    "}\n"
+    "\n";
diff --git a/third_party/smaa/smaa_passes.hlsl b/third_party/smaa/smaa_passes.hlsl
new file mode 100644
index 00000000..f9b86ded
--- /dev/null
+++ b/third_party/smaa/smaa_passes.hlsl
@@ -0,0 +1,54 @@
+cbuffer SmaaParams : register(b0) { float4 rtMetrics; };
+#define SMAA_RT_METRICS rtMetrics
+#define SMAA_HLSL_4 1
+#define SMAA_PRESET_HIGH 1
+#include "SMAA.hlsl"
+
+Texture2D colorTex  : register(t0);
+Texture2D edgesTex  : register(t1);
+Texture2D areaTex   : register(t2);
+Texture2D searchTex : register(t3);
+Texture2D blendTex  : register(t4);
+
+struct V1 { float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 o0 : TEXCOORD1; float4 o1 : TEXCOORD2; float4 o2 : TEXCOORD3; };
+struct V2 { float4 pos : SV_Position; float2 uv : TEXCOORD0; float2 pix : TEXCOORD1; float4 o0 : TEXCOORD2; float4 o1 : TEXCOORD3; float4 o2 : TEXCOORD4; };
+struct V3 { float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 o0 : TEXCOORD1; };
+
+void fs_tri(uint id, out float4 pos, out float2 uv)
+{
+    float2 p = float2((id << 1) & 2, id & 2);
+    pos = float4(p * 2.0 - 1.0, 0.0, 1.0);
+    uv = float2(p.x, 1.0 - p.y);
+}
+
+V1 smaa_edge_vs(uint id : SV_VertexID)
+{
+    V1 o; fs_tri(id, o.pos, o.uv);
+    float4 off[3]; SMAAEdgeDetectionVS(o.uv, off);
+    o.o0 = off[0]; o.o1 = off[1]; o.o2 = off[2]; return o;
+}
+float4 smaa_edge_ps(V1 i) : SV_Target
+{
+    float4 off[3] = { i.o0, i.o1, i.o2 };
+    return float4(SMAALumaEdgeDetectionPS(i.uv, off, colorTex), 0.0, 0.0);
+}
+V2 smaa_weight_vs(uint id : SV_VertexID)
+{
+    V2 o; fs_tri(id, o.pos, o.uv);
+    float4 off[3]; SMAABlendingWeightCalculationVS(o.uv, o.pix, off);
+    o.o0 = off[0]; o.o1 = off[1]; o.o2 = off[2]; return o;
+}
+float4 smaa_weight_ps(V2 i) : SV_Target
+{
+    float4 off[3] = { i.o0, i.o1, i.o2 };
+    return SMAABlendingWeightCalculationPS(i.uv, i.pix, off, edgesTex, areaTex, searchTex, float4(0, 0, 0, 0));
+}
+V3 smaa_blend_vs(uint id : SV_VertexID)
+{
+    V3 o; fs_tri(id, o.pos, o.uv);
+    float4 off; SMAANeighborhoodBlendingVS(o.uv, off); o.o0 = off; return o;
+}
+float4 smaa_blend_ps(V3 i) : SV_Target
+{
+    return SMAANeighborhoodBlendingPS(i.uv, i.o0, colorTex, blendTex);
+}
diff --git a/tools/host_window/host_display.h b/tools/host_window/host_display.h
new file mode 100644
index 00000000..9bb6ed8d
--- /dev/null
+++ b/tools/host_window/host_display.h
@@ -0,0 +1,156 @@
+/*
+ * ps3recomp - the window host's display options (host_window.m)
+ *
+ *   PS3_WINDOW_MODE=windowed|fullscreen|borderless   how the window opens
+ *                    (windowed). fullscreen is macOS's own (a Space of its
+ *                    own); borderless covers the screen in place, menu bar
+ *                    and Dock hidden, and switching apps is instant.
+ *   PS3_WINDOW_SIZE=<w>x<h>   the window's content size when --size is not
+ *                    given (1280x720); shrunk, keeping its shape, to fit
+ *                    the screen
+ *   PS3_DISPLAY=<n>|<name>    the screen it opens on (1 = the one with the
+ *                    menu bar; a name as System Settings shows it, matched
+ *                    exactly, then ignoring case, then as a part)
+ *   PS3_VSYNC=0      present as soon as a frame is ready instead of at the
+ *                    screen's refresh (lower latency, may tear). The game's
+ *                    own pacing does not depend on it.
+ *   PS3_UPSCALE=metalfx   the window's drawable follows its pixel size
+ *                    (fitted to the game's aspect) and each frame goes
+ *                    through a MetalFX spatial scaler to it; off when
+ *                    MetalFX is missing or fails (one log line)
+ *   PS3_DOWNSCALE=0  a game picture larger than the window (an internal
+ *                    resolution above the screen's) goes to the window as
+ *                    it is and the layer shrinks it, sampling, so most of
+ *                    the extra pixels are lost and edges still shimmer. By
+ *                    default the drawable takes the window's pixel size and
+ *                    each frame is reduced into it with a Lanczos filter
+ *                    (MetalPerformanceShaders), every source pixel counted:
+ *                    supersampling. Off when MPS is missing (one log line)
+ *   PS3_DOWNSCALE_LINEAR=1  EXPERIMENTAL, off: the reduction averages light
+ *                    (an sRGB view of the picture, an sRGB target) instead of
+ *                    gamma-encoded values; thin bright lines keep more of
+ *                    their brightness. Measured on the game's frames: no
+ *                    better overall and 4x the overshoot, so it stays off
+ *   PS3_CAS_AFTER=0  the game's sharpening (PS3_SHARPEN) stays before the
+ *                    reduction. By default a frame the window reduces is
+ *                    sharpened here, after it (rsx_host_surface.h,
+ *                    slot_sharpen): before it, the reduction averaged most
+ *                    of the sharpening away (at 3x only +24% of the edge
+ *                    contrast it adds at 1x was left)
+ *
+ * The picture always keeps its aspect ratio (black bars). Plain C, so the
+ * parsing and the fitting are tested on their own (test_host_display.c).
+ */
+#ifndef PS3RECOMP_HOST_DISPLAY_H
+#define PS3RECOMP_HOST_DISPLAY_H
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+enum { HD_WINDOWED, HD_FULLSCREEN, HD_BORDERLESS };
+
+static inline int hd_window_mode_from(const char* e)
+{
+    if (!e || !*e || !strcasecmp(e, "windowed") || !strcasecmp(e, "window")) return HD_WINDOWED;
+    if (!strcasecmp(e, "fullscreen") || !strcasecmp(e, "native")) return HD_FULLSCREEN;
+    if (!strcasecmp(e, "borderless")) return HD_BORDERLESS;
+    fprintf(stderr, "[host window] PS3_WINDOW_MODE=%s: expected windowed, fullscreen or borderless\n", e);
+    return HD_WINDOWED;
+}
+
+/* 1 = wait for the screen's refresh (the default). */
+static inline int hd_vsync_from(const char* e)
+{
+    return !(e && e[0] == '0' && e[1] == 0);
+}
+
+static inline int hd_upscale_from(const char* e)
+{
+    if (!e || !*e || !strcasecmp(e, "off") || !strcmp(e, "0")) return 0;
+    if (!strcasecmp(e, "metalfx")) return 1;
+    fprintf(stderr, "[host window] PS3_UPSCALE=%s unknown (metalfx); off\n", e);
+    return 0;
+}
+
+/* 1 = reduce a picture larger than the window (PS3_DOWNSCALE, default on). */
+static inline int hd_downscale_from(const char* e)
+{
+    if (!e || !*e) return 1;
+    if (!strcasecmp(e, "off") || !strcmp(e, "0")) return 0;
+    if (!strcasecmp(e, "lanczos") || !strcmp(e, "1")) return 1;
+    fprintf(stderr, "[host window] PS3_DOWNSCALE=%s unknown (0, lanczos); on\n", e);
+    return 1;
+}
+
+/* "<w>x<h>" with both sides in range: 1, else 0 and *w, *h untouched. */
+static inline int hd_size_from(const char* e, unsigned* w, unsigned* h)
+{
+    unsigned a = 0, b = 0;
+    char tail = 0;
+    if (!e || sscanf(e, "%ux%u%c", &a, &b, &tail) != 2) return 0;
+    if (a < 160 || b < 90 || a > 8192 || b > 8192) return 0;
+    *w = a; *h = b;
+    return 1;
+}
+
+/* The drawable for an upscaled present: the view's pixel size (pw x ph)
+ * fitted to the source's aspect, or the source's own size whenever that
+ * would not be larger in both directions. */
+static inline void hd_fit(double pw, double ph, unsigned sw, unsigned sh, unsigned* ow, unsigned* oh)
+{
+    *ow = sw; *oh = sh;
+    if (!(pw > 0) || !(ph > 0) || !sw || !sh) return;
+    double fw = floor(pw), fh = floor(ph);
+    if (fw * sh > fh * sw) fw = floor(fh * sw / sh + 0.5);
+    else                   fh = floor(fw * sh / sw + 0.5);
+    if (fw > sw && fh > sh) { *ow = (unsigned)fw; *oh = (unsigned)fh; }
+}
+
+/* PS3_DOWNSCALE_LINEAR: 1 = reduce in linear light (experimental, off). */
+static inline int hd_downscale_linear_from(const char* e)
+{
+    if (!e || !*e || !strcmp(e, "0") || !strcasecmp(e, "off")) return 0;
+    if (!strcmp(e, "1") || !strcasecmp(e, "on")) return 1;
+    fprintf(stderr, "[host window] PS3_DOWNSCALE_LINEAR=%s unknown (0, 1); off\n", e);
+    return 0;
+}
+
+/* PS3_CAS_AFTER: 1 (default) = while the picture is reduced (PS3_DOWNSCALE),
+ * the game's sharpening (PS3_SHARPEN) is applied here, after the reduction,
+ * instead of before it, where the reduction averages most of it away.
+ * 0 = the game sharpens every frame as before. */
+static inline int hd_cas_after_from(const char* e)
+{
+    if (!e || !*e) return 1;
+    if (!strcmp(e, "0") || !strcasecmp(e, "off")) return 0;
+    if (!strcmp(e, "1") || !strcasecmp(e, "on")) return 1;
+    fprintf(stderr, "[host window] PS3_CAS_AFTER=%s unknown (0, 1); on\n", e);
+    return 1;
+}
+
+/* The largest w:h size (sw:sh) that fits in pw x ph pixels, smaller than
+ * sw x sh or not: *ow x *oh, else sw x sh when there is no area. */
+static inline void hd_fit_any(double pw, double ph, unsigned sw, unsigned sh, unsigned* ow, unsigned* oh)
+{
+    *ow = sw; *oh = sh;
+    if (!(pw >= 1) || !(ph >= 1) || !sw || !sh) return;
+    double fw = floor(pw), fh = floor(ph);
+    if (fw * sh > fh * sw) fw = floor(fh * sw / sh + 0.5);
+    else                   fh = floor(fw * sh / sw + 0.5);
+    if (fw < 1) fw = 1;
+    if (fh < 1) fh = 1;
+    *ow = (unsigned)fw; *oh = (unsigned)fh;
+}
+
+/* The content size that fits in a screen area of aw x ah, keeping w:h. */
+static inline void hd_shrink_to(double aw, double ah, double* w, double* h)
+{
+    if (!(aw > 0) || !(ah > 0) || !(*w > 0) || !(*h > 0)) return;
+    const double k = fmin(1.0, fmin(aw / *w, ah / *h));
+    if (k < 1.0) { *w = floor(*w * k); *h = floor(*h * k); }
+}
+
+#endif /* PS3RECOMP_HOST_DISPLAY_H */
diff --git a/tools/host_window/host_window.m b/tools/host_window/host_window.m
new file mode 100644
index 00000000..4266dca5
--- /dev/null
+++ b/tools/host_window/host_window.m
@@ -0,0 +1,1345 @@
+/*
+ * ps3recomp - host window: one window across an executable swap (macOS)
+ *
+ *   host_window [--title T] [--size WxH] [--] <program> [args...]
+ *
+ * Opens the game window, then runs <program> with PS3RECOMP_HOST_SURFACES set
+ * in its environment. The Metal backend in <program> sees it and, instead of
+ * opening a window of its own, renders into IOSurfaces this process shares
+ * with it (rsx_host_surface.h); this process blits the newest finished one
+ * into the window. When the game replaces its executable (exitspawn is an
+ * execv, same pid) the new image attaches again by the same name, and the
+ * window never goes away.
+ *
+ *   window closed / Cmd-Q / SIGINT, SIGTERM, SIGHUP here
+ *       -> `closed` in the control page, SIGTERM to the game, SIGKILL 3 s later
+ *   game exits -> exit with its status (0 after a close asked for here)
+ *
+ * The game process has no window and never touches NSApplication, so it gets
+ * no Dock icon; this process is the app the user sees.
+ *
+ * Keyboard and mouse: their events arrive here, so this process records them
+ * in the control page's input block (libs/input/host_input_cocoa.h) and the
+ * game's cellPad reads it. A left click in the game captures the cursor when
+ * the game asks for that (its mouse camera, PS3_MOUSE / PS3_MOUSE_CAPTURE on
+ * the game's side); Esc, Cmd or leaving the window releases it.
+ *
+ * Environment:
+ *   PS3_TITLE              window title (default: HOST_WINDOW_TITLE, built in)
+ *   PS3_WINDOW_MODE, PS3_WINDOW_SIZE, PS3_DISPLAY, PS3_VSYNC, PS3_UPSCALE,
+ *   PS3_DOWNSCALE, PS3_CAS_AFTER, PS3_DOWNSCALE_LINEAR
+ *                          how the window opens and presents (host_display.h)
+ *   PS3_OVERLAY_INI        the game's in-game menu settings file: PS3_VSYNC,
+ *                          PS3_WINDOW_MODE and PS3_UPSCALE are read from it
+ *                          when they are not in the environment
+ *                          (libs/video/ps3_overlay_settings.h)
+ *   PS3RECOMP_METAL_FPS=1  FPS in the title and [RSX FPS] lines, as the backend's
+ *                          own window does; guest FPS comes from the game.
+ *                          A line ends in hidden=1 while the window is off
+ *                          screen (below)
+ *   PS3RECOMP_HOST_STATS=1 once a second: publish->screen latency, frames
+ *                          copied/dropped, and this process's CPU time
+ *
+ * Off screen: macOS shows nothing of a window that is not on screen: another
+ * app or Space in front (with PS3_WINDOW_MODE=fullscreen the window has a
+ * Space of its own, so bringing any other app to the front hides it),
+ * minimized, or fully covered. Presents go on and are dropped unseen, so the
+ * display rate reads 0 while the guest's goes on, which in a log looks like a
+ * frozen picture. The window logs when it leaves the screen and when it is
+ * back, and shows the newest frame as soon as it is back.
+ *
+ * In-game menu (libs/video/ps3_overlay.mm): its keys (F1, Insert, Cmd+,)
+ * are counted in the input block, and while it is open the pointer goes to
+ * it (host_input_cocoa.h). Its display options -- vsync, the display mode,
+ * MetalFX -- are this window's: the game asks in the control page and the
+ * input tick applies them (rsx_host_surface.h, want_* / now_*).
+ *
+ * Screenshot: View > Save Screenshot (Cmd+Shift+S), or SIGUSR1 to this
+ * process, saves the next frame as it is put on the screen -- after the
+ * reduction or MetalFX and the sharpening, at the window's size -- as a PNG in
+ * ~/Pictures/<title>/.
+ *
+ * If the bootstrap service cannot be registered the program is exec'd
+ * directly and opens its own window, as it would without this launcher.
+ */
+#import <AppKit/AppKit.h>
+#import <IOSurface/IOSurface.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#if __has_include(<MetalFX/MetalFX.h>)
+#  import <MetalFX/MetalFX.h>
+#  define HOST_HAVE_METALFX 1
+#endif
+
+#include <dlfcn.h>
+#if __has_include(<MetalPerformanceShaders/MetalPerformanceShaders.h>)
+#  import <MetalPerformanceShaders/MetalPerformanceShaders.h>
+#  define HOST_HAVE_MPS 1
+#endif
+
+#include <errno.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <servers/bootstrap.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "host_display.h"
+#include "metal_frame_rate.h"
+#include "rsx_host_surface.h"
+#include "ps3_overlay_settings.h"
+#include "../../libs/input/host_input_cocoa.h"
+
+#ifndef HOST_WINDOW_TITLE
+#define HOST_WINDOW_TITLE "ps3recomp"
+#endif
+
+extern char** environ;
+
+static struct {
+    /* the shared side */
+    char                 name[128];
+    mach_port_t          service;          /* receive right, bootstrap-registered */
+    rsx_host_control*    ctl;
+    mach_port_t          ctl_entry;        /* memory entry for the control page */
+    IOSurfaceRef         surface[RSX_HOST_SLOTS];
+    id<MTLTexture>       tex[RSX_HOST_SLOTS];
+    u_int32_t            width, height;
+    /* the window */
+    id<MTLDevice>        dev;
+    id<MTLCommandQueue>  queue;
+    CAMetalLayer*        layer;
+    NSWindow*            window;
+    NSString*            title;
+    int                  present_busy;
+    uint64_t             shown_seq;
+    int                  off_screen;       /* see "Off screen" above */
+    double               off_since;
+    HostInputCocoa       input;            /* keys and mouse -> ctl->input */
+    /* display options (host_display.h) */
+    int                  fs_style;         /* what View > Full Screen enters */
+    int                  borderless;
+    NSRect               saved_frame;
+    NSWindowStyleMask    saved_style;
+    int                  upscale_on;       /* PS3_UPSCALE=metalfx, still working */
+    int                  upscale_dead;     /* MetalFX failed here: the menu shows it unavailable */
+    int                  pending_borderless;   /* the menu asked for borderless while in macOS fullscreen */
+    id                   fx_scaler;        /* id<MTLFXSpatialScaler> */
+    id<MTLTexture>       fx_out;
+    int                  down_on;          /* PS3_DOWNSCALE: Lanczos into a smaller window */
+    int                  cas_after;        /* PS3_CAS_AFTER: sharpen reduced frames here */
+    id<MTLRenderPipelineState> cas_pso;    /* the game's CAS, into the drawable */
+    id<MTLSamplerState>  cas_samp;
+    float                cas_logged;
+    id<MTLLibrary>       lib;              /* kCasMSL: the CAS and the filtered copy */
+    id<MTLRenderPipelineState> copy_pso;   /* a linear-filtered scaled copy (the fallback) */
+    id<MTLSamplerState>  lin_samp;
+    int                  down_linear;      /* PS3_DOWNSCALE_LINEAR: the reduction in linear light */
+    id<MTLTexture>       ds_out_raw;       /* ds_out's bytes as plain BGRA8 (linear mode) */
+    int                  direct_checked, direct_ok;   /* drawables a shader may write: reduce into them */
+    int                  gpu_errors, gpu_fail_run; /* failed present command buffers: all, in a row */
+    int                  shot_pending;     /* a screenshot of the next frame shown */
+    id                   ds_kernel;        /* MPSImageLanczosScale */
+    id<MTLTexture>       ds_out;
+    /* the game */
+    pid_t                child;
+    int                  closing;
+    int                  child_status;
+    /* diagnostics */
+    double               tick_to_s;
+    int                  fps_on, stats_on;
+    MetalFrameRate       fps;
+    pthread_mutex_t      fps_lock;
+    uint64_t             last_guest;
+    double               lat_sum, lat_max, copy_sum;
+    unsigned             lat_n, copy_n, copies;
+} g = { .fps_lock = PTHREAD_MUTEX_INITIALIZER };
+
+static void begin_close(const char* why);
+static void keep_drawable(void);
+
+/* ---- surfaces ------------------------------------------------------------ */
+
+static IOSurfaceRef make_surface(u_int32_t w, u_int32_t h)
+{
+    const size_t bpr = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, (size_t)w * 4);
+    NSDictionary* props = @{
+        (id)kIOSurfaceWidth:           @(w),
+        (id)kIOSurfaceHeight:          @(h),
+        (id)kIOSurfaceBytesPerElement: @4,
+        (id)kIOSurfaceBytesPerRow:     @(bpr),
+        (id)kIOSurfaceAllocSize:       @(bpr * h),
+        (id)kIOSurfacePixelFormat:     @((u_int32_t)'BGRA'),
+    };
+    return IOSurfaceCreate((__bridge CFDictionaryRef)props);
+}
+
+/* (Re)create every surface at w x h. A surface the window is still copying
+ * from stays READING and is freed by that copy's completion; the copy holds
+ * its own reference to the old texture. */
+static int make_surfaces(u_int32_t w, u_int32_t h)
+{
+    IOSurfaceRef sf[RSX_HOST_SLOTS] = { 0 };
+    id<MTLTexture> tex[RSX_HOST_SLOTS] = { nil };
+    MTLTextureDescriptor* td =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                           width:w height:h mipmapped:NO];
+    td.usage       = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget |
+                     (g.down_linear ? MTLTextureUsagePixelFormatView : 0);   /* an sRGB view for PS3_DOWNSCALE_LINEAR */
+    td.storageMode = g.dev.hasUnifiedMemory ? MTLStorageModeShared : MTLStorageModeManaged;
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        sf[i] = make_surface(w, h);
+        if (sf[i]) tex[i] = [g.dev newTextureWithDescriptor:td iosurface:sf[i] plane:0];
+        if (!tex[i]) {
+            for (int j = 0; j <= i; j++) if (sf[j]) CFRelease(sf[j]);
+            return -1;
+        }
+    }
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        if (g.surface[i]) CFRelease(g.surface[i]);
+        g.surface[i] = sf[i];
+        g.tex[i] = tex[i];
+        uint32_t s = atomic_load(&g.ctl->state[i]);
+        if (s != RSX_HOST_READING) atomic_store(&g.ctl->state[i], RSX_HOST_FREE);
+        atomic_store(&g.ctl->seq[i], 0);
+    }
+    g.width = w; g.height = h;
+    g.ctl->width = w; g.ctl->height = h;
+    g.input.aspect = (double)w / (double)h;     /* the menu's pointer, over the letterboxed picture */
+    g.ctl->generation++;
+    g.shown_seq = atomic_load(&g.ctl->next_seq);
+    keep_drawable();
+    return 0;
+}
+
+static int make_control(void)
+{
+    vm_address_t addr = 0;
+    if (vm_allocate(mach_task_self(), &addr, RSX_HOST_CONTROL_BYTES, VM_FLAGS_ANYWHERE) != KERN_SUCCESS)
+        return -1;
+    memory_object_size_t size = RSX_HOST_CONTROL_BYTES;
+    if (mach_make_memory_entry_64(mach_task_self(), &size, addr, VM_PROT_READ | VM_PROT_WRITE,
+                                  &g.ctl_entry, MACH_PORT_NULL) != KERN_SUCCESS ||
+        size < RSX_HOST_CONTROL_BYTES)
+        return -1;
+    g.ctl = (rsx_host_control*)addr;
+    g.ctl->magic        = RSX_HOST_MAGIC;
+    g.ctl->version      = RSX_HOST_VERSION;
+    g.ctl->launcher_pid = getpid();
+    g.input.in          = &g.ctl->input;
+    atomic_store(&g.ctl->input.pointer, PS3_HOST_POINTER_NONE);
+    rsx_host_display_init(g.ctl, RSX_HOST_DISPLAY_VSYNC | RSX_HOST_DISPLAY_WINDOW_MODE | RSX_HOST_DISPLAY_UPSCALE);
+    return 0;
+}
+
+/* ---- the game's messages ------------------------------------------------- */
+
+static void reply_surfaces(mach_port_t reply)
+{
+    rsx_host_surfaces_msg m;
+    memset(&m, 0, sizeof m);
+    m.header.msgh_bits        = MACH_MSGH_BITS(MACH_MSG_TYPE_MOVE_SEND_ONCE, 0) | MACH_MSGH_BITS_COMPLEX;
+    m.header.msgh_size        = sizeof m;
+    m.header.msgh_remote_port = reply;
+    m.header.msgh_id          = RSX_HOST_MSG_SURFACES;
+    m.body.msgh_descriptor_count = 1 + RSX_HOST_SLOTS;
+    m.control.name        = g.ctl_entry;
+    m.control.disposition = MACH_MSG_TYPE_COPY_SEND;
+    m.control.type        = MACH_MSG_PORT_DESCRIPTOR;
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        m.surface[i].name        = IOSurfaceCreateMachPort(g.surface[i]);
+        m.surface[i].disposition = MACH_MSG_TYPE_MOVE_SEND;
+        m.surface[i].type        = MACH_MSG_PORT_DESCRIPTOR;
+    }
+    m.width = g.width; m.height = g.height;
+    m.generation   = g.ctl->generation;
+    m.launcher_pid = getpid();
+    kern_return_t kr = mach_msg(&m.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof m, 0,
+                                MACH_PORT_NULL, 1000, MACH_PORT_NULL);
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr, "[host window] reply failed: %s\n", mach_error_string(kr));
+        for (int i = 0; i < RSX_HOST_SLOTS; i++)
+            mach_port_deallocate(mach_task_self(), m.surface[i].name);
+        mach_port_deallocate(mach_task_self(), reply);
+    }
+}
+
+static void on_attach(const rsx_host_attach_msg* a)
+{
+    const u_int32_t w = a->width, h = a->height;
+    if (w && h && w <= RSX_HOST_MAX_DIM && h <= RSX_HOST_MAX_DIM && (w != g.width || h != g.height)) {
+        if (make_surfaces(w, h) != 0)
+            fprintf(stderr, "[host window] could not make %ux%u surfaces; keeping %ux%u\n",
+                    w, h, g.width, g.height);
+    } else {
+        rsx_host_reset_rendering(g.ctl);       /* a new image: the old one's frames are gone */
+    }
+    fprintf(stderr, "[host window] pid %d attached: %ux%u, generation %u\n",
+            a->pid, g.width, g.height, g.ctl->generation);
+    reply_surfaces(a->header.msgh_remote_port);
+}
+
+static void try_present(void);
+static void save_screenshot(id<MTLTexture> shot);
+
+static void drain_messages(void)
+{
+    for (;;) {
+        union { rsx_host_attach_msg attach; rsx_host_frame_msg frame; } u;
+        struct { char buf[sizeof u]; mach_msg_trailer_t t; } in;
+        memset(&in, 0, sizeof in);
+        mach_msg_header_t* h = (mach_msg_header_t*)in.buf;
+        kern_return_t kr = mach_msg(h, MACH_RCV_MSG | MACH_RCV_TIMEOUT | MACH_RCV_LARGE, 0,
+                                    sizeof in, g.service, 0, MACH_PORT_NULL);
+        if (kr == MACH_RCV_TOO_LARGE) {             /* not ours: drop it */
+            mach_msg(h, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, 0, g.service, 0, MACH_PORT_NULL);
+            continue;
+        }
+        if (kr != KERN_SUCCESS) break;
+        if (h->msgh_id == RSX_HOST_MSG_ATTACH && h->msgh_size >= sizeof(rsx_host_attach_msg) &&
+            !(h->msgh_bits & MACH_MSGH_BITS_COMPLEX))
+            on_attach((const rsx_host_attach_msg*)h);
+        else if (h->msgh_id != RSX_HOST_MSG_FRAME)
+            mach_msg_destroy(h);
+    }
+    try_present();
+}
+
+/* ---- presenting ---------------------------------------------------------- */
+
+static void note_presented(double shown, uint64_t published)
+{
+    if (!(shown > 0)) return;
+    pthread_mutex_lock(&g.fps_lock);
+    metal_frame_rate_presented(&g.fps, shown);
+    const double lat = shown - (double)published * g.tick_to_s;
+    if (published && lat >= 0 && lat < 10) {
+        g.lat_sum += lat; g.lat_n++;
+        if (lat > g.lat_max) g.lat_max = lat;
+    }
+    pthread_mutex_unlock(&g.fps_lock);
+}
+
+/* The drawable's size: the surfaces' (the layer letterboxes them to the
+ * window); with PS3_UPSCALE the view's pixel size fitted to their aspect when
+ * that is larger, and with PS3_DOWNSCALE when it is smaller. */
+static void keep_drawable(void)
+{
+    if (!g.layer || !g.width || !g.height) return;
+    unsigned w = g.width, h = g.height;
+    if ((g.upscale_on || g.down_on) && g.window) {
+        NSView* v = g.window.contentView;
+        const NSSize px = v ? [v convertSizeToBacking:v.bounds.size] : NSZeroSize;
+        unsigned fw, fh;
+        hd_fit_any(px.width, px.height, g.width, g.height, &fw, &fh);
+        if (g.upscale_on && fw > g.width && fh > g.height) { w = fw; h = fh; }
+        if (g.down_on && fw < g.width && fh < g.height) { w = fw; h = fh; }
+    }
+    /* the game leaves sharpening to us only while we reduce */
+    if (g.ctl) atomic_store(&g.ctl->reducing, (uint32_t)(g.down_on && w < g.width && h < g.height));
+    const CGSize want = CGSizeMake(w, h);
+    if (!CGSizeEqualToSize(g.layer.drawableSize, want)) g.layer.drawableSize = want;
+}
+
+/* MetalFX gave up: say why once and present at the surfaces' size. */
+static void upscale_fail(const char* why)
+{
+    if (!g.upscale_on) return;
+    g.upscale_on = 0;
+    g.upscale_dead = 1;
+    g.fx_scaler = nil; g.fx_out = nil;
+    fprintf(stderr, "[host window] MetalFX upscaling unavailable (%s); presenting at %ux%u\n",
+            why, g.width, g.height);
+    keep_drawable();
+}
+
+/* PS3_CAS_AFTER: the game's contrast-adaptive sharpening (rsx_metal_backend.m,
+ * eng_present_fs's sharpen block, the same code) for a frame the game handed
+ * over unsharpened: one source texel apart, drawn straight into the drawable
+ * in place of the copy. */
+static NSString* const kCasMSL = @
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct VOut { float4 pos [[position]]; float2 uv; };\n"
+"vertex VOut cas_vs(uint i [[vertex_id]]) {\n"
+"    float2 p = float2((i << 1) & 2, i & 2); VOut o;\n"
+"    o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0); o.uv = float2(p.x, 1.0 - p.y); return o; }\n"
+"fragment float4 cas_fs(VOut i [[stage_in]], texture2d<float> src [[texture(0)]],\n"
+"                       sampler s [[sampler(0)]], constant float3& p [[buffer(0)]]) {\n"
+"    float4 c = src.sample(s, i.uv); float2 d = p.xy;\n"
+"    float3 a  = saturate(src.sample(s, i.uv + float2(-d.x, -d.y)).rgb);\n"
+"    float3 b  = saturate(src.sample(s, i.uv + float2( 0.0, -d.y)).rgb);\n"
+"    float3 cc = saturate(src.sample(s, i.uv + float2( d.x, -d.y)).rgb);\n"
+"    float3 l  = saturate(src.sample(s, i.uv + float2(-d.x,  0.0)).rgb);\n"
+"    float3 e  = saturate(c.rgb);\n"
+"    float3 r  = saturate(src.sample(s, i.uv + float2( d.x,  0.0)).rgb);\n"
+"    float3 g  = saturate(src.sample(s, i.uv + float2(-d.x,  d.y)).rgb);\n"
+"    float3 h  = saturate(src.sample(s, i.uv + float2( 0.0,  d.y)).rgb);\n"
+"    float3 k  = saturate(src.sample(s, i.uv + float2( d.x,  d.y)).rgb);\n"
+"    float3 mn = min(min(min(l, e), min(r, b)), h); mn += min(mn, min(min(a, cc), min(g, k)));\n"
+"    float3 mx = max(max(max(l, e), max(r, b)), h); mx += max(mx, max(max(a, cc), max(g, k)));\n"
+"    float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-5)));\n"
+"    float3 w = amp * (-1.0 / mix(8.0, 5.0, saturate(p.z)));\n"
+"    c.rgb = saturate((b * w + l * w + r * w + h * w + e) / (1.0 + 4.0 * w)); return c; }\n"
+"fragment float4 copy_fs(VOut i [[stage_in]], texture2d<float> src [[texture(0)]], sampler s [[sampler(0)]]) {\n"
+"    return src.sample(s, i.uv); }\n";
+
+/* kCasMSL compiled once (the CAS and the filtered copy share it). */
+static id<MTLLibrary> host_lib(void)
+{
+    if (!g.lib) {
+        NSError* err = nil;
+        g.lib = [g.dev newLibraryWithSource:kCasMSL options:nil error:&err];
+        if (!g.lib) fprintf(stderr, "[host window] shaders failed: %s\n", err.localizedDescription.UTF8String);
+    }
+    return g.lib;
+}
+
+/* src scaled into dst with a linear filter: the fallback when the reduction or
+ * MetalFX cannot run for a frame, so the drawable already taken is shown
+ * instead of dropped. 0 when it cannot be encoded. */
+static int scaled_copy(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst)
+{
+    if (!g.copy_pso) {
+        id<MTLLibrary> lib = host_lib();
+        if (!lib) return 0;
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction   = [lib newFunctionWithName:@"cas_vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"copy_fs"];
+        pd.colorAttachments[0].pixelFormat = dst.pixelFormat;
+        NSError* err = nil;
+        g.copy_pso = [g.dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        MTLSamplerDescriptor* sd = [MTLSamplerDescriptor new];
+        sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterLinear;
+        g.lin_samp = [g.dev newSamplerStateWithDescriptor:sd];
+        if (!g.copy_pso || !g.lin_samp) return 0;
+    }
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = dst;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!e) return 0;
+    [e setRenderPipelineState:g.copy_pso];
+    [e setFragmentTexture:src atIndex:0];
+    [e setFragmentSamplerState:g.lin_samp atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    return 1;
+}
+
+/* The CAS pipeline, made once; sharpen_caps tells the game it may leave
+ * sharpening to us. Off (caps 0) when it cannot be made. */
+static void cas_setup(MTLPixelFormat fmt)
+{
+    if (!g.cas_after || g.cas_pso) return;
+    NSError* err = nil;
+    id<MTLLibrary> lib = host_lib();
+    MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction   = [lib newFunctionWithName:@"cas_vs"];
+    pd.fragmentFunction = [lib newFunctionWithName:@"cas_fs"];
+    pd.colorAttachments[0].pixelFormat = fmt;
+    g.cas_pso = lib ? [g.dev newRenderPipelineStateWithDescriptor:pd error:&err] : nil;
+    g.cas_samp = [g.dev newSamplerStateWithDescriptor:[MTLSamplerDescriptor new]];   /* nearest, clamp */
+    if (!g.cas_pso || !g.cas_samp) {
+        fprintf(stderr, "[host window] sharpening after the reduction unavailable (%s); the game sharpens\n",
+                err ? err.localizedDescription.UTF8String : "no pipeline");
+        g.cas_after = 0; g.cas_pso = nil;
+        return;
+    }
+    if (g.ctl) atomic_store(&g.ctl->sharpen_caps, 1u);
+}
+
+/* src sharpened (strength `sharp`) into dst, which is the same size. 0 if it
+ * cannot be encoded (the caller copies instead). */
+static int cas_into(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst, float sharp)
+{
+    if (!g.cas_pso || src.width != dst.width || src.height != dst.height) return 0;
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = dst;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!e) return 0;
+    const float p[4] = { 1.0f / (float)src.width, 1.0f / (float)src.height, sharp, 0.0f };
+    [e setRenderPipelineState:g.cas_pso];
+    [e setFragmentTexture:src atIndex:0];
+    [e setFragmentSamplerState:g.cas_samp atIndex:0];
+    [e setFragmentBytes:p length:sizeof p atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    if (g.cas_logged != sharp) {
+        g.cas_logged = sharp;
+        fprintf(stderr, "[host window] sharpening %.2f after the reduction, %lux%lu\n", (double)sharp,
+                (unsigned long)dst.width, (unsigned long)dst.height);
+    }
+    return 1;
+}
+
+/* Lanczos gave up: say why once and present at the surfaces' size. */
+static void downscale_fail(const char* why)
+{
+    if (!g.down_on) return;
+    g.down_on = 0;
+    g.ds_kernel = nil; g.ds_out = nil; g.ds_out_raw = nil;
+    fprintf(stderr, "[host window] supersampling downscale unavailable (%s); the layer shrinks the picture\n", why);
+    keep_drawable();
+}
+
+/* The Lanczos kernel (MPSImageLanczosScale), made once; nil when it cannot be.
+ * MPS is looked up when first needed. */
+static id lanczos_kernel(void)
+{
+#if HOST_HAVE_MPS
+    static Class lanczos;
+    if (!lanczos) {
+        dlopen("/System/Library/Frameworks/MetalPerformanceShaders.framework/MetalPerformanceShaders",
+               RTLD_LAZY | RTLD_LOCAL);
+        lanczos = NSClassFromString(@"MPSImageLanczosScale");
+        if (!lanczos) { downscale_fail("MetalPerformanceShaders is not on this system"); return nil; }
+    }
+    if (!g.ds_kernel) {
+        g.ds_kernel = [[lanczos alloc] initWithDevice:g.dev];
+        if (!g.ds_kernel) { downscale_fail("not supported on this GPU"); return nil; }
+        /* The filter's taps past the picture's edge read the edge pixel, not
+         * black: with MPS's default (zero) the outer row and column came out
+         * darker, a 1-pixel frame (a white picture gave 223..245 there). */
+        ((MPSImageLanczosScale*)g.ds_kernel).edgeMode = MPSImageEdgeModeClamp;
+    }
+    return g.ds_kernel;
+#else
+    downscale_fail("built without MetalPerformanceShaders");
+    return nil;
+#endif
+}
+
+/* src reduced with a Lanczos filter into a private texture of ow x oh: every
+ * source pixel is weighed into the result, which is what turns an internal
+ * resolution above the window's into supersampling. nil when it cannot.
+ *
+ * PS3_DOWNSCALE_LINEAR=1 (experimental, off): the source is read through an
+ * sRGB view and written to an sRGB target, so the filter averages light, not
+ * gamma-encoded values; thin bright lines keep more of their brightness (the
+ * game's frames measured no better overall, with 4x the overshoot). The
+ * returned texture is then a plain BGRA8 view of the encoded bytes. */
+static id<MTLTexture> downscale(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger ow, NSUInteger oh)
+{
+#if HOST_HAVE_MPS
+    if (!lanczos_kernel()) return nil;
+    const int linear = g.down_linear && (src.usage & MTLTextureUsagePixelFormatView);
+    const MTLPixelFormat ofmt = linear ? MTLPixelFormatBGRA8Unorm_sRGB : src.pixelFormat;
+    if (!g.ds_out || g.ds_out.width != ow || g.ds_out.height != oh || g.ds_out.pixelFormat != ofmt) {
+        MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:ofmt
+                                                                                      width:ow height:oh
+                                                                                  mipmapped:NO];
+        td.usage       = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead |
+                         (linear ? MTLTextureUsagePixelFormatView : 0);
+        td.storageMode = MTLStorageModePrivate;
+        g.ds_out = [g.dev newTextureWithDescriptor:td];
+        if (!g.ds_out) { downscale_fail("no memory for its output"); return nil; }
+        g.ds_out_raw = linear ? [g.ds_out newTextureViewWithPixelFormat:MTLPixelFormatBGRA8Unorm] : nil;
+        fprintf(stderr, "[host window] supersampling: %lux%lu reduced to %lux%lu (Lanczos%s)\n",
+                (unsigned long)src.width, (unsigned long)src.height, (unsigned long)ow, (unsigned long)oh,
+                linear ? ", linear light" : "");
+    }
+    if (!(src.usage & MTLTextureUsageShaderRead)) { downscale_fail("the surfaces cannot be read by a shader"); return nil; }
+    id<MTLTexture> in = linear ? [src newTextureViewWithPixelFormat:MTLPixelFormatBGRA8Unorm_sRGB] : src;
+    [(MPSImageLanczosScale*)g.ds_kernel encodeToCommandBuffer:cb sourceTexture:in destinationTexture:g.ds_out];
+    return linear ? g.ds_out_raw : g.ds_out;
+#else
+    (void)cb; (void)src; (void)ow; (void)oh;
+    downscale_fail("built without MetalPerformanceShaders");
+    return nil;
+#endif
+}
+
+/* The reduction written straight into the drawable, when a shader may write
+ * it (and not in linear mode): no texture of its own and no copy after it.
+ * Checked once; 0 = use downscale() and copy. */
+static int downscale_direct(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst)
+{
+#if HOST_HAVE_MPS
+    if (!g.direct_checked) {
+        g.direct_checked = 1;
+        g.direct_ok = (dst.usage & MTLTextureUsageShaderWrite) != 0;
+        fprintf(stderr, "[host window] supersampling %s\n", g.direct_ok
+                ? "writes straight into the drawable (no copy)"
+                : "goes through its own texture (the drawables are not shader-writable), then a copy");
+    }
+    if (!g.direct_ok || g.down_linear || !lanczos_kernel()) return 0;
+    if (!(src.usage & MTLTextureUsageShaderRead)) return 0;
+    [(MPSImageLanczosScale*)g.ds_kernel encodeToCommandBuffer:cb sourceTexture:src destinationTexture:dst];
+    return 1;
+#else
+    (void)cb; (void)src; (void)dst;
+    return 0;
+#endif
+}
+
+/* src through a MetalFX spatial scaler into a private texture of ow x oh;
+ * nil when it cannot. MetalFX is looked up when first needed, so the window
+ * host links nothing new and runs where it is missing. */
+static id<MTLTexture> upscale(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger ow, NSUInteger oh)
+{
+#if HOST_HAVE_METALFX
+    if (@available(macOS 13.0, *)) {
+        static Class desc_class;
+        if (!desc_class) {
+            dlopen("/System/Library/Frameworks/MetalFX.framework/MetalFX", RTLD_LAZY | RTLD_LOCAL);
+            desc_class = NSClassFromString(@"MTLFXSpatialScalerDescriptor");
+            if (!desc_class) { upscale_fail("MetalFX is not on this system"); return nil; }
+        }
+        const MTLPixelFormat fmt = src.pixelFormat;
+        id<MTLFXSpatialScaler> sc = (id<MTLFXSpatialScaler>)g.fx_scaler;
+        if (!sc || sc.inputWidth != src.width || sc.inputHeight != src.height ||
+            sc.outputWidth != ow || sc.outputHeight != oh) {
+            g.fx_scaler = nil; g.fx_out = nil;
+            if (![desc_class supportsDevice:g.dev]) { upscale_fail("not supported on this GPU"); return nil; }
+            MTLFXSpatialScalerDescriptor* d = [desc_class new];
+            d.inputWidth  = src.width;  d.inputHeight  = src.height;
+            d.outputWidth = ow;         d.outputHeight = oh;
+            d.colorTextureFormat  = fmt;
+            d.outputTextureFormat = fmt;
+            d.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;   /* gamma-encoded */
+            sc = [d newSpatialScalerWithDevice:g.dev];
+            if (!sc) { upscale_fail("could not create the spatial scaler"); return nil; }
+            MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt
+                                                                                          width:ow height:oh
+                                                                                      mipmapped:NO];
+            td.usage       = sc.outputTextureUsage | MTLTextureUsageShaderRead;
+            td.storageMode = MTLStorageModePrivate;
+            id<MTLTexture> out = [g.dev newTextureWithDescriptor:td];
+            if (!out) { upscale_fail("no memory for its output"); return nil; }
+            fprintf(stderr, "[host window] MetalFX spatial upscaling %lux%lu -> %lux%lu\n",
+                    (unsigned long)src.width, (unsigned long)src.height,
+                    (unsigned long)ow, (unsigned long)oh);
+            g.fx_scaler = sc;
+            g.fx_out = out;
+        }
+        if ((src.usage & sc.colorTextureUsage) != sc.colorTextureUsage) {
+            upscale_fail("the surfaces' usage does not allow it");
+            return nil;
+        }
+        sc.colorTexture       = src;
+        sc.outputTexture      = g.fx_out;
+        sc.inputContentWidth  = src.width;
+        sc.inputContentHeight = src.height;
+        [sc encodeToCommandBuffer:cb];
+        return g.fx_out;
+    }
+    upscale_fail("needs macOS 13");
+    return nil;
+#else
+    (void)cb; (void)src; (void)ow; (void)oh;
+    upscale_fail("built without MetalFX");
+    return nil;
+#endif
+}
+
+/* The newest frame the game has finished, onto the window: one GPU copy from
+ * its surface into a drawable of the same size, which the layer letterboxes
+ * into the window (with PS3_UPSCALE, MetalFX to the window's pixel size
+ * first). At most one copy is in flight; its completion looks for a newer
+ * frame. */
+static void try_present(void)
+{
+    if (g.present_busy || !g.ctl) return;
+    uint64_t seq = 0;
+    const int slot = rsx_host_begin_read(g.ctl, g.shown_seq, &seq);
+    if (slot < 0) return;
+    @autoreleasepool {
+        id<MTLTexture> src = g.tex[slot];
+        id<CAMetalDrawable> drawable = nil;
+        const CGSize ds = g.layer.drawableSize;
+        const int same  = src.width == (NSUInteger)ds.width && src.height == (NSUInteger)ds.height;
+        const int scale = !same && g.upscale_on &&
+                          (NSUInteger)ds.width > src.width && (NSUInteger)ds.height > src.height;
+        const int down  = !same && g.down_on &&
+                          (NSUInteger)ds.width < src.width && (NSUInteger)ds.height < src.height;
+        if (same || scale || down) drawable = [g.layer nextDrawable];
+        id<MTLCommandBuffer> cb = drawable ? [g.queue commandBuffer] : nil;
+        /* the strength the game left to us for this frame (0: it sharpened it,
+         * or sharpening is off), applied whatever the path, so exactly once */
+        float sharp = 0.0f;
+        { const uint32_t bits = atomic_load(&g.ctl->slot_sharpen[slot]); memcpy(&sharp, &bits, sizeof sharp); }
+        id<MTLTexture> from = src;
+        int done_into = 0, fallback = 0;
+        if (cb && scale) {
+            from = upscale(cb, src, (NSUInteger)ds.width, (NSUInteger)ds.height);
+            if (!from) fallback = 1;            /* MetalFX is off now: this frame filtered, plain next time */
+        } else if (cb && down) {
+            if (!(sharp > 0.0f) && downscale_direct(cb, src, drawable.texture)) done_into = 1;
+            else {
+                from = downscale(cb, src, (NSUInteger)ds.width, (NSUInteger)ds.height);
+                if (!from) fallback = 1;        /* the reduction is off now: this frame filtered, plain next time */
+            }
+        }
+        if (cb && fallback && !scaled_copy(cb, src, drawable.texture)) cb = nil;
+        if (!cb) {                              /* no drawable now: show it next time */
+            uint32_t s = RSX_HOST_READING;
+            atomic_compare_exchange_strong(&g.ctl->state[slot], &s, RSX_HOST_READY);
+            return;
+        }
+        if (!done_into && !fallback && !(sharp > 0.0f && cas_into(cb, from, drawable.texture, sharp))) {
+            id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+            [blit copyFromTexture:from toTexture:drawable.texture];
+            [blit endEncoding];
+        }
+        /* a screenshot of exactly what goes to the screen */
+        id<MTLTexture> shot = nil;
+        if (g.shot_pending) {
+            MTLTextureDescriptor* sd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:drawable.texture.pixelFormat
+                width:drawable.texture.width height:drawable.texture.height mipmapped:NO];
+            sd.storageMode = MTLStorageModeShared;
+            shot = [g.dev newTextureWithDescriptor:sd];
+            if (shot) {
+                id<MTLBlitCommandEncoder> sb = [cb blitCommandEncoder];
+                [sb copyFromTexture:drawable.texture toTexture:shot];
+                [sb endEncoding];
+                g.shot_pending = 0;
+            }
+        }
+        const uint64_t published = atomic_load(&g.ctl->publish_time[slot]);
+        [drawable addPresentedHandler:^(id<MTLDrawable> d) { note_presented(d.presentedTime, published); }];
+        [cb presentDrawable:drawable];
+        const int path_down = down && !fallback, path_up = scale && !fallback, path_cas = sharp > 0.0f;
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+            const MTLCommandBufferStatus st = done.status;
+            NSString* why = st == MTLCommandBufferStatusCompleted ? nil
+                          : (done.error.localizedDescription ?: @"no reason given");
+            const double copied = (double)mach_absolute_time() * g.tick_to_s - (double)published * g.tick_to_s;
+            dispatch_async(dispatch_get_main_queue(), ^{
+                rsx_host_end_read(g.ctl, slot);
+                g.present_busy = 0;
+                g.copies++;
+                if (published) { g.copy_sum += copied; g.copy_n++; }
+                /* A present that failed on the GPU: said (the first few, then
+                 * every 100th), and after three in a row on a reduced, upscaled
+                 * or sharpened frame that path is turned off. */
+                if (why) {
+                    g.gpu_errors++; g.gpu_fail_run++;
+                    if (g.gpu_errors <= 5 || g.gpu_errors % 100 == 0)
+                        fprintf(stderr, "[host window] a present failed on the GPU (%d so far%s%s%s): %s\n",
+                                g.gpu_errors, path_down ? ", reduced" : "", path_up ? ", MetalFX" : "",
+                                path_cas ? ", sharpened" : "", why.UTF8String);
+                    if (g.gpu_fail_run >= 3) {
+                        if (path_down) downscale_fail("3 failed presents in a row");
+                        if (path_up) upscale_fail("3 failed presents in a row");
+                        if (path_cas && g.cas_after) {
+                            g.cas_after = 0;
+                            atomic_store(&g.ctl->sharpen_caps, 0u);
+                            fprintf(stderr, "[host window] sharpening after the reduction off (3 failed presents in a row); the game sharpens\n");
+                        }
+                        g.gpu_fail_run = 0;
+                    }
+                } else {
+                    g.gpu_fail_run = 0;
+                    if (shot) save_screenshot(shot);
+                }
+                try_present();
+            });
+        }];
+        g.present_busy = 1;
+        g.shown_seq = seq;
+        [cb commit];
+    }
+}
+
+/* Screenshot: the frame as it went to the screen (shot: a shared copy of the
+ * drawable) as a PNG in ~/Pictures/<title>/. */
+static void save_screenshot(id<MTLTexture> shot)
+{
+    const NSUInteger w = shot.width, h = shot.height;
+    NSBitmapImageRep* rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:(NSInteger)w
+        pixelsHigh:(NSInteger)h bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+        colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:(NSInteger)w * 4 bitsPerPixel:32];
+    if (!rep) return;
+    uint8_t* px = rep.bitmapData;
+    [shot getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    for (NSUInteger i = 0; i < w * h; i++) {          /* BGRA -> RGBA, opaque */
+        uint8_t* p = px + i * 4; const uint8_t b = p[0]; p[0] = p[2]; p[2] = b; p[3] = 255;
+    }
+    NSData* png = [rep representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
+    NSString* title = g.title.length ? g.title : @"ps3recomp";
+    NSString* safe = [[title componentsSeparatedByCharactersInSet:
+                       [NSCharacterSet characterSetWithCharactersInString:@"/:"]] componentsJoinedByString:@"-"];
+    NSString* dir = [[NSHomeDirectory() stringByAppendingPathComponent:@"Pictures"] stringByAppendingPathComponent:safe];
+    [[NSFileManager defaultManager] createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+    NSDateFormatter* f = [NSDateFormatter new];
+    f.dateFormat = @"yyyy-MM-dd 'at' HH.mm.ss";
+    NSString* path = [dir stringByAppendingPathComponent:
+                      [NSString stringWithFormat:@"%@ %@.png", safe, [f stringFromDate:[NSDate date]]]];
+    if ([png writeToFile:path atomically:YES])
+        fprintf(stderr, "[host window] screenshot %lux%lu: %s\n", (unsigned long)w, (unsigned long)h, path.UTF8String);
+    else
+        fprintf(stderr, "[host window] screenshot could not be written to %s\n", path.UTF8String);
+}
+
+static void request_screenshot(void)
+{
+    g.shot_pending = 1;
+    fprintf(stderr, "[host window] screenshot: the next frame shown\n");
+    try_present();
+}
+
+/* The window's occlusion changed: on screen or not (see "Off screen" at the
+ * top). Logged both ways, so a run of display=0 reads as what it is. */
+static void note_on_screen(int on, double now)
+{
+    const int off = !on;
+    if (off == g.off_screen) return;
+    g.off_screen = off;
+    if (!on) {
+        g.off_since = now;
+        fprintf(stderr, "[host window] window off screen (another app or Space in front, minimized or "
+                        "covered): its frames are not shown until it is back\n");
+        return;
+    }
+    fprintf(stderr, "[host window] window on screen again after %.1f s\n", now - g.off_since);
+    try_present();
+}
+
+/* Black until the game's first frame, rather than whatever the drawable held. */
+static void present_black(void)
+{
+    @autoreleasepool {
+        id<CAMetalDrawable> d = [g.layer nextDrawable];
+        if (!d) return;
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture     = d.texture;
+        rp.colorAttachments[0].loadAction  = MTLLoadActionClear;
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        rp.colorAttachments[0].clearColor  = MTLClearColorMake(0, 0, 0, 1);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        [[cb renderCommandEncoderWithDescriptor:rp] endEncoding];
+        [cb presentDrawable:d];
+        [cb commit];
+    }
+}
