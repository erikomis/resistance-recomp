 static CONDITION_VARIABLE s_spu_port_bound = CONDITION_VARIABLE_INIT;
 /* How long an SPU's user event waits for its port to be bound before it is answered with ENOTCONN. */
 #define SPU_PORT_BIND_WAIT_MS 200u
+#define SPU_EVENT_FULL_WAIT_MS 250   /* a full queue: how long an SPU event waits for a slot */
 
 /* The queue `port` of an SPU is bound to: a binding of the thread itself (sys_spu_thread_connect_event, `t`
  * may be NULL) wins over a group-wide one (sys_spu_thread_group_connect_event_all_threads). 0 if there is none.
@@ -1702,6 +1703,31 @@ static int spu_deliver_user_event(spu_context* spu, uint32_t value)
         if (queue) {
             int rc = sys_event_queue_push_by_id(queue, 0xFFFFFFFF53505501ull,
                 spu->spu_id, ((uint64_t)port << 32) | (value & 0xFFFFFFu), data);
+            /* A full queue. lv2 hands the SPU EBUSY and expects it to retry;
+             * SPU code that posts one completion per job to a small queue and
+             * does not retry (inFAMOUS 2's Wwise mixer, a raw SPU thread with
+             * an 8-deep queue) loses that completion when the PPU drains late,
+             * and the PPU thread waiting for it blocks for ever. On the console
+             * the PPU drains fast enough that the queue never fills; give the
+             * consumer the same chance: wait up to a quarter second for a slot
+             * before reporting the failure. */
+            if (rc != 0) {
+                static int n_full;
+                const ULONGLONG give_up = GetTickCount64() + SPU_EVENT_FULL_WAIT_MS;
+                while (rc != 0 && GetTickCount64() < give_up) {
+#if defined(_WIN32)
+                    Sleep(1);
+#else
+                    struct timespec ts = { 0, 50000 };   /* 50 us */
+                    nanosleep(&ts, NULL);
+#endif
+                    rc = sys_event_queue_push_by_id(queue, 0xFFFFFFFF53505501ull,
+                        spu->spu_id, ((uint64_t)port << 32) | (value & 0xFFFFFFu), data);
+                }
+                if (PS3_LOG_FIRST(n_full, 16))
+                    fprintf(stderr, "[spu-evt] queue %u full for an SPU %X event on port %u -- %s\n",
+                            queue, spu->spu_id, port, rc == 0 ? "delivered after waiting" : "DROPPED (EBUSY to the SPU)");
+            }
             result = rc == 0 ? CELL_OK : CELL_EBUSY;
         }
     }
