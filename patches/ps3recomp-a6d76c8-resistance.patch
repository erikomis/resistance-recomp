+    if (!(v >= 1.0 && v <= 4.0)) {
+        fprintf(stderr, "[RSX metal] PS3_RES_SCALE=%s: expected 1..4 (1, 1.5, 2, 3) or "
+                        "720p/1080p/1440p/4k; native\n", e);
