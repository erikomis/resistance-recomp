     return -1;
 }
 
+/* ---------------------------------------------------------------------------
+ * Methods that only shadow state
+ * -----------------------------------------------------------------------*/
+
+/* rsx_process_method keeps an rsx_state for the vtable backends, and their
+ * callbacks are the only readers of one. When the register-file draw engine
+ * renders, no vtable backend is registered, yet the FIFO walker still feeds
+ * every method through here: a chain of ~60 range tests ending in a store
+ * nothing reads, 8% of Resistance 3's RSX thread. A backend that renders
+ * through the engine says so with rsx_state_shadow_enable(0); from then on,
+ * while no vtable backend is registered, the methods listed below return at
+ * once. They do nothing but store -- no label, notify or reference write, no
+ * log. Surface, clear, BEGIN_END, draw, index-array and shader-control
+ * methods are not listed: they log, or their logs read what they store.
+ *   GCM_STATE_SHADOW=1   keep shadowing everything (the old behaviour)
+ * The debug knobs that print from the listed methods or read their state
+ * (RSX_TRACE, TCONST_DBG, SEQ_DBG, VDATA_DBG, LOAD_DBG, MVPDBG) keep it too. */
+static u8  s_state_only[0x800];     /* [method >> 2], method < 0x2000 */
+static int s_shadow_skip = 0;       /* rsx_state_shadow_enable(0) and no knob against it */
+
+void rsx_state_shadow_enable(int on)
+{
+    static int s_built = 0;
+    if (!s_built) {
+        static const struct { u32 first, last; } ranges[] = {
+            { 0x0900, 0x097C },   /* vertex texture units            */
+            { 0x0A20, 0x0A3C },   /* viewport offset and scale       */
+            { 0x0B80, 0x0BFC },   /* SET_TRANSFORM_PROGRAM words     */
+            { 0x1680, 0x16BC },   /* vertex array offsets            */
+            { 0x1740, 0x177C },   /* vertex array formats            */
+            { 0x1840, 0x187C },   /* texture CONTROL3                */
+            { 0x1A00, 0x1BFC },   /* fragment texture units          */
+            { 0x1C00, 0x1CFC },   /* SET_VERTEX_DATA4F               */
+            { 0x1EFC, 0x1EFC },   /* SET_TRANSFORM_CONSTANT_LOAD     */
+            { 0x1F00, 0x1F7C },   /* SET_TRANSFORM_CONSTANT words    */
+            { 0x1FC0, 0x1FC0 },   /* SET_FREQUENCY_DIVIDER_OPERATION */
+        };
+        for (u32 r = 0; r < sizeof ranges / sizeof ranges[0]; r++)
+            for (u32 m = ranges[r].first; m <= ranges[r].last; m += 4)
+                s_state_only[m >> 2] = 1;
+        s_built = 1;
+    }
+    const char* e = getenv("GCM_STATE_SHADOW");
+    const int keep = (e && atoi(e) != 0) || getenv("RSX_TRACE") || getenv("TCONST_DBG") ||
+                     getenv("SEQ_DBG") || getenv("VDATA_DBG") || getenv("LOAD_DBG") ||
+                     getenv("MVPDBG");
+    s_shadow_skip = !on && !keep;
+}
+
 /* ---------------------------------------------------------------------------
  * Main method dispatch
  * -----------------------------------------------------------------------*/
 
 int rsx_process_method(rsx_state* state, u32 method, u32 data)
 {
+    /* A store nothing will read (rsx_state_shadow_enable). */
+    if (s_shadow_skip && !s_backend && method < 0x2000u && s_state_only[method >> 2])
+        return 0;
     /* RSX_TRACE=<N>: trace the first N methods (bare "1" keeps the old 250).
      * The fixed 250 was spent entirely on boot-time setup, so the methods around
      * the first real draw -- exactly the ones worth seeing -- were never traced. */
