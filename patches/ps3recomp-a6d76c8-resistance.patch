+    assert(cellPadSetPressMode(0, 1) == CELL_OK);
+    assert(cellPadSetSensorMode(0, 1) == CELL_OK);
+    assert(s_port_setting[0] == (CELL_PAD_SETTING_PRESS_ON | CELL_PAD_SETTING_SENSOR_ON));
