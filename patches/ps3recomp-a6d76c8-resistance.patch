+static int s_spurs_stats = -1;
+static u64 s_st_ns[6][16], s_st_cpu[6][16], s_st_runs[6][16], s_st_ready[16][10], s_st_passes, s_st_last;
+#ifdef _WIN32
+static u64 spurs_thread_cpu_ns(void)
+{
+    FILETIME c, e, k, u;
