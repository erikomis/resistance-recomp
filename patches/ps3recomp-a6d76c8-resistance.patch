+          " (%d rect, %d whole; %u,%u %ux%u)", g_rect.n_color, stub.n_clear_color,
+          g_rect.color_rect[0], g_rect.color_rect[1], g_rect.color_rect[2],
+          g_rect.color_rect[3]);
