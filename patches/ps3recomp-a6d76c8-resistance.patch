+/* ===========================================================================
+ * The hang report: one line per reserving context, and no wedge when the
+ * lock-line lock is held by somebody stuck
+ * ===========================================================================*/
+#include <unistd.h>
+static void report_into(char* buf, size_t cap)
+{
+    char path[] = "/tmp/test_spu_coh_report_XXXXXX";
+    int fd = mkstemp(path);
+    fflush(stderr);
+    int saved = dup(2);
+    dup2(fd, 2);
+    spu_coh_report();
+    fflush(stderr);
+    dup2(saved, 2);
+    close(saved);
+    lseek(fd, 0, SEEK_SET);
+    ssize_t n = read(fd, buf, cap - 1);
+    buf[n > 0 ? n : 0] = 0;
+    close(fd);
+    unlink(path);
+}
+
+static void test_hang_report(void)
+{
+    static char buf[8192];
+    TEST("hang report: a parked context is listed with its wait");
+    spu_reset(&g_spu_a, 3);
+    g_spu_a.pc = 0x0D64C;
+    g_spu_a.event_mask = 0x400u;
+    spu_getllar(&g_spu_a, LINE_A);
+    report_into(buf, sizeof buf);
+    CHECK(strstr(buf, "spu=3 ") != NULL);
+    CHECK(strstr(buf, "pc=0x0D64C") != NULL);
+    CHECK(strstr(buf, "mask=0x400") != NULL);
+    CHECK(strstr(buf, "resv[1 0x00040000]") != NULL);
+    CHECK(strstr(buf, "SPU contexts: ") != NULL);
+
+    TEST("hang report: gives up when the lock-line lock stays held");
+    spu_lockline_lock();
+    report_into(buf, sizeof buf);
+    spu_lockline_unlock();
+    CHECK(strstr(buf, "has been held") != NULL);
+    CHECK(strstr(buf, "spu=3 ") == NULL);
+}
+
 /* ===========================================================================
  * main: run all and report
  * ===========================================================================*/
@@ -430,6 +476,7 @@ int main(void)
     test_all_store_widths();
     test_store_conditional();
     test_block_stores();
+    test_hang_report();
     spu_coh_unregister(&g_spu_a);
     spu_coh_unregister(&g_spu_b);
     test_many_contexts();
