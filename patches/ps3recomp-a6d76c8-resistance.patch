+/* The same map with PS3RECOMP_ENG_ZETA16_GPU at its default (from the
+ * Resistance 2 port): a DEPTH16 texture over a Z16 zeta samples the
+ * backend's depth snapshot, as DEPTH24_D8 always did -- no readback, no
+ * Morton store, no texture decoded from guest memory, whatever the swizzle. */
+static void test_swizzled_zeta_read_gpu(void)
+{
+    printf("-- swizzled Z16 zeta read as DEPTH16 from the GPU snapshot\n");
+    engine_up();
+    rsx_draw_backend be = g_stub_backend;
+    be.depth_readback = ramp_depth_readback;
+    rsx_draw_engine_set_backend(&be);
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (1u << 5) | (2u << 8) | (2u << 16) | (2u << 24));
+    m(M_SURFACE_CLIP_H, 4u << 16);
+    m(M_SURFACE_CLIP_V, 4u << 16);
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_ZETA_PITCH, 64u);
+    m(M_COLOR_A_OFFSET, ZETA_OFFSET);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    u8* z = vm_base + GUEST_LOCAL_EA + ZETA_OFFSET;
+    memset(z, 0xEE, 64);
+    draw_triangle();
+    CHECK(stub.n_draw == 1, "the depth-only pass drew");
+
+    m(M_COLOR_MASK, 0x01010101u);
+    m(M_DEPTH_TEST, 0u);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    m(M_SURFACE_FORMAT, 8u | (1u << 5) | (1u << 8));
+    m(M_ZETA_OFFSET, ZETA_OFFSET + 0x10000u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x04, 1u | (2u << 4) | (0x92u << 8) | (1u << 16));   /* swizzled DEPTH16 */
+    const int uploads = stub.n_texture_create, snaps = stub.n_depth_snapshot;
+    draw_triangle();
+    CHECK(stub.n_draw == 2, "the receiver drew");
+    CHECK(stub.n_depth_readback == 0, "no depth readback (%d)", stub.n_depth_readback);
+    CHECK(z[0] == 0xEE && z[63] == 0xEE, "guest memory is left alone");
+    CHECK(stub.n_depth_snapshot == snaps + 1 && stub.n_texture_create == uploads,
+          "the unit samples the depth snapshot, no texture decoded (%d snapshots, %d uploads)",
+          stub.n_depth_snapshot - snaps, stub.n_texture_create - uploads);
+    engine_down();
+}
