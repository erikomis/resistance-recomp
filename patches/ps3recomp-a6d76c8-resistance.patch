+ * square, wide and tall power-of-two images lands where rsx_swizzle_offset
+ * puts it. B8 keeps the byte as is, so the source byte is the texel. */
+static void test_decode_swizzled_walk(void)
+{
+    static const u32 dims[][2] = { {1,1}, {2,1}, {1,2}, {4,4}, {8,2}, {2,8}, {16,4}, {32,32}, {64,8} };
+    static u8 src[64 * 64], dst[64 * 64];
+    for (u32 k = 0; k < sizeof dims / sizeof dims[0]; k++) {
+        const u32 w = dims[k][0], h = dims[k][1];
+        const u32 l2w = rsx_log2_ceil(w), l2h = rsx_log2_ceil(h);
+        for (u32 i = 0; i < w * h; i++) src[i] = (u8)(i * 7u + 3u);
+        rsx_tex_layout L;
+        rsx_texture_layout(FMT_B8, w, h, &L);
+        CHECK(L.swizzled || w * h == 1);
+        memset(dst, 0, sizeof dst);
+        rsx_texture_decode(dst, w, src, w, h, &L, 0);
+        int ok = 1;
+        for (u32 y = 0; y < h; y++)
+            for (u32 x = 0; x < w; x++)
+                if (dst[y * w + x] != src[rsx_swizzle_offset(x, y, l2w, l2h)]) ok = 0;
+        CHECK(ok);
