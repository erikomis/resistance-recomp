+/* Called by the kernel thread under si->lock. */
+static void spurs_stats_tick(struct SpursInst* si)
+{
+    u32 ea = si->ea;
+    s_st_passes++;
+    for (u32 w = 0; w < 16; w++) {
+        u32 r = vm_read8(ea + SPURS_WKL_READY1 + w);
+        s_st_ready[w][r > 8 ? 9 : r]++;
