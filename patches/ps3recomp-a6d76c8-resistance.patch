diff --git a/libs/video/tests/test_metal_shader_cache.m b/libs/video/tests/test_metal_shader_cache.m
new file mode 100644
index 0000000..ae78079
--- /dev/null
+++ b/libs/video/tests/test_metal_shader_cache.m
@@ -0,0 +1,77 @@
+/* PS3_SHADER_CACHE and PS3_SHADER_ASYNC on the engine's pipeline path.
+ *
+ * clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_shader_cache.m
+ *   libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp
+ *   libs/video/rsx_shader_spirv.cpp (and the glslang / spirv-cross libraries the
+ *   backend links) -framework Metal -framework Cocoa -framework QuartzCore
+ *
+ * Run as: test_metal_shader_cache <cache dir> <sync|async>. A first run into
+ * an empty directory writes one translation per stage; a second run reads
+ * them back; an async run builds the pipeline on the queue, its draw is
+ * skipped until the state is ready and then encodes. */
+#include "rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+u32 cellGcmResolveLocated(int local, u32 off) { (void)local; return off; }
+
+static const char* k_vs =
+    "struct VSIn { float4 a0 : ATTR0; };\n"
+    "struct VSOut { float4 pos : SV_Position; };\n"
+    "VSOut main(VSIn i) { VSOut o; o.pos = i.a0; return o; }\n";
+static const char* k_ps =
+    "float4 main() : SV_Target0 { return float4(1.0, 0.5, 0.25, 1.0); }\n";
+
+static u32 count_msl(const char* dir)
+{
+    u32 n = 0;
+    DIR* d = opendir(dir);
+    if (!d) return 0;
+    struct dirent* de;
+    while ((de = readdir(d))) if (strstr(de->d_name, ".msl")) n++;
+    closedir(d);
+    return n;
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        assert(argc == 3);
+        setenv("PS3_SHADER_CACHE", argv[1], 1);
+        const int async = !strcmp(argv[2], "async");
+        if (async) setenv("PS3_SHADER_ASYNC", "1", 1);
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { fprintf(stderr, "no Metal device\n"); return 2; }
+        s_queue = [s_dev newCommandQueue];
+        s_guest_shaders = rsx_hlsl_to_msl_available();
+        if (!s_guest_shaders) { fprintf(stderr, "no HLSL->MSL translator\n"); return 2; }
+
+        rsx_be_render_state rs; memset(&rs, 0, sizeof rs);
+        rs.color_mask = 0xFFFFFFFFu;
+        rsx_vertex_layout_plan layout; memset(&layout, 0, sizeof layout);
+        layout.count = 1; layout.stride = 16;
+        const u32 h = eng_pipeline_create(NULL, k_vs, k_ps, &rs, &layout, 16,
+                                          RSX_BE_FMT_R8G8B8A8, 1);
+        assert(h);
+        if (async) {
+            /* The handle exists at once; the state follows on the queue. */
+            dispatch_sync(s_sc_queue, ^{});
+        }
+        assert(__atomic_load_n(&s_eng_pipe[h - 1].building, __ATOMIC_ACQUIRE) == 0);
+        assert(s_eng_pipe[h - 1].pso != nil);
+
+        /* A pipeline still building is skipped, not an encoding failure. */
+        __atomic_store_n(&s_eng_pipe[h - 1].building, 1, __ATOMIC_RELEASE);
+        EngRecord r; memset(&r, 0, sizeof r); r.pipeline = h;
+        const u32 skipped = s_sc_async_skipped;
+        eng_encode_draw(nil, &r, nil);
+        assert(s_sc_async_skipped == skipped + 1 && !s_eng_encoding_failed);
+        __atomic_store_n(&s_eng_pipe[h - 1].building, 0, __ATOMIC_RELEASE);
+
+        printf("shader cache: %s %u hit(s) %u new, %u file(s) in %s\n", argv[2],
+               s_sc_hits, s_sc_miss, count_msl(s_sc_dir), s_sc_dir);
+        assert(s_sc_hits + s_sc_miss == 2);
+        assert(count_msl(s_sc_dir) == 2);
+        eng_shutdown(NULL);
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_stage_ring.m b/libs/video/tests/test_metal_stage_ring.m
new file mode 100644
index 0000000..016f9fa
--- /dev/null
+++ b/libs/video/tests/test_metal_stage_ring.m
@@ -0,0 +1,71 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_stage_ring.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_stage_ring
+ *
+ * The Metal engine's staging arena is a ring of shared MTLBuffers written in
+ * place: staged bytes are in the slot's buffer itself (nothing copied at
+ * commit), each submission takes the next slot, growth keeps what was
+ * already staged, a slot still marked in flight is waited for, and shutdown
+ * lets every slot go. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+        s_queue = [s_dev newCommandQueue];
+        assert(s_queue);
+
+        u8 a[64], b[64];
+        for (u32 i = 0; i < 64; i++) { a[i] = (u8)i; b[i] = (u8)(0xFF - i); }
+
+        /* The first data of a submission takes a slot and lands in its buffer. */
+        u32 off = 0;
+        assert(s_eng_slot < 0);
+        assert(eng_stage_copy(a, sizeof a, &off));
+        const int k0 = s_eng_slot;
+        assert(k0 >= 0 && s_eng_slot_buf[k0]);
+        assert((u8*)[s_eng_slot_buf[k0] contents] == s_eng_stage);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k0] contents] + off, a, sizeof a));
+
+        /* A commit hands that buffer over; the next submission uses the next slot. */
+        eng_encode_and_commit(nil);
+        assert(s_eng_slot < 0 && s_eng_stage_used == 0 && !s_eng_encoding_failed);
+        id<MTLBuffer> first = s_eng_slot_buf[k0];
+        assert(eng_stage_copy(b, sizeof b, &off));
+        const int k1 = s_eng_slot;
+        assert(k1 == (k0 + 1) % ENG_STAGE_SLOTS && s_eng_slot_buf[k1] != first);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k1] contents] + off, b, sizeof b));
+        assert(!memcmp([first contents], a, sizeof a));   /* the committed slot is untouched */
+
+        /* Growing a slot keeps what this submission staged before. */
+        const u32 b_off = off;
+        const u32 big = (u32)[s_eng_slot_buf[k1] length] + 4096u;
+        u32 big_off = 0;
+        assert(eng_stage_reserve(big, &big_off));
+        assert([s_eng_slot_buf[k1] length] >= big_off + big);
+        assert(!memcmp((u8*)[s_eng_slot_buf[k1] contents] + b_off, b, sizeof b));
+        eng_encode_and_commit(nil);
+
+        /* A slot still in flight is waited for, not overwritten. */
+        const int k2 = (int)(s_eng_slot_next % ENG_STAGE_SLOTS);
+        s_eng_slot_busy[k2] = 1;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_MSEC),
+                       dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+                           __atomic_store_n(&s_eng_slot_busy[k2], 0, __ATOMIC_RELEASE);
+                       });
+        const unsigned long waits = s_eng_slot_waits;
+        assert(eng_stage_copy(a, sizeof a, &off));
+        assert(s_eng_slot == k2 && s_eng_slot_waits == waits + 1 && !s_eng_slot_busy[k2]);
+        eng_encode_and_commit(nil);
+
+        eng_shutdown(NULL);
+        for (int k = 0; k < ENG_STAGE_SLOTS; k++) assert(!s_eng_slot_buf[k]);
+        assert(s_eng_slot < 0 && !s_eng_stage && !s_eng_stage_cap);
+        puts("Metal staging ring: staged in place, one slot per submission, in-flight slots waited for");
+    }
+}
diff --git a/libs/video/tests/test_metal_vbuf.m b/libs/video/tests/test_metal_vbuf.m
new file mode 100644
index 0000000..2650df6
--- /dev/null
+++ b/libs/video/tests/test_metal_vbuf.m
@@ -0,0 +1,64 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_vbuf.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_vbuf
+ *
+ * The Metal backend's persistent vertex buffers (the draw engine's vertex
+ * cache): a buffer holds the bytes it was made from, a draw records its
+ * handle, and a released handle keeps naming the same MTLBuffer until no
+ * recorded draw is left, so a draw recorded before the release never encodes
+ * another buffer's vertices. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table checked below. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+        u8 a[64], b[64];
+        for (u32 i = 0; i < 64; i++) { a[i] = (u8)i; b[i] = (u8)(0xFF - i); }
+
+        u32 ha = eng_vbuf_create(NULL, a, sizeof a);
+        assert(ha);
+        id<MTLBuffer> ba = s_vbuf[ha - 1];
+        assert(ba && [ba length] == sizeof a && !memcmp([ba contents], a, sizeof a));
+        assert(!eng_vbuf_create(NULL, NULL, 16) && !eng_vbuf_create(NULL, a, 0));
+
+        /* A draw from it records the handle, with its indices staged. */
+        const u32 idx[3] = { 2, 1, 0 };
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_TRIANGLES, ha, 4, 16, idx, 3);
+        assert(s_eng_rec_count == 1);
+        const EngRecord* r = &s_eng_rec[0];
+        assert(r->kind == ENG_REC_DRAW && r->vb_buf == ha && r->vertex_count == 4 &&
+               r->stride == 16 && r->index_count == 3);
+        assert(!memcmp(s_eng_stage + r->ib_off, idx, sizeof idx));
+        /* An ordinary draw still stages its vertices and names no buffer. */
+        eng_draw(NULL, RSX_TOPOLOGY_TRIANGLES, a, 4, 16, NULL, 0);
+        assert(s_eng_rec_count == 2 && s_eng_rec[1].vb_buf == 0);
+
+        /* Released while recorded: the slot is not recycled yet. */
+        eng_vbuf_release(NULL, ha);
+        eng_vbuf_release(NULL, ha);            /* a second release is harmless */
+        assert(s_vbuf[ha - 1] == ba);
+        u32 hb = eng_vbuf_create(NULL, b, sizeof b);
+        assert(hb && hb != ha && !memcmp([s_vbuf[hb - 1] contents], b, sizeof b));
+        /* A draw naming a retired handle is not recorded. */
+        eng_draw_vbuf(NULL, RSX_TOPOLOGY_TRIANGLES, ha, 4, 16, NULL, 0);
+        assert(s_eng_rec_count == 2);
+
+        /* Once everything recorded has been encoded, the slot is free. */
+        s_eng_rec_count = 0;
+        s_eng_stage_used = 0;
+        eng_collect_retired_objects();
+        assert(!s_vbuf[ha - 1] && s_vbuf[hb - 1]);
+        u32 hc = eng_vbuf_create(NULL, a, 32);
+        assert(hc == ha && [s_vbuf[hc - 1] length] == 32);
+
+        eng_shutdown(NULL);
+        assert(!s_vbuf_count && !s_vbuf_free_count && !s_vbuf[ha - 1] && !s_vbuf[hb - 1]);
+        assert(s_engine_backend.vbuf_create && s_engine_backend.vbuf_release &&
+               s_engine_backend.draw_vbuf);
+        puts("Metal persistent vertex buffers keep their bytes until no draw names them");
+    }
+}
diff --git a/libs/video/tests/test_metal_vstreams.m b/libs/video/tests/test_metal_vstreams.m
new file mode 100644
index 0000000..5dc3132
--- /dev/null
+++ b/libs/video/tests/test_metal_vstreams.m
@@ -0,0 +1,145 @@
+/* clang -fobjc-arc -I include -I libs/video
+ * libs/video/tests/test_metal_vstreams.m libs/video/rsx_texture_layout.c -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -o /tmp/test_metal_vstreams
+ *
+ * The Metal backend's split vertex streams (rsx_draw_backend.draw_vbufs, the
+ * draw engine's per-stream vertex cache):
+ *   - the vertex descriptor for a stream map puts each stream in its own
+ *     buffer, its slots packed in ascending order, and refuses a map that
+ *     names a stream out of range or leaves one empty;
+ *   - a split draw records each stream as a persistent buffer or as staged
+ *     bytes, and a draw naming a retired buffer is not recorded;
+ *   - on the GPU, a pipeline made from that descriptor and a record encoded
+ *     by eng_encode_draw read every attribute from the right stream. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+/* The present path is linked in through the backend table checked below. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static const char* kMSL =
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"struct VIn { float4 a0 [[attribute(0)]]; float4 a1 [[attribute(1)]]; float4 a2 [[attribute(2)]]; };\n"
+"struct VOut { float4 pos [[position]]; float4 c; float ps [[point_size]]; };\n"
+"vertex VOut vmain(VIn in [[stage_in]], uint vid [[vertex_id]]) {\n"
+"    VOut o; o.pos = float4(-1.0 + (2.0 * vid + 1.0) / 4.0, 0.0, 0.0, 1.0);\n"
+"    o.c = float4(in.a0.x, in.a1.y, in.a2.z, in.a0.w + in.a1.w + in.a2.w); o.ps = 1.0; return o; }\n"
+"fragment float4 fmain(VOut in [[stage_in]]) { return in.c; }\n";
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice();
+        assert(s_dev);
+
+        /* Three slots; slot 1 in stream 1, slots 0 and 2 in stream 0. */
+        rsx_vertex_layout_plan layout;
+        memset(&layout, 0, sizeof layout);
+        layout.mask = 0x7u; layout.count = 3; layout.stride = 48;
+        for (u8 a = 0; a < 3; a++) layout.attrs[a] = a;
+        MTLVertexDescriptor* one = eng_vertex_descriptor(&layout, layout.stride);
+        assert(one && one.attributes[2].offset == 32 && one.attributes[2].bufferIndex == MTL_VB_INDEX &&
+               one.layouts[MTL_VB_INDEX].stride == 48);
+        layout.stream_map = 1ull << 4;
+        layout.n_streams = 2;
+        MTLVertexDescriptor* vd = eng_vertex_descriptor(&layout, layout.stride);
+        assert(vd);
+        assert(vd.attributes[0].bufferIndex == MTL_VB_INDEX && vd.attributes[0].offset == 0);
+        assert(vd.attributes[1].bufferIndex == MTL_VB_INDEX - 1 && vd.attributes[1].offset == 0);
+        assert(vd.attributes[2].bufferIndex == MTL_VB_INDEX && vd.attributes[2].offset == 16);
+        assert(vd.layouts[MTL_VB_INDEX].stride == 32 && vd.layouts[MTL_VB_INDEX - 1].stride == 16);
+        rsx_vertex_layout_plan bad = layout;
+        bad.stream_map = 2ull << 4;                  /* stream 2 of 2 */
+        assert(!eng_vertex_descriptor(&bad, bad.stride));
+        bad.stream_map = 0x111ull;                   /* stream 0 empty */
+        assert(!eng_vertex_descriptor(&bad, bad.stride));
+
+        /* Stream 0 resident, stream 1 staged. Vertex v: a0 = (v, 0, 0, 1),
+         * a2 = (0, 0, 10 + v, 2), a1 = (0, 100 + v, 0, 4). */
+        enum { N = 4 };
+        float s0[N][8], s1[N][4];
+        memset(s0, 0, sizeof s0); memset(s1, 0, sizeof s1);
+        for (int v = 0; v < N; v++) {
+            s0[v][0] = (float)v; s0[v][3] = 1.0f;
+            s0[v][6] = 10.0f + v; s0[v][7] = 2.0f;
+            s1[v][1] = 100.0f + v; s1[v][3] = 4.0f;
+        }
+        const u32 h0 = eng_vbuf_create(NULL, s0, sizeof s0);
+        assert(h0);
+        s_eng_pending.vp[2] = 4.0f; s_eng_pending.vp[3] = 1.0f;
+        s_eng_pending.pipeline = 1;
+        for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) s_eng_pending.samp[u] = -1;
+        for (u32 u = 0; u < RSX_BE_MAX_VERTEX_TEXTURES; u++) s_eng_pending.vsamp[u] = -1;
+        const rsx_be_vstream st[2] = { { h0, NULL, 32 }, { 0, s1, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, st, 2, N, NULL, 0);
+        assert(s_eng_rec_count == 1);
+        const EngRecord* r = &s_eng_rec[0];
+        assert(r->kind == ENG_REC_DRAW && r->n_vb == 2 && r->vb_buf == h0 && r->vb2_buf[0] == 0 &&
+               r->vertex_count == N && r->stride == 32 && r->index_count == 0);
+        assert(!memcmp(s_eng_stage + r->vb2_off[0], s1, sizeof s1));
+        /* Bad streams are not recorded: a zero stride, missing data, a dead buffer. */
+        const rsx_be_vstream z[2] = { { h0, NULL, 32 }, { 0, s1, 0 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, z, 2, N, NULL, 0);
+        const rsx_be_vstream nd[2] = { { h0, NULL, 32 }, { 0, NULL, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, nd, 2, N, NULL, 0);
+        const rsx_be_vstream dead[2] = { { 999, NULL, 32 }, { 0, s1, 16 } };
+        eng_draw_vbufs(NULL, RSX_TOPOLOGY_POINTS, dead, 2, N, NULL, 0);
+        assert(s_eng_rec_count == 1);
+
+        /* On the GPU. */
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:@(kMSL) options:nil error:&err];
+        assert(lib);
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vmain"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fmain"];
+        pd.vertexDescriptor = vd;
+        pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA32Float;
+        pd.inputPrimitiveTopology = MTLPrimitiveTopologyClassPoint;
+        id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        if (!pso) { fprintf(stderr, "%s\n", [[err localizedDescription] UTF8String]); return 1; }
+        s_eng_pipe[0].pso = pso;
+        s_eng_pipe[0].ds = [s_dev newDepthStencilStateWithDescriptor:[MTLDepthStencilDescriptor new]];
+        s_eng_pipe[0].cull = MTLCullModeNone;
+        s_eng_pipe[0].winding = MTLWindingCounterClockwise;
+        s_eng_pipe_count = 1;
+
+        MTLTextureDescriptor* td = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:N height:1 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModeShared;
+        id<MTLTexture> rt = [s_dev newTextureWithDescriptor:td];
+        id<MTLBuffer> stage = [s_dev newBufferWithBytes:s_eng_stage length:s_eng_stage_used
+                                                options:MTLResourceStorageModeShared];
+        id<MTLCommandQueue> q = [s_dev newCommandQueue];
+        id<MTLCommandBuffer> cb = [q commandBuffer];
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture = rt;
+        rp.colorAttachments[0].loadAction = MTLLoadActionClear;
+        rp.colorAttachments[0].clearColor = MTLClearColorMake(-1, -1, -1, -1);
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:rp];
+        s_eng_encoding_failed = 0;
+        eng_encode_draw(enc, r, stage);
+        [enc endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(!s_eng_encoding_failed && cb.status == MTLCommandBufferStatusCompleted);
+        float px[N][4];
+        [rt getBytes:px bytesPerRow:sizeof px fromRegion:MTLRegionMake2D(0, 0, N, 1) mipmapLevel:0];
+        for (int v = 0; v < N; v++) {
+            if (px[v][0] != (float)v || px[v][1] != 100.0f + v || px[v][2] != 10.0f + v ||
+                px[v][3] != 7.0f) {
+                fprintf(stderr, "vertex %d: (%g %g %g %g)\n", v, (double)px[v][0], (double)px[v][1],
+                        (double)px[v][2], (double)px[v][3]);
+                return 1;
+            }
+        }
+
+        s_eng_rec_count = 0;
+        s_eng_stage_used = 0;
+        eng_shutdown(NULL);
+        assert(s_engine_backend.draw_vbufs == eng_draw_vbufs);
+        puts("Metal split vertex streams: each attribute read from its own stream");
+    }
+}
diff --git a/libs/video/tests/test_program_memo.c b/libs/video/tests/test_program_memo.c
new file mode 100644
index 0000000..524a7d8
--- /dev/null
+++ b/libs/video/tests/test_program_memo.c
@@ -0,0 +1,127 @@
+/*
+ * ps3recomp - the draw engine's program memo and pipeline index
+ *
+ * Per draw the engine reuses what it derived from a program's bytes when the
+ * bytes compare equal, and finds the pipeline by key through an index instead
+ * of scanning the table. Checked through the engine against the stub backend
+ * of test_rsx_draw_engine.c:
+ *   - a fragment or vertex program rewritten in place (same address, other
+ *     bytes) gets its own pipeline, and going back to the first bytes finds
+ *     the first pipeline again;
+ *   - more programs than the memo holds, cycled, each keep their own pipeline
+ *     and none is built twice;
+ *   - hundreds of pipelines are each found again by key.
+ *
+ * clang -std=gnu17 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video
+ *   -o /tmp/test_program_memo libs/video/tests/test_program_memo.c
+ *   libs/video/rsx_draw_engine.c libs/video/rsx_dispatch.c
+ *   libs/video/rsx_vertex_compact.c libs/video/rsx_texture_layout.c
+ *   libs/video/rsx_vp_decompiler.c libs/video/rsx_fp_decompiler.c
+ */
+#define main old_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "rsx_test_programs.h"
+
+#define FP_AT(i) (TEX_OFFSET + 0x1000u + (u32)(i) * 0x40u)
+
+static void load_vp(u32 swz)
+{
+    u8 vp[16];
+    rsx_test_vp_mov_out(vp, 0, swz, 0, 1);
+    m(0x1E9C, 0);
+    for (u32 i = 0; i < 4; i++) { u32 w; memcpy(&w, vp + i * 4, 4); m(0xB80 + i * 4, w); }
+    m(0x1EA0, 0);
+}
+
+static u32 fp_swz(u32 i)   /* a distinct swizzle for each i < 256 */
+{
+    return RSX_TEST_FP_SWZ(i & 3u, (i >> 2) & 3u, (i >> 4) & 3u, (i >> 6) & 3u);
+}
+
+int main(void)
+{
+    vm_base = calloc(1, GUEST_BYTES);
+    if (!vm_base) return 2;
+    ppu_vm_size = GUEST_BYTES;
+    for (u32 i = 0; i < 12; i++) { u8* p = vm_base + VTX_OFFSET + i * 4; p[0] = 0x3F; p[1] = 0x80; }
+    engine_up();
+    load_vp(RSX_TEST_VP_SWZ_IDENT);
+
+    /* 1. In place. */
+    rsx_test_fp_mov_r0_col0(vm_base + FP_AT(0), RSX_TEST_FP_SWZ_IDENT);
+    m(0x8E4, FP_AT(0) | 2u);
+    draw_triangle();
+    const u32 p_a = stub.bound_pipeline;
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 1 && stub.bound_pipeline == p_a,
+          "the same program twice: one pipeline (%d)", stub.n_pipeline_create);
+    rsx_test_fp_mov_r0_col0(vm_base + FP_AT(0), RSX_TEST_FP_SWZ(3, 2, 1, 0));
+    draw_triangle();
+    const u32 p_b = stub.bound_pipeline;
+    CHECK(stub.n_pipeline_create == 2 && p_b != p_a,
+          "a fragment program rewritten at the same address gets its own pipeline (%d)",
+          stub.n_pipeline_create);
+    rsx_test_fp_mov_r0_col0(vm_base + FP_AT(0), RSX_TEST_FP_SWZ_IDENT);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 2 && stub.bound_pipeline == p_a,
+          "back to the first bytes: the first pipeline, nothing built");
+    load_vp(RSX_TEST_VP_SWZ(1, 0, 2, 3));
+    draw_triangle();
+    const u32 p_c = stub.bound_pipeline;
+    CHECK(stub.n_pipeline_create == 3 && p_c != p_a,
+          "a vertex program rewritten in place gets its own pipeline (%d)", stub.n_pipeline_create);
+    load_vp(RSX_TEST_VP_SWZ_IDENT);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 3 && stub.bound_pipeline == p_a,
+          "and its first bytes the first pipeline again");
+
+    /* 2. More programs than the memo holds, cycled. */
+    enum { N = 300 };
+    static u32 handle[N];
+    const int before = stub.n_pipeline_create;
+    for (u32 i = 0; i < N; i++) {
+        rsx_test_fp_mov_r0_col0(vm_base + FP_AT(i + 1), fp_swz(i + 1));
+        m(0x8E4, FP_AT(i + 1) | 2u);
+        draw_triangle();
+        handle[i] = stub.bound_pipeline;
+    }
+    /* Swizzles repeat every 256: programs with the same bytes at different
+     * addresses share a pipeline. Swizzle 228 (0,1,2,3) is part 1's identity and
+     * swizzle 27 (3,2,1,0) part 1's rewrite, so 254 are new. */
+    int pairs_ok = 1;
+    for (u32 i = 0; i < N; i++)
+        for (u32 j = i + 1; j < N; j++)
+            if ((handle[i] == handle[j]) != (((i + 1) & 0xFFu) == ((j + 1) & 0xFFu))) pairs_ok = 0;
+    for (u32 i = 0; i < N; i++) {
+        if ((((i + 1) & 0xFFu) == 228) != (handle[i] == p_a)) pairs_ok = 0;
+        if ((((i + 1) & 0xFFu) == 27) != (handle[i] == p_b)) pairs_ok = 0;
+    }
+    CHECK(stub.n_pipeline_create - before == 254 && pairs_ok,
+          "%d programs: %d new pipelines, one per distinct program (want 254)",
+          N, stub.n_pipeline_create - before);
+    const int built = stub.n_pipeline_create;
+    int same = 1;
+    for (int pass = 0; pass < 2; pass++)
+        for (u32 i = 0; i < N; i++) {
+            m(0x8E4, FP_AT(i + 1) | 2u);
+            draw_triangle();
+            if (stub.bound_pipeline != handle[i]) same = 0;
+        }
+    CHECK(same && stub.n_pipeline_create == built,
+          "cycled twice more: every draw finds its own pipeline, none built again (%d new)",
+          stub.n_pipeline_create - built);
+
+    engine_down();
+    /* After a restart the memo and the index start over too. */
+    engine_up();
+    load_vp(RSX_TEST_VP_SWZ_IDENT);
+    m(0x8E4, FP_AT(0) | 2u);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 1 && stub.bound_pipeline != 0,
+          "after a restart the pipeline is built again (%d)", stub.n_pipeline_create);
+    engine_down();
+    free(vm_base);
+    printf("program memo failures: %d\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index aee6109..1f4b994 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -71,6 +71,7 @@ typedef struct {
     int n_texture_create, n_texture_release, n_texture_upload;
     int n_color_create, n_color_release, n_color_seeded;
     int n_depth_create, n_depth_snapshot;
+    u32 snapshot_w, snapshot_h;        /* the last depth snapshot request */
     int n_pipeline_create;
     rsx_be_render_state pipeline_rs;   /* the last pipeline's render state */
     int n_draw, n_clear_color, n_clear_ds, n_present;
@@ -163,7 +164,7 @@ static u32 stub_depth_create(void* u, u32 w, u32 h)
 { (void)u; (void)w; (void)h; stub.n_depth_create++; return stub_handle(); }
 
 static u32 stub_depth_snapshot(void* u, u32 d, u32 w, u32 h)
-{ (void)u; (void)d; (void)w; (void)h; stub.n_depth_snapshot++; return stub_handle(); }
+{ (void)u; (void)d; stub.snapshot_w = w; stub.snapshot_h = h; stub.n_depth_snapshot++; return stub_handle(); }
 
 static u32 stub_pipeline_create(void* u, const char* vs, const char* ps,
                                 const rsx_be_render_state* rs,
@@ -1431,6 +1432,51 @@ static void test_depth_read_as_color(void)
     engine_down();
 }
 
+/* A depth write after a reader took its snapshot retires it: a later reader
+ * in the same frame resolves the depth again instead of the frozen copy. */
+static void test_depth_snapshot_retired_by_write(void)
+{
+    printf("-- depth write retires the snapshot\n");
+    engine_up();
+    const u32 zeta2 = 0x00200000u;
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));
+    m(M_ZETA_PITCH, 256u * 4u);
+    m(M_COLOR_A_OFFSET, 0x90000u);
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x0C, 0u);
+    m(M_CLEAR_BUFFERS, 0x01u);
+    m(M_COLOR_MASK, 0u);
+    m(M_DEPTH_TEST, 1u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    /* Read once. */
+    m(M_ZETA_OFFSET, zeta2);
+    m(M_DEPTH_WRITE, 0u);
+    bind_texture_unit(RSX_LOCATION_LOCAL, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x04, 1u | (2u << 4) | ((0x90u | 0x20u) << 8) | (1u << 16));
+    draw_triangle();
+    const int snaps = stub.n_depth_snapshot;
+    const u32 first = stub.bound_tex[0];
+    /* Same frame, no clear: more depth is written, then read again. */
+    m(M_ZETA_OFFSET, ZETA_OFFSET);
+    m(M_TEX_UNIT + 0x0C, 0u);
+    m(M_DEPTH_WRITE, 1u);
+    draw_triangle();
+    m(M_ZETA_OFFSET, zeta2);
+    m(M_DEPTH_WRITE, 0u);
+    m(M_TEX_UNIT + 0x0C, 0x80000000u);
+    draw_triangle();
+    CHECK(stub.n_depth_snapshot == snaps + 1 && stub.bound_tex[0] != first,
+          "the reader after the write resolves the depth again (%d snapshots)",
+          stub.n_depth_snapshot - snaps);
+    /* No write since: the snapshot is reused. */
+    draw_triangle();
+    CHECK(stub.n_depth_snapshot == snaps + 1,
+          "an unchanged depth target is not resolved again");
+    engine_down();
+}
+
 static void test_color_read_as_float(void)
 {
     printf("-- colour target read as X32_FLOAT\n");
@@ -1541,6 +1587,33 @@ static void test_immediate_compositor(void)
     CHECK(stub.n_draw == 5 && stub.captured_vertices[1][3] == 0 &&
           stub.captured_vertices[1][35] == 0,
           "explicit all-zero DATA4F preserves position W and attribute alpha");
+    /* Resistance's movie player: a QUADS group whose positions are DATA2S on
+     * ATTR0 (0x1900, x in the low half), each vertex's ATTR1 written first and
+     * the colour/UV set once as constants. The single ATTR0 word completes the
+     * position, as on hardware; only DATA3F/DATA4F positions used to emit, and
