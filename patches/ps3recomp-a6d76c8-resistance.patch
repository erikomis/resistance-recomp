diff --git a/libs/network/tests/test_netstart_offline.c b/libs/network/tests/test_netstart_offline.c
new file mode 100644
index 00000000..8e3902b8
--- /dev/null
+++ b/libs/network/tests/test_netstart_offline.c
@@ -0,0 +1,61 @@
+/* The NetStart dialog's verdict follows the network state: offline (the
+ * default) UnloadAsync reports CELL_NET_CTL_ERROR_DIALOG_CANCELED, big-endian
+ * in the guest's result struct, so a title takes its "could not connect" path
+ * instead of going on to PSN requests that never complete; with
+ * PS3_NET_ONLINE it reports 0, connected.
+ *
+ *   cc -std=gnu17 -I include -I libs/system -o /tmp/test_netstart_offline \
+ *      libs/network/tests/test_netstart_offline.c && /tmp/test_netstart_offline \
+ *      && PS3_NET_ONLINE=1 /tmp/test_netstart_offline
+ */
+#include "../cellNetCtl.c"
+#include <assert.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+const char* np_psnr_identity(void) { return NULL; }
+
+static unsigned s_events;
+void cellSysutilQueueEvent(int slot, uint32_t status, uint32_t param)
+{
+    (void)slot; (void)param;
+    if (status == CELL_SYSUTIL_NET_CTL_NETSTART_UNLOADED) s_events++;
+}
+
+#define RESULT 0x100u
+
+static s32 run_dialog(void)
+{
+    vm_write32(RESULT, 8);              /* size */
+    vm_write32(RESULT + 4, 0x12345678); /* result: overwritten */
+    assert(cellNetCtlNetStartDialogLoadAsync(NULL) == CELL_OK);
+    assert(cellNetCtlNetStartDialogUnloadAsync(
+               (CellNetCtlNetStartDialogResult*)(uintptr_t)RESULT) == CELL_OK);
+    assert(vm_read32(RESULT) == 8);
+    return (s32)vm_read32(RESULT + 4);
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 0x1000); assert(vm_base);
+
+    if (getenv("PS3_NET_ONLINE")) {
+        assert(run_dialog() == 0);                          /* connected */
+    } else {
+        assert(run_dialog() == (s32)CELL_NET_CTL_ERROR_DIALOG_CANCELED);
+        assert(vm_base[RESULT + 4] == 0x80 && vm_base[RESULT + 7] == 0x90);   /* big-endian */
+    }
+    assert(s_events == CELL_SYSUTIL_MAX_CALLBACKS);   /* UNLOADED reaches every slot */
+
+    free(vm_base);
+    puts("test_netstart_offline: all passed");
+    return 0;
+}
diff --git a/libs/network/tests/test_np_commerce1.c b/libs/network/tests/test_np_commerce1.c
new file mode 100644
index 00000000..dae59f73
--- /dev/null
+++ b/libs/network/tests/test_np_commerce1.c
@@ -0,0 +1,79 @@
+/* NP Commerce, first version (the in-game PlayStation Store), as Resistance's
+ * online menus call it: a context is made (version 1 only), a product-category
+ * request gets a request ID and fails through the handler with REQUEST_ERROR /
+ * GPC_SEND_REQUEST (the store is gone), and the getters find nothing.
+ *
+ *   cc -std=gnu17 -I include -o /tmp/test_np_commerce1 \
+ *      libs/network/tests/test_np_commerce1.c && /tmp/test_np_commerce1
+ */
+#include "../sceNp.c"
+#include <assert.h>
+#include <stdlib.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+int np_psnr_enabled(void) { return 0; }
+const char* np_psnr_online_id(void) { return "Player_01"; }
+void edat_add_klicensee(const uint8_t klic[16]) { (void)klic; }
+
+static int s_calls;
+static u32 s_opd;
+static u64 s_args[8];
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8])
+{
+    s_opd = opd; memcpy(s_args, args, sizeof s_args); s_calls++;
+    return 0;
+}
+
+#define NPID    0x1000u
+#define HANDLER 0x2000u
+#define ARG     0x2100u
+#define CTX     0x3000u
+#define REQ     0x3100u
+#define NUM     0x3200u
+
+int main(void)
+{
+    vm_base = calloc(1, 0x10000); assert(vm_base);
+    assert(sceNpCommerceCreateCtx(1, (const SceNpId*)(uintptr_t)NPID, (void*)(uintptr_t)HANDLER,
+                                  (void*)(uintptr_t)ARG, (u32*)(uintptr_t)CTX) == (s32)SCE_NP_COMMERCE_ERROR_NOT_INITIALIZED);
+    assert(sceNpInit(0, NULL) == CELL_OK);
+    assert(sceNpCommerceCreateCtx(2, (const SceNpId*)(uintptr_t)NPID, (void*)(uintptr_t)HANDLER,
+                                  (void*)(uintptr_t)ARG, (u32*)(uintptr_t)CTX) == (s32)SCE_NP_COMMERCE_ERROR_UNSUPPORTED_VERSION);
+    assert(sceNpCommerceCreateCtx(1, (const SceNpId*)(uintptr_t)NPID, (void*)(uintptr_t)HANDLER,
+                                  (void*)(uintptr_t)ARG, NULL) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+    assert(sceNpCommerceCreateCtx(1, (const SceNpId*)(uintptr_t)NPID, (void*)(uintptr_t)HANDLER,
+                                  (void*)(uintptr_t)ARG, (u32*)(uintptr_t)CTX) == CELL_OK);
+    const u32 ctx = vm_read32(CTX);
+    assert(ctx != 0);
+
+    /* A category request: a request ID, then REQUEST_ERROR through the handler. */
+    assert(sceNpCommerceGetProductCategoryStart(ctx + 1, NULL, 0, (u32*)(uintptr_t)REQ) == (s32)SCE_NP_COMMERCE_ERROR_CTX_NOT_FOUND);
+    assert(s_calls == 0);
+    assert(sceNpCommerceGetProductCategoryStart(ctx, NULL, 0, (u32*)(uintptr_t)REQ) == CELL_OK);
+    const u32 req = vm_read32(REQ);
+    assert(req != 0 && s_calls == 1 && s_opd == HANDLER);
+    assert(s_args[0] == ctx && s_args[1] == req && s_args[2] == SCE_NP_COMMERCE_EVENT_REQUEST_ERROR);
+    assert((u32)s_args[3] == SCE_NP_COMMERCE_ERROR_GPC_SEND_REQUEST && s_args[4] == ARG);
+    assert(sceNpCommerceGetProductCategoryResult(req, NULL, 0, (u32*)(uintptr_t)NUM) == (s32)SCE_NP_COMMERCE_ERROR_CATEGORY_INFO_NOT_FOUND);
+    assert(vm_read32(NUM) == 0);
+    assert(sceNpCommerceGetProductCategoryFinish(req) == CELL_OK);
+    assert(sceNpCommerceGetProductCategoryFinish(req + 5) == (s32)SCE_NP_COMMERCE_ERROR_REQ_NOT_FOUND);
+
+    /* An empty store. */
+    vm_write32(NUM, 7);
+    assert(sceNpCommerceGetNumOfChildProductSku(NULL, (u32*)(uintptr_t)NUM) == CELL_OK && vm_read32(NUM) == 0);
+    assert(sceNpCommerceDoCheckoutStartAsync(ctx, NULL, 0, 0, (u32*)(uintptr_t)REQ) < 0);
+    assert(sceNpCommerceDestroyCtx(ctx) == CELL_OK);
+    assert(sceNpCommerceDestroyCtx(ctx) == (s32)SCE_NP_COMMERCE_ERROR_CTX_NOT_FOUND);
+    printf("test_np_commerce1: all passed\n");
+    return 0;
+}
