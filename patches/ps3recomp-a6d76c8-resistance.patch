diff --git a/libs/video/tests/test_vp_branch_engine.c b/libs/video/tests/test_vp_branch_engine.c
new file mode 100644
index 00000000..c6ddbb9b
--- /dev/null
+++ b/libs/video/tests/test_vp_branch_engine.c
@@ -0,0 +1,143 @@
+/*
+ * ps3recomp - the draw engine's branching vertex programs
+ *
+ * A vertex program's branch targets are absolute transform-program slots and
+ * BRB/CLB test SET_TRANSFORM_BRANCH_BITS (0x1FF8). The engine bakes both
+ * into the generated program, so:
+ *   - a program loaded at slot S has its targets made relative to S (a
+ *     program at slot 8 that branches to slot 11 goes to its own 4th
+ *     instruction, not past its end);
+ *   - the same bytes at another start slot are another pipeline;
+ *   - for a program with BRB/CLB the branch bits are pipeline identity, and
+ *     each value takes or skips the branch;
+ *   - a program without them keeps its pipeline when the bits change.
+ * Checked through the engine against the stub backend of
+ * test_rsx_draw_engine.c, with the generated vertex program captured.
+ *
+ * clang -std=gnu17 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video
+ *   -o /tmp/test_vp_branch_engine libs/video/tests/test_vp_branch_engine.c
+ *   libs/video/rsx_draw_engine.c libs/video/rsx_dispatch.c
+ *   libs/video/rsx_vertex_compact.c libs/video/rsx_texture_layout.c
+ *   libs/video/rsx_vp_decompiler.c libs/video/rsx_fp_decompiler.c
+ */
+#define main old_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "rsx_test_programs.h"
+
+static char g_vs[262144];
+
+static u32 capture_pipeline(void* u, const char* vs, const char* ps,
+                            const rsx_be_render_state* rs,
+                            const rsx_vertex_layout_plan* layout,
+                            u32 stride, rsx_be_format rt, u32 rt_count)
+{
+    if (vs) snprintf(g_vs, sizeof g_vs, "%s", vs);
+    return stub_pipeline_create(u, vs, ps, rs, layout, stride, rt, rt_count);
+}
+
+/* Flow instruction `sca_op` (0x09 BRI, 0x11 BRB, 0x12 CLB) to the absolute
+ * slot `target`; a boolean branch tests branch bit `bit` against `if_set`. */
+static void vp_branch(u8* p, u32 sca_op, u32 target, u32 bit, u32 if_set)
+{
+    const u32 d0 = (0x3Fu << 15) | (7u << 10) | (((target >> 9) & 1u) << 23);
+    const u32 d1 = sca_op << 27;
+    const u32 d2 = (target >> 3) & 0x3Fu;
+    const u32 d3 = (0x3Fu << 7) | (bit << 23) | (if_set << 28) | ((target & 7u) << 29);
+    rsx_test_put_le32(p + 0, d0); rsx_test_put_le32(p + 4, d1);
+    rsx_test_put_le32(p + 8, d2); rsx_test_put_le32(p + 12, d3);
+}
+
+/* Upload `n` instructions at slot `slot` and start the program there. */
+static void load_vp_at(u32 slot, const u8* prog, u32 n)
+{
+    m(0x1E9C, slot);
+    for (u32 k = 0; k < n; k++)
+        for (u32 i = 0; i < 4; i++) {
+            u32 w; memcpy(&w, prog + k * 16 + i * 4, 4);
+            m(0xB80 + ((k * 4 + i) & 31u) * 4, w);
+        }
+    m(0x1EA0, slot);
+}
+
+/*   S+0 MOV o0, v0
+ *   S+1 BRB !b3 -> S+3     (taken while bit 3 is clear)
+ *   S+2 MOV o1, v1         (skipped when taken)
+ *   S+3 MOV o2, v2  END */
+static void make_brb_prog(u8* prog, u32 start)
+{
+    rsx_test_vp_mov_out(prog + 0 * 16, 0, RSX_TEST_VP_SWZ_IDENT, 0, 0);
+    vp_branch(prog + 1 * 16, 0x11, start + 3, 3, 0);
+    rsx_test_vp_mov_out(prog + 2 * 16, 1, RSX_TEST_VP_SWZ_IDENT, 1, 0);
+    rsx_test_vp_mov_out(prog + 3 * 16, 2, RSX_TEST_VP_SWZ_IDENT, 2, 1);
+}
+
+int main(void)
+{
+    vm_base = calloc(1, GUEST_BYTES);
+    if (!vm_base) return 2;
+    ppu_vm_size = GUEST_BYTES;
+    for (u32 i = 0; i < 12; i++) { u8* p = vm_base + VTX_OFFSET + i * 4; p[0] = 0x3F; p[1] = 0x80; }
+    static rsx_draw_backend be;
+    be = g_stub_backend;
+    be.pipeline_create = capture_pipeline;
+    engine_up_with(&be);
+    rsx_test_fp_mov_r0_col0(vm_base + TEX_OFFSET + 0x1000u, RSX_TEST_FP_SWZ_IDENT);
+    m(0x8E4, (TEX_OFFSET + 0x1000u) | 2u);
+
+    u8 prog[4 * 16];
+    /* 1. At slot 8, bit 3 clear: the branch is taken, to the program's own
+     * slot 3 (absolute 11). */
+    make_brb_prog(prog, 8);
+    m(0x1FF8, 0);
+    load_vp_at(8, prog, 4);
+    draw_triangle();
+    const u32 p_taken = stub.bound_pipeline;
+    CHECK(stub.n_pipeline_create == 1 && p_taken != 0, "the BRB program builds a pipeline (%d)",
+          stub.n_pipeline_create);
+    CHECK(strstr(g_vs, "_pc = 3;") && !strstr(g_vs, "_pc = 11;") && !strstr(g_vs, "not modelled"),
+          "taken at slot 8: the target is the program's own slot 3");
+
+    /* 2. Bit 3 set: not taken, a new pipeline that runs slot 2. */
+    m(0x1FF8, 1u << 3);
+    draw_triangle();
+    const u32 p_skip = stub.bound_pipeline;
+    CHECK(stub.n_pipeline_create == 2 && p_skip != p_taken,
+          "other branch bits: another pipeline (%d)", stub.n_pipeline_create);
+    CHECK(strstr(g_vs, "_pc = 2;") != NULL, "not taken: falls through to slot 2");
+
+    /* 3. Back to the first bits: the first pipeline, nothing built. */
+    m(0x1FF8, 0);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 2 && stub.bound_pipeline == p_taken,
+          "the first bits again find the first pipeline (%d)", stub.n_pipeline_create);
+
+    /* 4. The same bytes at slot 0 branch to absolute slot 11, past the end:
+     * another program, so another pipeline. */
+    load_vp_at(0, prog, 4);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == 3 && stub.bound_pipeline != p_taken,
+          "the same bytes at slot 0 are another pipeline (%d)", stub.n_pipeline_create);
+
+    /* 5. A program without BRB/CLB keeps its pipeline across bit changes. */
+    u8 plain[16];
+    rsx_test_vp_mov_out(plain, 0, RSX_TEST_VP_SWZ_IDENT, 0, 1);
+    load_vp_at(0, plain, 1);
+    draw_triangle();
+    const int built = stub.n_pipeline_create;
+    const u32 p_plain = stub.bound_pipeline;
+    m(0x1FF8, 0x5u);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == built && stub.bound_pipeline == p_plain,
+          "no BRB/CLB: the branch bits are not identity (%d new)", stub.n_pipeline_create - built);
+    /* ...and not its start slot either. */
+    load_vp_at(16, plain, 1);
+    draw_triangle();
+    CHECK(stub.n_pipeline_create == built && stub.bound_pipeline == p_plain,
+          "no flow: the start slot is not identity (%d new)", stub.n_pipeline_create - built);
+
+    engine_down();
+    free(vm_base);
+    printf("vp branch engine failures: %d\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/libs/video/tests/test_zpass_engine.c b/libs/video/tests/test_zpass_engine.c
new file mode 100644
index 00000000..7dbc8f16
--- /dev/null
+++ b/libs/video/tests/test_zpass_engine.c
@@ -0,0 +1,151 @@
+/* The draw engine's ZPASS bookkeeping and polygon offset, against the stub
+ * backend of test_rsx_draw_engine.c; no GPU, no title data.
+ *
+ *   - SET_POLY_OFFSET_FILL_ENABLE with SCALE_FACTOR/BIAS reaches the backend
+ *     as set_depth_bias(slope, units, depth bits) before the draw, Z16 or
+ *     Z24 by the surface's zeta format, and 0/0 once it is disabled;
+ *   - while SET_ZPASS_PIXEL_COUNT_ENABLE is on every draw is given the open
+ *     query (0 while it is off); CLEAR_REPORT_VALUE(1) and GET_REPORT each
+ *     close it, so a report sums exactly the draws since the last clear;
+ *   - a report with no draw since the clear is 0 at once;
+ *   - a report whose draws are only recorded is pending until the engine
+ *     submits: RSX_ZPASS_POLL leaves it, RSX_ZPASS_KICK submits it, and a
+ *     count the backend lost comes back as -1.
+ *
+ * clang -std=gnu17 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video
+ *   -o /tmp/test_zpass_engine libs/video/tests/test_zpass_engine.c
+ *   libs/video/rsx_draw_engine.c libs/video/rsx_dispatch.c libs/video/rsx_vertex_compact.c
+ *   libs/video/rsx_texture_layout.c libs/video/rsx_vp_decompiler.c libs/video/rsx_fp_decompiler.c
+ */
+#define main old_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+
+#define M_POLY_OFFSET_FILL   0x0A68
+#define M_POLY_OFFSET_FACTOR 0x0A78
+#define M_POLY_OFFSET_BIAS   0x0A7C
+#define M_CLEAR_REPORT       0x17C8
+#define M_ZPASS_ENABLE       0x17CC
+
+static u32 fbits(float f) { u32 u; memcpy(&u, &f, 4); return u; }
+
+/* What the backend was told before the last draw. */
+static float bias_slope = -99, bias_units = -99;
+static u32 bias_bits, bias_calls;
+static void zb_depth_bias(void* u, float slope, float units, u32 bits)
+{ (void)u; bias_slope = slope; bias_units = units; bias_bits = bits; bias_calls++; }
+
+/* Queries the draws were counted into, and a fake GPU: a query is
+ * "recorded" until the engine submits, then done with 10 samples a draw. */
+#define NQ 64
+static u32 draw_query[NQ], n_draw_queries, pending_query;
+static u32 q_draws[NQ], q_submitted[NQ];
+static int q_lost[NQ], submits;
+static void zb_set_occlusion(void* u, u32 q) { (void)u; pending_query = q; }
+static void zb_draw(void* u, rsx_topology t, const void* v, u32 n, u32 s, const u32* i, u32 ni)
+{
+    stub_draw(u, t, v, n, s, i, ni);
+    if (n_draw_queries < NQ) draw_query[n_draw_queries++] = pending_query;
+    if (pending_query && pending_query < NQ) q_draws[pending_query]++;
+}
+static void zb_submit(void* u, u32 reason)
+{
+    (void)u; (void)reason; submits++;
+    for (u32 q = 0; q < NQ; q++) q_submitted[q] = q_draws[q];
+}
+static int zb_result(void* u, u32 q, u64* samples)
+{
+    (void)u;
+    if (!q || q >= NQ || !q_draws[q] || q_lost[q]) return -1;
+    if (q_submitted[q] != q_draws[q]) return 2;
+    *samples = 10ull * q_draws[q];
+    return 1;
+}
+
+int main(void)
+{
+    setenv("PS3RECOMP_ENG_ZPASS", "1", 1);   /* host counting is opt-in */
+    vm_base = calloc(1, GUEST_BYTES);
+    if (!vm_base) return 2;
+    ppu_vm_size = GUEST_BYTES;
+
+    rsx_draw_backend be = g_stub_backend;
+    be.set_depth_bias = zb_depth_bias;
+    be.set_occlusion = zb_set_occlusion;
+    be.occlusion_result = zb_result;
+    be.draw = zb_draw;
+    be.submit_and_wait = zb_submit;
+    engine_up_with(&be);
+
+    /* ---- polygon offset ---- */
+    draw_triangle();
+    CHECK(stub.n_draw == 1, "the draw executed");
+    CHECK(bias_calls == 1 && bias_slope == 0.0f && bias_units == 0.0f,
+          "no offset: the backend is told 0/0 (slope %g units %g)", bias_slope, bias_units);
+    m(M_POLY_OFFSET_FACTOR, fbits(-1.0f));
+    m(M_POLY_OFFSET_BIAS, fbits(-256.0f));
+    draw_triangle();
+    CHECK(bias_slope == 0.0f && bias_units == 0.0f, "factor/bias alone change nothing while FILL is off");
+    m(M_POLY_OFFSET_FILL, 1);
+    draw_triangle();
+    CHECK(bias_slope == -1.0f && bias_units == -256.0f && bias_bits == 24u,
+          "FILL on: -1/-256 against a Z24 zeta (slope %g units %g bits %u)", bias_slope, bias_units, bias_bits);
+    m(M_SURFACE_FORMAT, 8u | (1u << 5));          /* A8R8G8B8, Z16 */
+    m(M_POLY_OFFSET_FACTOR, fbits(0.25f));
+    m(M_POLY_OFFSET_BIAS, fbits(200.0f));
+    draw_triangle();
+    CHECK(bias_slope == 0.25f && bias_units == 200.0f && bias_bits == 16u,
+          "a Z16 zeta says 16 bits (slope %g units %g bits %u)", bias_slope, bias_units, bias_bits);
+    m(M_SURFACE_FORMAT, 8u | (2u << 5));          /* back to Z24S8 */
+    m(M_POLY_OFFSET_FILL, 0);
+    draw_triangle();
+    CHECK(bias_slope == 0.0f && bias_units == 0.0f, "FILL off again: 0/0");
+
+    /* ---- ZPASS ---- */
+    const u32 base = n_draw_queries;
+    draw_triangle();                                /* counting off */
+    CHECK(draw_query[base] == 0, "with ZPASS counting off a draw counts into nothing");
+    CHECK(rsx_draw_engine_zpass_supported(), "the backend can count");
+    m(M_ZPASS_ENABLE, 1);
+    m(M_CLEAR_REPORT, 1);
+    draw_triangle();
+    const u32 t1 = rsx_draw_engine_zpass_report();
+    m(M_CLEAR_REPORT, 1);
+    draw_triangle();
+    draw_triangle();
+    const u32 t2 = rsx_draw_engine_zpass_report();
+    draw_triangle();                                /* no clear: t3 sums t2's draws too */
+    const u32 t3 = rsx_draw_engine_zpass_report();
+    m(M_CLEAR_REPORT, 1);
+    const u32 t4 = rsx_draw_engine_zpass_report();  /* nothing drawn since the clear */
+    const u32 qa = draw_query[base + 1], qb = draw_query[base + 2], qc = draw_query[base + 4];
+    CHECK(t1 && t2 && t3 && t4 && t1 != t2, "reports get tickets");
+    CHECK(qa && qb && qa != qb && draw_query[base + 3] == qb,
+          "a clear opens a new query; draws until the next report share it");
+    CHECK(qc && qc != qb, "a report closes the query: later draws get a new one");
+
+    u32 v = 0xDEAD;
+    CHECK(rsx_draw_engine_zpass_result(t4, RSX_ZPASS_POLL, &v) == 1 && v == 0,
+          "a report with no draw since the clear is 0 at once");
+    CHECK(rsx_draw_engine_zpass_result(t1, RSX_ZPASS_POLL, &v) == 0 && submits == 0,
+          "recorded draws: POLL leaves the report pending and submits nothing");
+    CHECK(rsx_draw_engine_zpass_result(t1, RSX_ZPASS_KICK, &v) == 1 && v == 10 && submits == 1,
+          "KICK submits recorded work and the count comes back (%u)", v);
+    CHECK(rsx_draw_engine_zpass_result(t2, RSX_ZPASS_POLL, &v) == 1 && v == 20,
+          "two draws in one query count twice (%u)", v);
+    CHECK(rsx_draw_engine_zpass_result(t3, RSX_ZPASS_POLL, &v) == 1 && v == 30,
+          "without a clear the count keeps adding up (%u)", v);
+    q_lost[qa] = 1;
+    CHECK(rsx_draw_engine_zpass_result(t1, RSX_ZPASS_POLL, &v) == -1, "a lost count is -1");
+    CHECK(rsx_draw_engine_zpass_result(0x7FFFFFFFu, RSX_ZPASS_POLL, &v) == -1, "an unknown ticket is -1");
+
+    m(M_ZPASS_ENABLE, 0);
+    const u32 before = n_draw_queries;
+    draw_triangle();
+    CHECK(draw_query[before] == 0, "counting disabled again: draws count into nothing");
+
+    engine_down();
+    free(vm_base);
+    printf("zpass engine failures: %d\n", g_failures);
+    return g_failures ? 1 : 0;
+}
