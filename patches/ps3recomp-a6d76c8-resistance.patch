+extern "C" void ps3_overlay_before_exec(void)
+{
+    if (overlay_off()) return;
+    if (s_dirty) settings_save();
+    pthread_mutex_lock(&s_set_lock);
+    ps3os_export_session(kVar, V_N, s_value);
+    pthread_mutex_unlock(&s_set_lock);
+}
