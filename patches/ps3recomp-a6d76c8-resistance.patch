+ * 0x05 off, 0x21 feedback, 0x25 weapon, 0x26 vibration). Positions are the
+ * ten zones of the trigger's travel (0-9), strengths 1-8. */
+static void pad_trig_block(uint8_t out[11], int effect)
+{
+    memset(out, 0, 11);
+    if (effect == PAD_TRIG_WEAPON) {
+        /* resistance from zone 2, breaking at zone 5, strength 6 */
+        const unsigned zones = (1u << 2) | (1u << 5);
+        out[0] = 0x25;
+        out[1] = (uint8_t)(zones & 0xFF);
+        out[2] = (uint8_t)(zones >> 8);
+        out[3] = 6 - 1;
+    } else if (effect == PAD_TRIG_FEEDBACK) {
+        /* light even resistance from zone 1: strength 2 */
+        unsigned active = 0;
+        uint32_t force = 0;
+        for (int z = 1; z < 10; z++) { active |= 1u << z; force |= (uint32_t)(2 - 1) << (3 * z); }
+        out[0] = 0x21;
+        out[1] = (uint8_t)(active & 0xFF); out[2] = (uint8_t)(active >> 8);
+        out[3] = (uint8_t)force; out[4] = (uint8_t)(force >> 8);
+        out[5] = (uint8_t)(force >> 16); out[6] = (uint8_t)(force >> 24);
+    } else if (effect > PAD_TRIG_BUZZ) {
+        /* vibration over the whole travel, amplitude 1-8, 30 Hz */
+        const int amp = effect - PAD_TRIG_BUZZ;
+        unsigned active = 0;
+        uint32_t ampz = 0;
+        for (int z = 0; z < 10; z++) { active |= 1u << z; ampz |= (uint32_t)(amp - 1) << (3 * z); }
+        out[0] = 0x26;
+        out[1] = (uint8_t)(active & 0xFF); out[2] = (uint8_t)(active >> 8);
+        out[3] = (uint8_t)ampz; out[4] = (uint8_t)(ampz >> 8);
+        out[5] = (uint8_t)(ampz >> 16); out[6] = (uint8_t)(ampz >> 24);
