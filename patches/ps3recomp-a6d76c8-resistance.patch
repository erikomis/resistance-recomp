+    CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)vdec_idle_thread, NULL, 0, NULL);
+#else
+    pthread_t t;
+    if (pthread_create(&t, NULL, vdec_idle_thread, NULL) == 0)
+        pthread_detach(t);
+#endif
