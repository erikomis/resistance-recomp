+/* PS3_SHADER_TIMING=1 (from the Resistance 2 port): one line per pipeline build saying where its time
+ * went -- HLSL -> MSL translation (or a cache hit, or a function already in
+ * memory), MSL -> library compile, and the pipeline state. The user's log
+ * showed builds of 14-227 ms (median 42) and bursts of 60-90 at a level
+ * load; this tells which stage a cache or an archive would remove. The
+ * builds run one at a time (the RSX thread, or the serial async queue), so
+ * one accumulator serves. */
+static int s_sb_on = -1;
+static __thread struct { double tr[2], co[2]; int hit[2], memo[2]; } s_sb;   /* per building thread */
+static int sb_on(void)
+{
+    if (s_sb_on < 0) { const char* e = getenv("PS3_SHADER_TIMING"); s_sb_on = e && atoi(e) > 0; }
+    return s_sb_on;
