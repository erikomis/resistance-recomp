+    u64 now = spurs_now_ns();
+    if (!s_st_last) { s_st_last = now; return; }
+    if (now - s_st_last < (u64)s_spurs_stats * 1000000000ull) return;
+    double secs = (double)(now - s_st_last) / 1e9;
+    for (u32 sn = 0; sn < si->nspus; sn++) {
+        char line[512]; int o = snprintf(line, sizeof line, "[spurs-stats] spu%u", sn);
+        for (u32 w = 0; w < 16; w++) if (s_st_runs[sn][w])
+            o += snprintf(line + o, sizeof line - o, " w%u=%.0f%%/%.0fcpu/%llu", w,
+                          100.0 * (double)s_st_ns[sn][w] / 1e9 / secs,
+                          100.0 * (double)s_st_cpu[sn][w] / 1e9 / secs,
+                          (unsigned long long)s_st_runs[sn][w]);
+        fprintf(stderr, "%s\n", line);
+    }
+    for (u32 w = 0; w < 16; w++) {
+        u64 nz = 0; for (int r = 1; r < 10; r++) nz += s_st_ready[w][r];
+        if (!nz) continue;
+        char line[256]; int o = snprintf(line, sizeof line, "[spurs-stats] wid%u ready:", w);
+        for (int r = 0; r < 10; r++) if (s_st_ready[w][r])
+            o += snprintf(line + o, sizeof line - o, " %d=%.1f%%", r,
+                          100.0 * (double)s_st_ready[w][r] / (double)s_st_passes);
