+/* ---------------------------------------------------------------------------
+ * NV0039: the RSX's memory-to-memory copy engine (from the Resistance 2 port).
+ *
+ * libgcm's init binds it to subchannel 1 (NV4097 is on 0); a SET_OBJECT
+ * (method 0) may rebind a subchannel, so the handle each one holds is tracked.
+ * Resistance 2 copies with it from inside its command stream: a run of
+ * NV0039 copies fills the words just ahead of the walker. Unimplemented,
+ * the copies never happened (the walker then decoded the stale words behind
+ * them -- float data taken for a JUMP, a resync, the title's 5 s "GPU sit
+ * and spin timeout"), and the copy registers landed on NV4097 as 3D state.
+ *
+ * Registers: 0x0184 / 0x0188 context DMA in / out (0xFEED0000 local memory,
+ * 0xFEED0001 main memory), 0x030C / 0x0310 offset in / out, 0x0314 / 0x0318
+ * pitch in / out (signed), 0x031C line length in bytes, 0x0320 line count,
+ * 0x0324 format (in element size | out element size << 8), 0x0328
+ * BUFFER_NOTIFY, which starts the copy. GCM_SUBCH1_M2MF=0 restores the old
+ * routing of subchannel 1 to the 3D engine.
+ * -----------------------------------------------------------------------*/
+#define GCM_HANDLE_NV4097 0x31337000u
+#define GCM_HANDLE_NV0039 0x31337303u
+static u32 s_subch_handle[8] = { GCM_HANDLE_NV4097, GCM_HANDLE_NV0039 };
+
+static struct {
+    u32 dma_in, dma_out, off_in, off_out;
+    s32 pitch_in, pitch_out;
+    u32 line_len, line_count, fmt;
+} s_m2mf = { 0xFEED0001u, 0xFEED0001u };
+
+static int gcm_subch_is_m2mf(u32 subch)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_SUBCH1_M2MF"); on = !(e && e[0] == '0'); }
+    return on && subch < 8 && s_subch_handle[subch] == GCM_HANDLE_NV0039;
+}
+
+static void gcm_m2mf_copy(void)
+{
+    const int in_local = s_m2mf.dma_in == 0xFEED0000u, out_local = s_m2mf.dma_out == 0xFEED0000u;
+    const u32 src = cellGcmResolveLocated(in_local, s_m2mf.off_in);
+    const u32 dst = cellGcmResolveLocated(out_local, s_m2mf.off_out);
+    u32 in_es = s_m2mf.fmt & 0xFFu, out_es = (s_m2mf.fmt >> 8) & 0xFFu;
+    if (!in_es) in_es = 1;
+    if (!out_es) out_es = 1;
+    const u32 len = s_m2mf.line_len, lines = s_m2mf.line_count;
+    { static int n = 0; if (PS3_LOG_FIRST(n, 8))
+        fprintf(stderr, "[NV0039] copy %u x %u B fmt=0x%X 0x%08X(%s+0x%X, pitch %d) -> "
+                "0x%08X(%s+0x%X, pitch %d)\n", lines, len, s_m2mf.fmt,
+                src, in_local ? "local" : "main", s_m2mf.off_in, s_m2mf.pitch_in,
+                dst, out_local ? "local" : "main", s_m2mf.off_out, s_m2mf.pitch_out); }
+    if (!src || !dst || !len || !lines || (u64)len * lines > (64u << 20)) return;
+    /* The byte ranges the lines span, for the draw engine's surfaces: the
+     * last line may lie below the first with a negative pitch. */
+    const u32 in_span = len * in_es, out_span = len * out_es;
+    const s64 in_last = (s64)(lines - 1u) * s_m2mf.pitch_in, out_last = (s64)(lines - 1u) * s_m2mf.pitch_out;
+    const u32 in_lo = (u32)((s64)s_m2mf.off_in + (in_last < 0 ? in_last : 0));
+    const u32 in_hi = (u32)((s64)s_m2mf.off_in + (in_last > 0 ? in_last : 0)) + in_span;
+    const u32 out_lo = (u32)((s64)s_m2mf.off_out + (out_last < 0 ? out_last : 0));
+    const u32 out_hi = (u32)((s64)s_m2mf.off_out + (out_last > 0 ? out_last : 0)) + out_span;
+    const int eng = rsx_draw_engine_enabled();
+    if (eng) rsx_draw_engine_m2mf_read(in_local ? RSX_LOCATION_LOCAL : RSX_LOCATION_MAIN,
+                                       in_lo, in_hi - in_lo);
+    for (u32 l = 0; l < lines; l++) {
+        const u32 s0 = src + (u32)((s32)l * s_m2mf.pitch_in);
+        const u32 d0 = dst + (u32)((s32)l * s_m2mf.pitch_out);
+        if (in_es == 1 && out_es == 1) {
+            memmove(vm_base + d0, vm_base + s0, len);
+        } else {
+            /* Element-wise: line_len elements, each carried in its own
+             * stride on either side. */
+            for (u32 k = 0; k < len; k++)
+                vm_base[d0 + k * out_es] = vm_base[s0 + k * in_es];
+        }
+    }
+    /* The copy may have written commands the walker is about to read. */
+    atomic_thread_fence(memory_order_seq_cst);
+    if (eng) rsx_draw_engine_m2mf_wrote(out_local ? RSX_LOCATION_LOCAL : RSX_LOCATION_MAIN,
+                                        out_lo, out_hi - out_lo);
+}
+
+static void gcm_m2mf_method(u32 method, u32 data)
+{
+    switch (method) {
+    case 0x0184: s_m2mf.dma_in     = data; return;
+    case 0x0188: s_m2mf.dma_out    = data; return;
+    case 0x030C: s_m2mf.off_in     = data; return;
+    case 0x0310: s_m2mf.off_out    = data; return;
+    case 0x0314: s_m2mf.pitch_in   = (s32)data; return;
+    case 0x0318: s_m2mf.pitch_out  = (s32)data; return;
+    case 0x031C: s_m2mf.line_len   = data; return;
+    case 0x0320: s_m2mf.line_count = data; return;
+    case 0x0324: s_m2mf.fmt        = data; return;
+    case 0x0328: gcm_m2mf_copy(); return;
+    default: return;                    /* 0x0180 notify DMA, 0x0104 NOP, ... */
+    }
+}
