+/* PS3_NET_DNS=ip:port with a port other than 53: a title's own DNS client
+ * (Resistance has one; it asks the DNS cellNetCtl reports, on port 53) is
+ * sent to that port instead, and the answer comes back looking like port 53.
+ * For a DNS server that cannot bind 53, such as a test's. 0 when unused. */
+static int net_dns_redirect(struct in_addr* ip, uint16_t* port)
+{
+    const char* d = getenv("PS3_NET_DNS");
+    const char* c = d ? strchr(d, ':') : NULL;
+    if (!c) return 0;
