+    for (int k = 0; k < 2; k++) how[k] = s_sb.memo[k] ? "memo" : s_sb.hit[k] ? "cached" : "translated";
+    fprintf(stderr, "[shader build] #%u: vp %s %.1f+%.1f ms, fp %s %.1f+%.1f ms (translate+compile),"
+                    " pso %.1f ms, total %.1f ms\n", __atomic_add_fetch(&n, 1, __ATOMIC_RELAXED),
+            how[0], s_sb.tr[0], s_sb.co[0], how[1], s_sb.tr[1], s_sb.co[1], pso_ms, total_ms);
+    memset(&s_sb, 0, sizeof s_sb);
