         if inside:
             cmd += ["--extra-funcs", ",".join(inside)]
         r = subprocess.run(cmd, capture_output=True, text=True)
@@ -204,7 +205,7 @@ def main():
             if "unsupported instruction(s)" in s:
                 unsup = int(s.split()[0])
         manifest.append({
-            "name": name, "prefix": prefix, "base": BASE, "entry": entry,
+            "name": name, "prefix": prefix, "base": base, "entry": entry,
             "entry_off": entry_off, "sig": sig.hex(), "size": len(raw),
             "funcs": funcs, "unsupported": unsup,
         })
@@ -222,6 +223,20 @@ def main():
 
 # Image ids for the job-code overlays. Well clear of the fingerprint-dispatched
 # images (1..25), the FMOD overlays (60..65) and the taskset policy (100).
+def module_base(raw):
+    """The LS address the module is linked for. The header carries it at +0x28,
+    next to the 0xC0DEC0DE magic at +0x20: 0x4000, the job code buffer, for
+    almost every module, but Resistance: Fall of Man also ships modules linked
+    at 0x7000, and lifting those at 0x4000 put every lifted address 0x3000
+    short of where the job manager runs them. Anything implausible falls back
+    to BASE."""
+    if len(raw) >= 0x2C and raw[0x20:0x24] == b"\xC0\xDE\xC0\xDE":
+        b = struct.unpack_from(">I", raw, 0x28)[0]
+        if b and b % 0x10 == 0 and b + len(raw) <= 0x40000:
+            return b
+    return BASE
+
+
 JOBMOD_IMAGE_BASE = 200
 
 def emit_register(manifest, REGISTER_C, sym_prefix):
diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index 9d9df717..74cfa9a6 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -657,6 +657,89 @@ _CRSET_RE = re.compile(
     r"ctx->cr = \(ctx->cr & ~\(0xFu << (?P<shift>\d+)\)\) \| \(cr_val << (?P<shift2>\d+)\); \}$")
 _CRBR_RE = re.compile(
     r"^(?P<ind>\s*)if \((?P<neg>!)?\(+ctx->cr >> (?P<shift>\d+)\) & (?P<mask>0x[0-9A-Fa-f]+|\d+)\)+\) (?P<rest>.*)$")
+# A line PPULifter._patched_translate wrote; group 1 is its guard symbol.
+_INSN_PATCH_RE = re.compile(r"^if \(([A-Za-z_]\w*)\) \{ .* /\* insn patch 0x[0-9A-F]{8}: ")
+# A hook line (an --insn-patches entry with "hook"); group 1 is the function.
+_INSN_HOOK_RE = re.compile(r"^([A-Za-z_]\w*)\(ctx\); .* /\* insn patch 0x[0-9A-F]{8}: hook ")
+
+
+def load_insn_patches(path: str) -> dict[int, tuple[int, int, str]]:
