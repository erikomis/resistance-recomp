+    m(M_BEGIN_END, 5u);
+    for (u32 i = 0; i < 3; i++) { m(0x1880, f32_bits(1)); m(0x1884, f32_bits(2)); } /* DATA2F */
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 8 && stub.draw_vertices == 3, "DATA2F ATTR0 emits on its Y word");
