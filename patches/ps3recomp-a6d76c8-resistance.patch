+ * ps3recomp - where /dev_hdd1 (the system cache) lands on the host.
+ *
+ * On the console cellSysCacheMount answers getCachePath = "/dev_hdd1": the
+ * title sees its own cache directory as the ROOT of /dev_hdd1, and the
+ * firmware maps that root to the title's cache folder on the drive (RPCS3:
+ * dev_hdd1/caches/<cacheId>). Titles build their cache paths from that answer,
+ * and some only work with it: Resistance's file layer splits "/dev_hdd1/x"
+ * into the device "/dev_hdd1" and "x", and finds the device only if the cache
+ * path it was given is "/dev_hdd1" itself. Handed "/dev_hdd1/cache/<id>", its
+ * movie stash ("<cache>/hdd1_movie_stash", written when an in-level cutscene
+ * needs the memory) never opened, and the main thread retried the open for
+ * ever (level 30, the conversion-centre switch).
+ *
+ * cellSysCacheMount (libs/system/cellSysutil.c) now answers "/dev_hdd1" and
+ * publishes the mounted cache id in the environment (PS3_SYSCACHE_ID), and both
+ * halves of the split filesystem (runtime/ppu/ppu_fs.cpp and
+ * runtime/syscalls/sys_fs.c) map through ps3_hdd1_host_path:
+ *
+ *   /dev_hdd1/<rest>  ->  <PS3_HDD1_ROOT>/cache/<id>/<rest>
+ *   /dev_hdd1         ->  <PS3_HDD1_ROOT>/cache/<id>
+ *
+ * which is the same host folder the old "/dev_hdd1/cache/<id>/<rest>" answer
+ * resolved to, so caches written before keep working. A guest path that still
+ * spells "/dev_hdd1/cache/<id>/..." (an older build's answer kept in a save)
+ * is not mapped twice. With no cache mounted, /dev_hdd1/<rest> maps to
+ * <PS3_HDD1_ROOT>/<rest> as before.
+ *
+ * The id travels through the environment rather than a shared symbol so each
+ * file-system translation unit (also built alone into its own test harness)
+ * stays free of a link dependency on cellSysutil.
+ */
+#ifndef PS3EMU_HDD1_CACHE_H
+#define PS3EMU_HDD1_CACHE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PS3_SYSCACHE_ID_ENV "PS3_SYSCACHE_ID"
+
+/* Map a guest /dev_hdd1 path under host root `root`. Returns 1 and writes
+ * `out` when `guest` is on /dev_hdd1, 0 when it is not (or there is no root,
+ * or the result would not fit: then `out` is left as an empty string). */
+static inline int ps3_hdd1_host_path(const char* guest, const char* root,
+                                     char* out, size_t cap)
+{
+    if (!guest || !root || !*root || !out || !cap) return 0;
+    if (strncmp(guest, "/dev_hdd1", 9) != 0) return 0;
+    if (guest[9] != '\0' && guest[9] != '/') return 0;     /* "/dev_hdd10" */
+    const char* rest = guest[9] ? guest + 10 : "";
+    const char* id = getenv(PS3_SYSCACHE_ID_ENV);
+    int n;
+    if (id && *id) {
+        /* Already spelled with the cache folder: do not add it again. */
+        size_t idn = strlen(id);
+        int spelled = strncmp(rest, "cache/", 6) == 0 &&
+                      strncmp(rest + 6, id, idn) == 0 &&
+                      (rest[6 + idn] == '\0' || rest[6 + idn] == '/');
+        if (spelled)
+            n = snprintf(out, cap, "%s/%s", root, rest);
+        else if (*rest)
+            n = snprintf(out, cap, "%s/cache/%s/%s", root, id, rest);
+        else
+            n = snprintf(out, cap, "%s/cache/%s", root, id);
+    } else {
+        n = snprintf(out, cap, "%s/%s", root, rest);
+    }
+    if (n < 0 || (size_t)n >= cap) { out[0] = '\0'; return 0; }
+    for (char* p = out; *p; p++) if (*p == '\\') *p = '/';
+    return 1;
+}
+
+#endif /* PS3EMU_HDD1_CACHE_H */
diff --git a/include/ps3emu/host_input.h b/include/ps3emu/host_input.h
new file mode 100644
index 00000000..402c37df
--- /dev/null
+++ b/include/ps3emu/host_input.h
@@ -0,0 +1,112 @@
+/*
+ * ps3recomp - keyboard and mouse state handed to the host pad (cellPad.c)
+ *
+ * The keyboard/mouse pad reads one of these. Whoever owns the window fills
+ * it in:
+ *
+ *   - the window host (tools/host_window, macOS): the window lives in the
+ *     launcher process and the game has none, so the block sits in the
+ *     control page both processes map (rsx_host_surface.h). The launcher
+ *     writes key and mouse state, the game reads it -- no messages, no
+ *     extra thread, and it survives the game's exec like the rest of the
+ *     page;
+ *   - the Metal backend's own window (no window host): a block in the game
+ *     process that the backend's event pump fills.
+ *
+ * Every field is a lock-free 32-bit atomic, so the two processes can share
+ * it through the mapped page.
+ *
+ *   keys[4]          macOS virtual key codes 0-127 held down, one bit each
+ *   mouse_dx/dy      motion since the game last drained it, 1/16 px
+ *                    (deltaY > 0 = down); the game exchanges it with 0
+ *   wheel            wheel turns since the last drain, 1/16 lines, + = away
+ *                    from the player whatever the scroll-direction setting
+ *   mouse_buttons    bit n = NSEvent buttonNumber n (1 left, 2 right,
+ *                    4 middle, 8 button 4, ...)
+ *   game_flags       written by the game: what the window should do with
+ *                    the mouse (PS3_HOST_INPUT_*)
+ *   captured         written by the window: 1 while the cursor is captured
+ *   pointer          written by the window while the game's in-game menu is
+ *                    open (PS3_HOST_INPUT_MENU): where the cursor is over
+ *                    the picture (ps3_host_input_pointer_pack), or
+ *                    PS3_HOST_POINTER_NONE
+ *   menu_toggle      counted up by the window at each press of the menu's
+ *                    keys (F1, Insert/Help, Cmd+,), so a tap between two of
+ *                    the game's frames is not lost (libs/video/ps3_overlay.mm)
+ *   menu_clicks      counted up at each left click while the menu is open
+ *                    (a click that goes down and up between two frames)
+ *
+ * Plain C, header only: cellPad.c, the Metal backend, the window host and the
+ * tests share it.
+ */
+#ifndef PS3EMU_HOST_INPUT_H
+#define PS3EMU_HOST_INPUT_H
+
+#include <stdatomic.h>
+#include <stdint.h>
+
+/* game_flags */
+#define PS3_HOST_INPUT_MOUSE_CAMERA  0x1u   /* the mouse turns the camera now */
+#define PS3_HOST_INPUT_CAPTURE       0x2u   /* ... and wants the cursor captured on a click */
+#define PS3_HOST_INPUT_ACTIVE        0x4u   /* a cellPad that reads this block is running */
+#define PS3_HOST_INPUT_MENU          0x8u   /* the in-game menu is open: release the mouse, and
+                                               record the pointer, buttons and wheel for it */
+
+#define PS3_HOST_POINTER_NONE        0xFFFFFFFFu
+
+typedef struct {
+    _Atomic uint32_t keys[4];
+    _Atomic int32_t  mouse_dx, mouse_dy, wheel;
+    _Atomic uint32_t mouse_buttons;
+    _Atomic uint32_t game_flags;
+    _Atomic uint32_t captured;
+    _Atomic uint32_t pointer;
+    _Atomic uint32_t menu_toggle;
+    _Atomic uint32_t menu_clicks;
+    uint32_t         reserved[3];
+} ps3_host_input;
+
+_Static_assert(sizeof(ps3_host_input) == 64, "ps3_host_input layout");
+
+/* A key went down (1) or up (0). */
+static inline void ps3_host_input_key(ps3_host_input* in, unsigned vk, int down)
+{
+    vk &= 127u;
+    if (down) atomic_fetch_or(&in->keys[vk >> 5], 1u << (vk & 31));
+    else      atomic_fetch_and(&in->keys[vk >> 5], ~(1u << (vk & 31)));
+}
+
+/* The pointer for the menu: (px, py) in a view of vw x vh points, origin at
+ * the top left, where the picture is letterboxed to `aspect` (width/height;
+ * 0 = the whole view). Packed as x | y << 16, each 0..65534 across the
+ * picture; PS3_HOST_POINTER_NONE when it is outside it. */
+static inline uint32_t ps3_host_input_pointer_pack(double px, double py, double vw, double vh, double aspect)
+{
+    if (!(vw > 0) || !(vh > 0)) return PS3_HOST_POINTER_NONE;
+    double fw = vw, fh = vh, x0 = 0, y0 = 0;
+    if (aspect > 0) {
+        if (vw / vh > aspect) { fw = vh * aspect; x0 = (vw - fw) / 2; }
+        else                  { fh = vw / aspect; y0 = (vh - fh) / 2; }
+    }
+    const double nx = (px - x0) / fw, ny = (py - y0) / fh;
+    if (!(nx >= 0.0 && nx <= 1.0 && ny >= 0.0 && ny <= 1.0)) return PS3_HOST_POINTER_NONE;
+    const uint32_t x = (uint32_t)(nx * 65534.0 + 0.5), y = (uint32_t)(ny * 65534.0 + 0.5);
+    return x | (y << 16);
+}
+
+/* 0..1 across the picture. */
+static inline void ps3_host_input_pointer_unpack(uint32_t p, double* nx, double* ny)
+{
+    *nx = (double)(p & 0xFFFFu) / 65534.0;
+    *ny = (double)(p >> 16) / 65534.0;
+}
+
+/* Nothing held: focus went elsewhere, so no key-up will arrive. */
+static inline void ps3_host_input_release_all(ps3_host_input* in)
+{
+    for (int i = 0; i < 4; i++) atomic_store(&in->keys[i], 0);
+    atomic_store(&in->mouse_buttons, 0);
+    atomic_store(&in->wheel, 0);
+}
+
+#endif /* PS3EMU_HOST_INPUT_H */
diff --git a/include/ps3emu/ps3_env_once.h b/include/ps3emu/ps3_env_once.h
new file mode 100644
index 00000000..40570da2
--- /dev/null
+++ b/include/ps3emu/ps3_env_once.h
@@ -0,0 +1,31 @@
+/*
+ * ps3recomp - getenv read once per call site
+ *
+ * Diagnostic switches are tested with getenv on hot paths (every cellFsRead,
+ * every HLE SPURS job, every WAIT_SIGNAL). The Windows CRT takes its
+ * environment lock in getenv, so those tests cost a lock round trip each and
+ * serialize the threads making them (upstream PR #437 measured it). The
+ * environment does not change while a title runs, so a file that includes
+ * this header -- after <stdlib.h> -- has each `getenv("LITERAL")` looked up
+ * once and kept in a static at that call site.
+ *
+ * Only for files whose getenv arguments are all string literals: the cache
+ * is per call site, not per name. Never include it from a header.
+ */
+#ifndef PS3EMU_PS3_ENV_ONCE_H
+#define PS3EMU_PS3_ENV_ONCE_H
+
+#include <stdlib.h>
+
+#if defined(__GNUC__) || defined(__clang__)
+#define getenv(name) (__extension__({                                          \
+    static const char* ps3__env_v;                                             \
+    static int ps3__env_done;                                                  \
+    if (!__atomic_load_n(&ps3__env_done, __ATOMIC_ACQUIRE)) {                  \
+        ps3__env_v = (getenv)(name);                                           \
+        __atomic_store_n(&ps3__env_done, 1, __ATOMIC_RELEASE);                 \
+    }                                                                          \
+    ps3__env_v; }))
+#endif
+
+#endif /* PS3EMU_PS3_ENV_ONCE_H */
diff --git a/include/ps3emu/quit_gate.h b/include/ps3emu/quit_gate.h
new file mode 100644
index 00000000..46c7ac05
--- /dev/null
+++ b/include/ps3emu/quit_gate.h
@@ -0,0 +1,45 @@
+/*
+ * ps3recomp - the quit gate: never end the process in the middle of a save
+ *
+ * A host that ends the process on its own (a window closed, a signal, the
+ * in-game menu's "Quit game") must not cut a save in half. The work that
+ * writes the player's data passes through the gate:
+ *
+ *   cellSaveData's save and load calls (libs/system/cellSaveData.c), and
+ *   every guest file opened for writing, from its open to its close
+ *   (runtime/ppu/ppu_fs.cpp: a checkpoint such as Resistance's quick.sav is
+ *   a plain cellFs write, not a cellSaveData one).
+ *
+ * The quit path closes the gate first, then waits for what is inside to
+ * leave. Once it is closed, a save or a write that would start parks its
+ * thread for good instead -- the process is about to end, and a save that
+ * never starts leaves the old one whole, where one cut short would not.
+ * Entering counts first and looks at the gate second, and closing does the
+ * reverse (both sequentially consistent), so a save is either seen by the
+ * waiting quit or never starts.
+ *
+ *   ps3_quit_gate_enter / _leave   around one save, or one writable file
+ *   ps3_quit_gate_close            the quit path, once: nothing new starts
+ *   ps3_quit_gate_busy             saves and writable files still open
+ *   ps3_quit_gate_wait(ms)         close, then wait up to ms for busy to be
+ *                                  0; returns what is still busy (0 = clear)
+ */
+#ifndef PS3EMU_QUIT_GATE_H
+#define PS3EMU_QUIT_GATE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void ps3_quit_gate_enter(void);
+void ps3_quit_gate_leave(void);
+void ps3_quit_gate_close(void);
+int  ps3_quit_gate_closed(void);
+int  ps3_quit_gate_busy(void);
+int  ps3_quit_gate_wait(int ms);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_QUIT_GATE_H */
