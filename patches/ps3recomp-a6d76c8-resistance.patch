+ * manager's GOT_TICKET event.
+ *
+ * The local ticket is version 2.1: an 8-byte header (version, size of the
+ * rest), a body section and a footer section, each a run of typed fields
+ * (be16 type, be16 length, data). Medius servers read the online ID and the
+ * service ID at fixed offsets (84 and 136 bytes in), which this layout puts
+ * where a console's ticket has them. The signature is zero: no server that
+ * checks Sony's signature will take it. */
+#define SCE_NP_MANAGER_EVENT_GOT_TICKET 255
+#define NP_TICKET_MAX 512
+
+static u8  s_ticket[NP_TICKET_MAX];
+static u32 s_ticket_size = 0;
+static struct {
+    u8  serial[20];
+    u32 issuer;
+    u64 issued, expires, user_id;
+    char online_id[32];
+    u8  region[4];
+    char domain[4];
+    char service[24];
+    u32 status;
+} s_tk;
+
+static u32 tk_field(u8* p, u16 type, const void* data, u16 len)
+{
+    p[0] = (u8)(type >> 8); p[1] = (u8)type; p[2] = (u8)(len >> 8); p[3] = (u8)len;
+    if (len) memcpy(p + 4, data, len);
+    return 4u + len;
+}
+static void tk_be32(u8* p, u32 v) { p[0] = (u8)(v >> 24); p[1] = (u8)(v >> 16); p[2] = (u8)(v >> 8); p[3] = (u8)v; }
+static void tk_be64(u8* p, u64 v) { tk_be32(p, (u32)(v >> 32)); tk_be32(p + 4, (u32)v); }
+
+static u64 np_now_ms(void)
+{
+    struct timespec ts;
+    timespec_get(&ts, TIME_UTC);
+    return (u64)ts.tv_sec * 1000u + (u64)(ts.tv_nsec / 1000000);
+}
+
+/* Build the ticket for `service` (the title's service ID) into s_ticket. */
+u32 np_local_ticket(const char* service)
+{
+    memset(&s_tk, 0, sizeof s_tk);
+    const char* id = np_psnr_online_id();
+    strncpy(s_tk.online_id, id, sizeof s_tk.online_id - 1);
+    u64 h = 1469598103934665603ull;                 /* FNV-1a of the online ID */
+    for (const char* c = id; *c; c++) { h ^= (u8)*c; h *= 1099511628211ull; }
+    s_tk.user_id = h & 0x7FFFFFFFFFFFFFFFull;
+    s_tk.issued  = np_now_ms();
+    s_tk.expires = s_tk.issued + 10u * 60u * 1000u;   /* ten minutes */
+    for (int i = 0; i < 8; i++) s_tk.serial[i] = (u8)(s_tk.issued >> (56 - 8 * i));
+    for (int i = 8; i < 16; i++) s_tk.serial[i] = (u8)(h >> (8 * (i - 8)));
+    s_tk.issuer = 0x100;
+    memcpy(s_tk.region, "us\0\0", 4);
+    memcpy(s_tk.domain, "un\0\0", 4);
+    if (service) strncpy(s_tk.service, service, sizeof s_tk.service);
+    s_tk.status = 0;
+
+    u8 body[400], foot[80], v[8];
+    u32 b = 0, f = 0;
+    b += tk_field(body + b, 0x0008, s_tk.serial, 20);
+    tk_be32(v, s_tk.issuer);   b += tk_field(body + b, 0x0001, v, 4);
+    tk_be64(v, s_tk.issued);   b += tk_field(body + b, 0x0007, v, 8);
+    tk_be64(v, s_tk.expires);  b += tk_field(body + b, 0x0007, v, 8);
+    tk_be64(v, s_tk.user_id);  b += tk_field(body + b, 0x0002, v, 8);
+    b += tk_field(body + b, 0x0004, s_tk.online_id, 32);
+    b += tk_field(body + b, 0x0008, s_tk.region, 4);
+    b += tk_field(body + b, 0x0004, s_tk.domain, 4);
+    b += tk_field(body + b, 0x0008, s_tk.service, 24);
+    tk_be32(v, s_tk.status);   b += tk_field(body + b, 0x0001, v, 4);
+    b += tk_field(body + b, 0x0000, NULL, 0);          /* status duration: none */
+    b += tk_field(body + b, 0x0000, NULL, 0);          /* date of birth: none */
+    static const u8 zero[56] = { 0 };
+    f += tk_field(foot + f, 0x0008, zero, 4);          /* cipher ID */
+    f += tk_field(foot + f, 0x0008, zero, 56);         /* signature (none) */
+
+    u32 n = 8;
+    n += tk_field(s_ticket + n, 0x3000, body, (u16)b);
+    n += tk_field(s_ticket + n, 0x3002, foot, (u16)f);
+    tk_be32(s_ticket, 0x21010000u);                    /* version 2.1 */
+    tk_be32(s_ticket + 4, n - 8);
+    s_ticket_size = n;
+    return n;
+}
+
+static s32 np_request_ticket(const char* fn, u32 npId, u32 serviceId, u32 cookieSize)
+{
+    if (!s_np_initialized)
+        return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (!npId || !serviceId || cookieSize > SCE_NP_COOKIE_MAX_SIZE)
+        return SCE_NP_AUTH_EINVALID_ARGUMENT;
+    const char* svc = (const char*)(vm_base + serviceId);
+    if (np_local_signin()) {
+        const u32 n = np_local_ticket(svc);
+        printf("[sceNp] %s(service='%s') -> local ticket, %u bytes, online ID '%s'\n",
+               fn, svc, n, s_tk.online_id);
+        if (s_npmgr_cb) {
+            const u64 args[8] = { (u64)(u32)SCE_NP_MANAGER_EVENT_GOT_TICKET, (u64)n,
+                                  (u64)(u32)(uintptr_t)s_npmgr_cb_arg, 0, 0, 0, 0, 0 };
+            cellSysutilQueueGuestCallbackArgs((u32)(uintptr_t)s_npmgr_cb, args);
+        }
+        return CELL_OK;
+    }
+    if (!np_psnr_enabled()) {
+        printf("[sceNp] %s(service='%s') -> OFFLINE\n", fn, svc);
+        return SCE_NP_ERROR_OFFLINE;
+    }
+    printf("[sceNp] %s(service='%s') -> accepted, no ticket service\n", fn, svc);
+    return CELL_OK;
+}
+
+s32 sceNpManagerRequestTicket(const SceNpId* npId, const char* serviceId,
+                              const void* cookie, u32 cookieSize,
+                              const char* entitlementId, u32 consumedCount)
+{
+    (void)cookie; (void)entitlementId; (void)consumedCount;
+    return np_request_ticket("ManagerRequestTicket", (u32)(uintptr_t)npId,
+                             (u32)(uintptr_t)serviceId, cookieSize);
+}
+
+s32 sceNpManagerRequestTicket2(const SceNpId* npId, const void* version,
+                               const char* serviceId, const void* cookie,
+                               u32 cookieSize, const char* entitlementId,
+                               u32 consumedCount)
+{
+    (void)version; (void)cookie; (void)entitlementId; (void)consumedCount;
+    return np_request_ticket("ManagerRequestTicket2", (u32)(uintptr_t)npId,
+                             (u32)(uintptr_t)serviceId, cookieSize);
+}
+
+/* No buffer: the size it needs. A buffer: the ticket, when it fits. */
+s32 sceNpManagerGetTicket(void* buffer, u32* bufferSize)
+{
+    if (!s_np_initialized)
+        return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (!bufferSize)
+        return SCE_NP_ERROR_INVALID_ARGUMENT;
+    const u32 have = vm_read32((u32)(uintptr_t)bufferSize);
+    if (buffer && s_ticket_size) {
+        if (have < s_ticket_size) return SCE_NP_ERROR_INVALID_ARGUMENT;
+        memcpy(vm_base + (u32)(uintptr_t)buffer, s_ticket, s_ticket_size);
+    }
+    vm_write32((u32)(uintptr_t)bufferSize, s_ticket_size);   /* 0: no ticket */
+    return CELL_OK;
+}
+
+/* One field of the ticket (SceNpTicketParam: a 256-byte union, big-endian
+ * integers, SceNpDate for the date of birth). */
+s32 sceNpManagerGetTicketParam(s32 paramId, void* param)
+{
+    if (!s_np_initialized)
+        return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (!param || paramId < 0 || paramId > 11)   /* SERIAL_ID .. SUBJECT_DOB */
+        return SCE_NP_ERROR_INVALID_ARGUMENT;
+    if (!s_ticket_size)
+        return SCE_NP_ERROR_INVALID_STATE;
+    const u32 ea = (u32)(uintptr_t)param;
+    u8* p = vm_base + ea;
+    memset(p, 0, 256);
+    switch (paramId) {
+    case 0:  memcpy(p, s_tk.serial, 20); break;                      /* SERIAL_ID */
+    case 1:  vm_write32(ea, s_tk.issuer); break;                     /* ISSUER_ID */
+    case 2:  tk_be64(p, s_tk.issued); break;                         /* ISSUED_DATE */
+    case 3:  tk_be64(p, s_tk.expires); break;                        /* EXPIRE_DATE */
+    case 4:  tk_be64(p, s_tk.user_id); break;                        /* SUBJECT_ACCOUNT_ID */
+    case 5:  memcpy(p, s_tk.online_id, 32); break;                   /* SUBJECT_ONLINE_ID */
+    case 6:  memcpy(p, s_tk.region, 4); break;                       /* SUBJECT_REGION */
+    case 7:  memcpy(p, s_tk.domain, 4); break;                       /* SUBJECT_DOMAIN */
+    case 8:  memcpy(p, s_tk.service, 24); break;                     /* SERVICE_ID */
+    case 9:  vm_write32(ea, s_tk.status); break;                     /* SUBJECT_STATUS */
+    case 10: break;                                                  /* STATUS_DURATION: 0 */
+    case 11: p[0] = 0x07; p[1] = 0xC6; p[2] = 1; p[3] = 1; break;    /* SUBJECT_DOB: 1990-01-01 */
+    }
+    return CELL_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * NP Commerce (the first version, before sceNpCommerce2): the in-game
+ * PlayStation Store. Resistance's online menus create a context and ask for
+ * a product category (the map packs on sale) once the lobby opens:
+ * sceNpCommerceCreateCtx(1, npId, handler, 0, &ctx), then, for each entry,
+ * sceNpCommerceGetProductCategoryStart(ctx, category, lang, &req), retried
+ * in English on SCE_NP_COMMERCE_ERROR_INVALID_LANG_CODE. The store is gone,
+ * so a request is accepted and then fails the way a dead connection does:
+ * the handler gets REQUEST_ERROR with GPC_SEND_REQUEST, and every getter
+ * finds nothing. Unregistered, these answered CELL_OK and wrote nothing (no
+ * context ID, no request ID, no event).
+ * -----------------------------------------------------------------------*/
+#define SCE_NP_COMMERCE_VERSION                   1
+#define SCE_NP_COMMERCE_EVENT_REQUEST_ERROR       0x0001
+#define SCE_NP_COMMERCE_ERROR_NOT_INITIALIZED     0x80029401
+#define SCE_NP_COMMERCE_ERROR_UNSUPPORTED_VERSION 0x80029404
+#define SCE_NP_COMMERCE_ERROR_CTX_NOT_FOUND       0x80029406
+#define SCE_NP_COMMERCE_ERROR_REQ_NOT_FOUND       0x80029409
+#define SCE_NP_COMMERCE_ERROR_GPC_SEND_REQUEST    0x8002941D
+#define SCE_NP_COMMERCE_ERROR_CURRENCY_INFO_NOT_FOUND 0x80029422
+#define SCE_NP_COMMERCE_ERROR_CATEGORY_INFO_NOT_FOUND 0x80029423
+#define SCE_NP_COMMERCE_ERROR_SKU_INFO_NOT_FOUND  0x80029427
+
+static struct { u32 handler, arg, ctx, next_req; } s_commerce;
+
+s32 sceNpCommerceCreateCtx(u32 version, const SceNpId* npId, void* handler, void* arg, u32* ctxId)
+{
+    (void)npId;
+    if (!s_np_initialized) return (s32)SCE_NP_COMMERCE_ERROR_NOT_INITIALIZED;
+    if (version != SCE_NP_COMMERCE_VERSION) return (s32)SCE_NP_COMMERCE_ERROR_UNSUPPORTED_VERSION;
+    if (!ctxId) return (s32)SCE_NP_ERROR_INVALID_ARGUMENT;
+    s_commerce.handler = (u32)(uintptr_t)handler;
+    s_commerce.arg = (u32)(uintptr_t)arg;
+    s_commerce.ctx = 1;
+    vm_write32((u32)(uintptr_t)ctxId, s_commerce.ctx);
+    printf("[sceNp] CommerceCreateCtx() -> ctx 1 (the PlayStation Store is gone: its requests fail)\n");
+    return CELL_OK;
+}
+
+s32 sceNpCommerceDestroyCtx(u32 ctxId)
+{
+    if (!s_commerce.ctx || ctxId != s_commerce.ctx) return (s32)SCE_NP_COMMERCE_ERROR_CTX_NOT_FOUND;
+    s_commerce.ctx = 0;
+    return CELL_OK;
+}
+
+s32 sceNpCommerceGetProductCategoryStart(u32 ctxId, const char* categoryId, s32 langCode, u32* reqId)
+{
+    (void)categoryId; (void)langCode;
+    if (!s_commerce.ctx || ctxId != s_commerce.ctx) return (s32)SCE_NP_COMMERCE_ERROR_CTX_NOT_FOUND;
+    if (!reqId) return (s32)SCE_NP_ERROR_INVALID_ARGUMENT;
+    const u32 req = ++s_commerce.next_req;
+    vm_write32((u32)(uintptr_t)reqId, req);
+    if (s_commerce.handler) {
+        const u64 args[8] = { ctxId, req, (u64)(u32)SCE_NP_COMMERCE_EVENT_REQUEST_ERROR,
+                              (u64)(u32)SCE_NP_COMMERCE_ERROR_GPC_SEND_REQUEST, s_commerce.arg, 0, 0, 0 };
+        cellSysutilQueueGuestCallbackArgs(s_commerce.handler, args);
+    }
+    { static int _n = 0; if (_n++ < 4) printf("[sceNp] CommerceGetProductCategoryStart(req %u) -> REQUEST_ERROR (no store)\n", req); }
+    return CELL_OK;
+}
+
+s32 sceNpCommerceGetProductCategoryFinish(u32 reqId)
+{
+    return reqId && reqId <= s_commerce.next_req ? CELL_OK : (s32)SCE_NP_COMMERCE_ERROR_REQ_NOT_FOUND;
+}
+
+s32 sceNpCommerceGetProductCategoryResult(u32 reqId, void* buf, u32 bufSize, u32* fillSize)
+{
+    (void)buf; (void)bufSize;
+    if (fillSize) vm_write32((u32)(uintptr_t)fillSize, 0);
+    return reqId && reqId <= s_commerce.next_req ? (s32)SCE_NP_COMMERCE_ERROR_CATEGORY_INFO_NOT_FOUND
+                                                 : (s32)SCE_NP_COMMERCE_ERROR_REQ_NOT_FOUND;
+}
+
+s32 sceNpCommerceInitProductCategory(void* pc, const void* data, u32 dataSize)
+{
+    (void)pc; (void)data; (void)dataSize;
+    return (s32)SCE_NP_COMMERCE_ERROR_CATEGORY_INFO_NOT_FOUND;
+}
+
+s32 sceNpCommerceDestroyProductCategory(void* pc) { (void)pc; return CELL_OK; }
+
+/* Nothing to buy: checkout cannot start. */
+s32 sceNpCommerceDoCheckoutStartAsync(u32 ctxId, const void* skuIds, u32 skuNum, u32 container, u32* reqId)
+{
+    (void)ctxId; (void)skuIds; (void)skuNum; (void)container;
+    if (reqId) vm_write32((u32)(uintptr_t)reqId, 0);
+    return (s32)SCE_NP_COMMERCE_ERROR_SKU_INFO_NOT_FOUND;
+}
+s32 sceNpCommerceDoCheckoutFinishAsync(u32 reqId) { (void)reqId; return (s32)SCE_NP_COMMERCE_ERROR_REQ_NOT_FOUND; }
+
+/* The category and SKU getters: an empty store. */
+s32 sceNpCommerceGetCurrencyCode(void* info)          { (void)info; return (s32)SCE_NP_COMMERCE_ERROR_CURRENCY_INFO_NOT_FOUND; }
+s32 sceNpCommerceGetCurrencyDecimals(void* info)      { (void)info; return (s32)SCE_NP_COMMERCE_ERROR_CURRENCY_INFO_NOT_FOUND; }
+s32 sceNpCommerceGetCurrencyInfo(void* pc, void* info){ (void)pc; (void)info; return (s32)SCE_NP_COMMERCE_ERROR_CURRENCY_INFO_NOT_FOUND; }
+s32 sceNpCommerceGetNumOfChildProductSku(void* pc, u32* num)
+{
+    (void)pc;
+    if (num) vm_write32((u32)(uintptr_t)num, 0);
+    return CELL_OK;
+}
+s32 sceNpCommerceGetChildProductSkuInfo(void* pc, u32 index, void* info) { (void)pc; (void)index; (void)info; return (s32)SCE_NP_COMMERCE_ERROR_SKU_INFO_NOT_FOUND; }
+s32 sceNpCommerceGetSkuId(void* info)          { (void)info; return 0; }
+s32 sceNpCommerceGetSkuDescription(void* info) { (void)info; return 0; }
+s32 sceNpCommerceGetSkuPrice(void* info)       { (void)info; return 0; }
+s32 sceNpCommerceGetProductName(void* info)    { (void)info; return 0; }
+
 /* Parental controls: an unrestricted adult account. Unimplemented, these
  * returned OK without writing, and the title read whatever was in its stack. */
 s32 sceNpManagerGetContentRatingFlag(s32* isRestricted, s32* age)
