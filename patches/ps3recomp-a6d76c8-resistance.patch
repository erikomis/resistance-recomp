+/* Name lookups for community servers.
+ *
+ * Revival projects reach a title's old servers through DNS: a console set to
+ * their DNS server gets their address back for Sony's old host names (PS
+ * Rewired answers Resistance's resistance.ps3.online.scea.com this way). The
+ * same two ways, both off by default:
+ *   PS3_NET_HOSTS=name=ip[,name=ip...]  fixed answers; "*.suffix" matches
+ *                                       every name under it, "*" any name
+ *   PS3_NET_DNS=<ipv4>[:port]           ask that DNS server (UDP, port 53
+ *                                       by default) instead of the host's
+ *                                       resolver
+ * PS3_NET_HOSTS is asked first. With neither, the host's getaddrinfo, as
+ * before. */
+static int net_name_matches(const char* pat, size_t pn, const char* host)
+{
+    if (pn == 1 && pat[0] == '*') return 1;
+    const size_t hn = strlen(host);
+    if (pn > 2 && pat[0] == '*' && pat[1] == '.') {
+        const size_t sn = pn - 1;   /* ".suffix" */
+        return hn > sn && strncasecmp(host + hn - sn, pat + 1, sn) == 0;
+    }
+    return pn == hn && strncasecmp(host, pat, pn) == 0;
+}
+
+int sys_net_hosts_lookup(const char* list, const char* host, struct in_addr* out)
+{
+    if (!list || !host) return 0;
+    const char* p = list;
+    while (*p) {
+        while (*p == ',' || *p == ';' || *p == ' ') p++;
+        const char* eq = p;
+        while (*eq && *eq != '=' && *eq != ',' && *eq != ';') eq++;
+        if (*eq != '=') { p = eq; continue; }
+        const char* ip = eq + 1;
+        const char* end = ip;
+        while (*end && *end != ',' && *end != ';' && *end != ' ') end++;
+        char buf[16];
+        const size_t n = (size_t)(end - ip);
+        if (n > 0 && n < sizeof buf && net_name_matches(p, (size_t)(eq - p), host)) {
+            memcpy(buf, ip, n); buf[n] = 0;
+            if (inet_pton(AF_INET, buf, out) == 1) return 1;
+        }
+        p = end;
+    }
+    return 0;
+}
+
+/* One A query, two tries of 2 s. 1 with an address, 0 with none. */
+int sys_net_dns_query(const char* server, const char* host, struct in_addr* out)
+{
+    struct sockaddr_in sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons(53);
+    if (!server || !host) return 0;
+    char addr[24];
+    const char* colon = strchr(server, ':');           /* "ip[:port]" */
+    const size_t an = colon ? (size_t)(colon - server) : strlen(server);
+    if (an == 0 || an >= sizeof addr) return 0;
+    memcpy(addr, server, an); addr[an] = 0;
+    if (colon) {
+        const long port = strtol(colon + 1, NULL, 10);
+        if (port <= 0 || port > 65535) return 0;
+        sa.sin_port = htons((uint16_t)port);
+    }
+    if (inet_pton(AF_INET, addr, &sa.sin_addr) != 1) return 0;
+    uint8_t q[300];
+    const uint16_t id = (uint16_t)(rand() & 0xFFFF);
+    size_t n = 0;
+    q[n++] = id >> 8; q[n++] = id & 0xFF;
+    q[n++] = 0x01; q[n++] = 0x00;                    /* recursion desired */
+    q[n++] = 0; q[n++] = 1; memset(q + n, 0, 6); n += 6;   /* one question */
+    for (const char* l = host; *l;) {
+        const char* dot = strchr(l, '.');
+        const size_t len = dot ? (size_t)(dot - l) : strlen(l);
+        if (len == 0 || len > 63 || n + len + 6 > sizeof q) return 0;
+        q[n++] = (uint8_t)len; memcpy(q + n, l, len); n += len;
+        l += len; if (*l == '.') l++;
+    }
+    q[n++] = 0;
+    q[n++] = 0; q[n++] = 1; q[n++] = 0; q[n++] = 1;  /* A, IN */
+
+    host_socket_t s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s == HOST_INVALID_SOCKET) return 0;
+#ifdef _WIN32
+    DWORD tmo = 2000;
+#else
+    struct timeval tmo = { 2, 0 };
+#endif
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tmo, sizeof tmo);
+    int found = 0;
+    for (int attempt = 0; attempt < 2 && !found; attempt++) {
+        if (sendto(s, (const char*)q, (int)n, 0, (const struct sockaddr*)&sa, sizeof sa) != (int)n) break;
+        uint8_t r[1500];
+        const int got = (int)recvfrom(s, (char*)r, sizeof r, 0, NULL, NULL);
+        if (got < 12 || r[0] != q[0] || r[1] != q[1] || (r[3] & 0x0F) != 0) continue;
+        const int qd = (r[4] << 8) | r[5], an = (r[6] << 8) | r[7];
+        int o = 12;
+        for (int i = 0; i < qd && o < got; i++) {             /* skip the question(s) */
+            while (o < got && r[o] && (r[o] & 0xC0) != 0xC0) o += r[o] + 1;
+            o += (o < got && (r[o] & 0xC0) == 0xC0) ? 2 : 1;
+            o += 4;
+        }
+        for (int i = 0; i < an && o + 10 <= got; i++) {
+            while (o < got && r[o] && (r[o] & 0xC0) != 0xC0) o += r[o] + 1;   /* owner name */
+            o += (o < got && (r[o] & 0xC0) == 0xC0) ? 2 : 1;
+            if (o + 10 > got) break;
+            const int type = (r[o] << 8) | r[o + 1], rdlen = (r[o + 8] << 8) | r[o + 9];
+            o += 10;
+            if (o + rdlen > got) break;
+            if (type == 1 && rdlen == 4) { memcpy(&out->s_addr, r + o, 4); found = 1; break; }
+            o += rdlen;
+        }
+    }
+    host_closesocket(s);
+    return found;
+}
