+{
+    u32 enabled = vm_read32(ea + SPURS_WKL_ENABLED);
+    u32 signal  = vm_read16(ea + SPURS_WKL_SIGNAL1);
+    int best = -1; u32 best_w = 0;
+    for (u32 i = 0; i < 16; i++) {
+        if (!(enabled & (0x80000000u >> i))) continue;
+        if (vm_read8(ea + SPURS_WKL_STATE1 + i) != 2) continue;
