+static void build_menu(NSString* title, id target)
+{
+    NSMenu* bar = [NSMenu new];
+    NSMenuItem* app_item = [NSMenuItem new];
+    [bar addItem:app_item];
+    NSMenu* app_menu = [NSMenu new];
+    [app_menu addItemWithTitle:[@"Quit " stringByAppendingString:title]
+                        action:@selector(terminate:) keyEquivalent:@"q"];
+    app_item.submenu = app_menu;
+    NSMenuItem* view_item = [NSMenuItem new];
+    [bar addItem:view_item];
+    NSMenu* view_menu = [[NSMenu alloc] initWithTitle:@"View"];
+    NSMenuItem* fs = [view_menu addItemWithTitle:@"Toggle Full Screen"
+                                          action:@selector(toggleNativeFullScreen:) keyEquivalent:@"f"];
+    fs.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagControl;
+    fs.target = target;
+    NSMenuItem* bl = [view_menu addItemWithTitle:@"Toggle Borderless Full Screen"
+                                          action:@selector(toggleBorderless:) keyEquivalent:@"f"];
+    bl.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagOption;
+    bl.target = target;
+    /* Cmd+F: the kind PS3_WINDOW_MODE asked for (macOS's own otherwise) */
+    NSMenuItem* any = [view_menu addItemWithTitle:@"Full Screen"
+                                           action:@selector(toggleFullScreenStyle:) keyEquivalent:@"f"];
+    any.target = target;
+    [view_menu addItem:[NSMenuItem separatorItem]];
+    NSMenuItem* shot = [view_menu addItemWithTitle:@"Save Screenshot"
+                                            action:@selector(saveScreenshot:) keyEquivalent:@"s"];
+    shot.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagShift;
+    shot.target = target;
+    view_item.submenu = view_menu;
+    NSApp.mainMenu = bar;
+}
+
+static void make_window(u_int32_t w, u_int32_t h, NSScreen* scr, int vsync)
+{
+    double cw = w, ch = h;
+    if (scr) {
+        const NSRect vis = [NSWindow contentRectForFrameRect:scr.visibleFrame styleMask:NSWindowStyleMaskTitled];
+        hd_shrink_to(vis.size.width, vis.size.height, &cw, &ch);
+    }
+    g.window = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(0, 0, cw, ch)
+                  styleMask:(NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                             NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable)
+                    backing:NSBackingStoreBuffered
+                      defer:NO];
+    g.window.releasedWhenClosed = NO;
+    g.window.title = g.title;
+    g.window.collectionBehavior |= NSWindowCollectionBehaviorFullScreenPrimary;
+    g.window.acceptsMouseMovedEvents = YES;    /* the mouse camera */
+    g.window.contentMinSize = NSMakeSize(320, 180);
+    g.window.backgroundColor = [NSColor blackColor];
+    [g.window center];
+    /* center goes by the main screen; the middle of the chosen one instead
+     * (fullscreen and borderless then cover that screen). */
+    if (scr && scr != g.window.screen) {
+        const NSRect vf = scr.visibleFrame, wf = g.window.frame;
+        [g.window setFrameOrigin:NSMakePoint(floor(NSMidX(vf) - wf.size.width / 2),
+                                             floor(NSMidY(vf) - wf.size.height / 2))];
+    }
+    g.layer = [CAMetalLayer layer];
+    g.layer.device          = g.dev;
+    g.layer.pixelFormat     = MTLPixelFormatBGRA8Unorm;
+    g.layer.framebufferOnly = NO;           /* a blit destination */
+    g.layer.drawableSize    = CGSizeMake(w, h);
+    /* letterbox: the picture keeps its shape, black bars around it */
+    g.layer.contentsGravity = kCAGravityResizeAspect;
+    g.layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
+    g.layer.displaySyncEnabled = vsync ? YES : NO;   /* PS3_VSYNC */
+    NSView* view = g.window.contentView;
+    view.wantsLayer = YES;
+    view.layer = g.layer;
+    view.layerContentsPlacement = NSViewLayerContentsPlacementScaleProportionallyToFit;
+}
+
+static int usage(const char* self)
+{
+    fprintf(stderr, "usage: %s [--title T] [--size WxH] [--] <program> [args...]\n", self);
+    return 2;
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        const char* title = getenv("PS3_TITLE");
+        if (!title || !*title) title = HOST_WINDOW_TITLE;
+        u_int32_t w = 1280, h = 720;
+        { const char* e = getenv("PS3_WINDOW_SIZE");
+          if (e && *e && !hd_size_from(e, &w, &h))
+              fprintf(stderr, "[host window] PS3_WINDOW_SIZE=%s: expected <width>x<height>\n", e); }
+        int i = 1;
+        for (; i < argc; i++) {
+            if (!strcmp(argv[i], "--")) { i++; break; }
+            if (!strcmp(argv[i], "--title") && i + 1 < argc) { title = argv[++i]; continue; }
+            if (!strcmp(argv[i], "--size") && i + 1 < argc) {
+                if (sscanf(argv[++i], "%ux%u", &w, &h) != 2 || !w || !h ||
+                    w > RSX_HOST_MAX_DIM || h > RSX_HOST_MAX_DIM) return usage(argv[0]);
+                continue;
+            }
+            if (argv[i][0] == '-' && argv[i][1] == '-') return usage(argv[0]);
+            break;
+        }
+        if (i >= argc) return usage(argv[0]);
+        char** child_argv = argv + i;
+
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        g.tick_to_s = (double)tb.numer / tb.denom / 1e9;
+        const char* e = getenv("PS3RECOMP_METAL_FPS");
+        g.fps_on = e && !strcmp(e, "1");
+        e = getenv("PS3RECOMP_HOST_STATS");
+        g.stats_on = e && *e && *e != '0';
+        g.title = [NSString stringWithUTF8String:title];
+
+        snprintf(g.name, sizeof g.name, "org.ps3recomp.host-window.%d", getpid());
+        kern_return_t kr = bootstrap_check_in(bootstrap_port, g.name, &g.service);
+        g.dev = MTLCreateSystemDefaultDevice();
+        g.queue = [g.dev newCommandQueue];
+        if (kr != KERN_SUCCESS || !g.queue || make_control() != 0) {
+            fprintf(stderr, "[host window] cannot share a window (%s); running %s on its own\n",
+                    kr != KERN_SUCCESS ? bootstrap_strerror(kr) : "no Metal device or memory", child_argv[0]);
+            execvp(child_argv[0], child_argv);
+            fprintf(stderr, "[host window] cannot run %s: %s\n", child_argv[0], strerror(errno));
+            return 127;
+        }
+
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+        HostWindowDelegate* delegate = [HostWindowDelegate new];
+        NSApp.delegate = delegate;
+        build_menu(g.title, delegate);
+        const int mode = hd_window_mode_from(display_setting("PS3_WINDOW_MODE"));
+        g.fs_style = mode == HD_BORDERLESS ? HD_BORDERLESS : HD_FULLSCREEN;
+        g.upscale_on = hd_upscale_from(display_setting("PS3_UPSCALE"));
+        g.down_on = hd_downscale_from(getenv("PS3_DOWNSCALE"));
+        g.cas_after = hd_cas_after_from(getenv("PS3_CAS_AFTER"));
+        g.down_linear = hd_downscale_linear_from(getenv("PS3_DOWNSCALE_LINEAR"));
+#if !HOST_HAVE_METALFX
+        g.upscale_dead = 1;
+#endif
+        make_window(w, h, pick_screen(), hd_vsync_from(display_setting("PS3_VSYNC")));
+        g.window.delegate = delegate;
+        if (make_surfaces(w, h) != 0) {
+            fprintf(stderr, "[host window] cannot make %ux%u surfaces\n", w, h);
+            return 1;
+        }
+        cas_setup(g.layer.pixelFormat);
+        /* Presenting is the whole job of this process: keep App Nap off it
+         * even while the window is covered. */
+        id activity = [[NSProcessInfo processInfo]
+            beginActivityWithOptions:NSActivityUserInitiatedAllowingIdleSystemSleep | NSActivityLatencyCritical
+                              reason:@"presenting the game"];
+        (void)activity;
+
+        dispatch_queue_t mq = dispatch_get_main_queue();
+        dispatch_source_t rx = dispatch_source_create(DISPATCH_SOURCE_TYPE_MACH_RECV, g.service, 0, mq);
+        dispatch_source_set_event_handler(rx, ^{ drain_messages(); });
+        dispatch_resume(rx);
+
+        static dispatch_source_t sigs[3];
+        const int signals[3] = { SIGINT, SIGTERM, SIGHUP };
+        for (int s = 0; s < 3; s++) {
+            signal(signals[s], SIG_IGN);
+            sigs[s] = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, (uintptr_t)signals[s], 0, mq);
+            const int sig = signals[s];
+            dispatch_source_set_event_handler(sigs[s], ^{ begin_close(strsignal(sig)); });
+            dispatch_resume(sigs[s]);
+        }
+        /* SIGUSR1: a screenshot of the next frame shown (scripts, tests) */
+        signal(SIGUSR1, SIG_IGN);
+        static dispatch_source_t usr1;
+        usr1 = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, SIGUSR1, 0, mq);
+        dispatch_source_set_event_handler(usr1, ^{ request_screenshot(); });
+        dispatch_resume(usr1);
+
+        setenv(RSX_HOST_SURFACE_ENV, g.name, 1);
+        g.child = spawn_child(child_argv);
+        if (g.child <= 0) return 127;
+        dispatch_source_t proc = dispatch_source_create(DISPATCH_SOURCE_TYPE_PROC, (uintptr_t)g.child,
+                                                        DISPATCH_PROC_EXIT, mq);
+        dispatch_source_set_event_handler(proc, ^{ child_exited(); });
+        dispatch_resume(proc);
+
+        /* Keys and mouse to the game (ctl->input); a key is swallowed, or
+         * AppKit beeps at every press. */
+        [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskAny handler:^NSEvent*(NSEvent* ev) {
+            return hic_event(&g.input, ev, g.window) ? nil : ev;
+        }];
+        dispatch_source_t input_tick = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, mq);
+        dispatch_source_set_timer(input_tick, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                                  100 * NSEC_PER_MSEC, 20 * NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(input_tick, ^{ hic_tick(&g.input); display_tick(); });
+        dispatch_resume(input_tick);
+
+        metal_frame_rate_reset(&g.fps, CACurrentMediaTime());
+        dispatch_source_t timer = nil;
+        if (g.fps_on || g.stats_on) {
+            timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, mq);
+            dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                                      NSEC_PER_SEC, 50 * NSEC_PER_MSEC);
+            dispatch_source_set_event_handler(timer, ^{ stats_tick(); });
+            dispatch_resume(timer);
+        }
+
+        [g.window makeKeyAndOrderFront:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+        if (mode == HD_BORDERLESS) enter_borderless();
+        else if (mode == HD_FULLSCREEN)        /* it animates: the window has to be up first */
+            dispatch_async(mq, ^{ if (!native_fullscreen()) [g.window toggleFullScreen:nil]; });
+        present_black();
+        display_tick();                         /* what the in-game menu shows from the start */
+        fprintf(stderr, "[host window] '%s' pid %d window %ld, game pid %d (%s)\n",
+                title, getpid(), (long)g.window.windowNumber, g.child, g.name);
+        [NSApp run];
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_display.c b/tools/host_window/test_host_display.c
new file mode 100644
index 00000000..b6ad04a6
--- /dev/null
+++ b/tools/host_window/test_host_display.c
@@ -0,0 +1,62 @@
+/* The window host's display options (host_display.h): PS3_WINDOW_MODE,
+ * PS3_WINDOW_SIZE, PS3_VSYNC, PS3_UPSCALE, PS3_DOWNSCALE, and the drawable
+ * fitted for MetalFX upscaling and for supersampling.
+ *
+ *   cc -std=gnu17 -Wall -Wextra tools/host_window/test_host_display.c \
+ *      -o /tmp/test_host_display && /tmp/test_host_display
+ */
+#include "host_display.h"
+#include <assert.h>
+
+int main(void)
+{
+    assert(hd_window_mode_from(NULL) == HD_WINDOWED);
+    assert(hd_window_mode_from("") == HD_WINDOWED);
+    assert(hd_window_mode_from("Windowed") == HD_WINDOWED);
+    assert(hd_window_mode_from("fullscreen") == HD_FULLSCREEN);
+    assert(hd_window_mode_from("native") == HD_FULLSCREEN);
+    assert(hd_window_mode_from("BORDERLESS") == HD_BORDERLESS);
+    assert(hd_window_mode_from("kiosk") == HD_WINDOWED);       /* unknown: windowed, one line */
+
+    assert(hd_vsync_from(NULL) == 1 && hd_vsync_from("1") == 1 && hd_vsync_from("") == 1);
+    assert(hd_vsync_from("0") == 0);
+    assert(hd_vsync_from("00") == 1);                          /* only "0" turns it off */
+
+    assert(hd_upscale_from(NULL) == 0 && hd_upscale_from("off") == 0 && hd_upscale_from("0") == 0);
+    assert(hd_upscale_from("MetalFX") == 1);
+    assert(hd_upscale_from("fsr") == 0);
+
+    unsigned w = 1, h = 1;
+    assert(hd_size_from("1920x1080", &w, &h) && w == 1920 && h == 1080);
+    assert(!hd_size_from("1920x1080x2", &w, &h) && w == 1920);
+    assert(!hd_size_from("10x10", &w, &h));
+    assert(!hd_size_from("wide", &w, &h));
+    assert(!hd_size_from(NULL, &w, &h));
+
+    /* the drawable for MetalFX: the view's pixels fitted to 16:9 */
+    hd_fit(2560, 1440, 1280, 720, &w, &h); assert(w == 2560 && h == 1440);
+    hd_fit(3024, 1964, 1280, 720, &w, &h); assert(w == 3024 && h == 1701);   /* 16:10 screen: bars top and bottom */
+    hd_fit(3440, 1440, 1280, 720, &w, &h); assert(w == 2560 && h == 1440);   /* ultrawide: bars at the sides */
+    hd_fit(1280, 720, 1280, 720, &w, &h);  assert(w == 1280 && h == 720);    /* not larger: no upscale */
+    hd_fit(1000, 2000, 1280, 720, &w, &h); assert(w == 1280 && h == 720);    /* narrower than the source */
+    hd_fit(0, 0, 1280, 720, &w, &h);       assert(w == 1280 && h == 720);
+
+    assert(hd_downscale_from(NULL) == 1 && hd_downscale_from("") == 1 && hd_downscale_from("lanczos") == 1);
+    assert(hd_downscale_from("0") == 0 && hd_downscale_from("OFF") == 0);
+
+    /* the drawable for supersampling: the view's pixels fitted, smaller too */
+    hd_fit_any(1920, 1080, 3840, 2160, &w, &h); assert(w == 1920 && h == 1080);  /* 4K picture, 1080p window */
+    hd_fit_any(1512, 982, 2560, 1440, &w, &h);  assert(w == 1512 && h == 851);   /* 16:10 laptop: bars */
+    hd_fit_any(5120, 2880, 2560, 1440, &w, &h); assert(w == 5120 && h == 2880);  /* larger: the same fit */
+    hd_fit_any(0, 0, 1280, 720, &w, &h);        assert(w == 1280 && h == 720);
+
+    assert(hd_cas_after_from(NULL) == 1 && hd_cas_after_from("") == 1 && hd_cas_after_from("1") == 1);
+    assert(hd_cas_after_from("0") == 0 && hd_cas_after_from("off") == 0);   /* the rollback */
+
+    double cw = 2560, ch = 1440;
+    hd_shrink_to(1512, 945, &cw, &ch); assert(cw == 1512 && ch == 850);
+    cw = 1280; ch = 720;
+    hd_shrink_to(1512, 945, &cw, &ch); assert(cw == 1280 && ch == 720);
+    printf("test_host_display: ok\n");
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_downscale.m b/tools/host_window/test_host_window_downscale.m
new file mode 100644
index 00000000..611b5324
--- /dev/null
+++ b/tools/host_window/test_host_window_downscale.m
@@ -0,0 +1,218 @@
+/* The window host's supersampling path (PS3_DOWNSCALE, host_window.m) with no
+ * window: a picture three times the window's size reduced through
+ * downscale(). A one-pixel checkerboard -- the finest detail a picture holds,
+ * the kind that shimmers on edges -- must come out as an even grey, every
+ * source pixel weighed in; a layer that samples instead (one source pixel per
+ * window pixel) shows black or white. Same sizes reuse the output; a source a
+ * shader may not read turns the path off.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_downscale.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_downscale && /tmp/test_host_window_downscale
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+static id<MTLTexture> checker(NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            const uint8_t v = ((x ^ y) & 1) ? 255 : 0;
+            p[0] = p[1] = p[2] = v; p[3] = 255;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_downscale: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.width = 192; g.height = 108;
+        g.down_on = hd_downscale_from(NULL);
+        assert(g.down_on);
+
+        /* no window: the drawable stays the surfaces' size */
+        keep_drawable();
+        assert(g.layer.drawableSize.width == 192 && g.layer.drawableSize.height == 108);
+
+        id<MTLTexture> src = checker(192, 108, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        id<MTLTexture> out = downscale(cb, src, 64, 36);
+        if (!out) {
+            assert(!g.down_on);
+            printf("test_host_window_downscale: MetalPerformanceShaders not available here, fallback checked\n");
+            return 0;
+        }
+        assert(out.width == 64 && out.height == 36 && out.storageMode == MTLStorageModePrivate);
+        id<MTLTexture> back = checker(64, 36, MTLTextureUsageShaderRead);
+        id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        [b copyFromTexture:out toTexture:back];
+        [b endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(cb.status == MTLCommandBufferStatusCompleted);
+        uint8_t* px = malloc(64 * 36 * 4);
+        [back getBytes:px bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+        int lo = 255, hi = 0;
+        for (int y = 4; y < 32; y++)            /* away from the edges' clamping */
+            for (int x = 4; x < 60; x++) {
+                const int v = px[(y * 64 + x) * 4 + 1];
+                if (v < lo) lo = v;
+                if (v > hi) hi = v;
+            }
+        free(px);
+        printf("test_host_window_downscale: checkerboard 192x108 -> 64x36 gives %d..%d\n", lo, hi);
+        assert(lo > 80 && hi < 175);            /* grey, not black or white pixels */
+
+        /* a solid white picture stays white to the last row and column: the
+         * filter's taps past the edge read the edge (MPSImageEdgeModeClamp),
+         * not black, which left a darker 1-pixel frame */
+        {
+            const NSUInteger W = 192, H = 108, w = 64, h = 36;
+            MTLTextureDescriptor* wd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:W height:H mipmapped:NO];
+            wd.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+            wd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> white = [g.dev newTextureWithDescriptor:wd];
+            uint8_t* wp = malloc(W * H * 4);
+            memset(wp, 255, W * H * 4);
+            [white replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:wp bytesPerRow:W * 4];
+            free(wp);
+            cb = [g.queue commandBuffer];
+            id<MTLTexture> wout = downscale(cb, white, w, h);
+            assert(wout);
+            id<MTLTexture> wback = checker(w, h, MTLTextureUsageShaderRead);
+            b = [cb blitCommandEncoder];
+            [b copyFromTexture:wout toTexture:wback];
+            [b endEncoding];
+            [cb commit];
+            [cb waitUntilCompleted];
+            uint8_t* o = malloc(w * h * 4);
+            [wback getBytes:o bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+            int lo = 255;
+            for (NSUInteger y = 0; y < h; y++)
+                for (NSUInteger x = 0; x < w; x++)
+                    for (int c = 0; c < 3; c++) {
+                        const int v = o[(y * w + x) * 4 + c];
+                        if (v < lo) lo = v;
+                    }
+            free(o);
+            printf("test_host_window_downscale: solid white 192x108 -> 64x36, darkest pixel %d (edges included)\n", lo);
+            assert(lo >= 254);
+            /* back to the checkerboard's size for the reuse check below */
+            cb = [g.queue commandBuffer];
+            out = downscale(cb, src, 64, 36);
+            [cb commit]; [cb waitUntilCompleted];
+        }
+
+        /* the same sizes reuse the output */
+        id<MTLTexture> again = out;
+        cb = [g.queue commandBuffer];
+        assert(downscale(cb, src, 64, 36) == again);
+        [cb commit]; [cb waitUntilCompleted];
+
+        /* the fallback when the reduction cannot run for a frame: the picture
+         * scaled with a linear filter into the target already taken (no
+         * dropped drawable); the checkerboard comes out grey-ish, not black */
+        {
+            MTLTextureDescriptor* fd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:64 height:36 mipmapped:NO];
+            fd.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead; fd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> fdst = [g.dev newTextureWithDescriptor:fd];
+            cb = [g.queue commandBuffer];
+            assert(scaled_copy(cb, src, fdst));
+            [cb commit]; [cb waitUntilCompleted];
+            uint8_t* fo = malloc(64 * 36 * 4);
+            [fdst getBytes:fo bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+            long sum = 0; for (int i = 0; i < 64 * 36; i++) sum += fo[i * 4 + 1];
+            free(fo);
+            printf("test_host_window_downscale: filtered fallback copy, mean %ld\n", sum / (64 * 36));
+            assert(sum / (64 * 36) > 40 && sum / (64 * 36) < 215);
+        }
+
+        /* straight into a target a shader may write (no copy after); refused
+         * for one it may not, and in linear mode */
+        {
+            MTLTextureDescriptor* dd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:64 height:36 mipmapped:NO];
+            dd.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead; dd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> dw = [g.dev newTextureWithDescriptor:dd];
+            g.direct_checked = 0;
+            cb = [g.queue commandBuffer];
+            assert(downscale_direct(cb, src, dw) == 1);
+            [cb commit]; [cb waitUntilCompleted];
+            uint8_t* o2 = malloc(64 * 36 * 4);
+            [dw getBytes:o2 bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+            int lo2 = 255, hi2 = 0;
+            for (int y = 4; y < 32; y++) for (int x = 4; x < 60; x++) { const int v = o2[(y * 64 + x) * 4 + 1]; if (v < lo2) lo2 = v; if (v > hi2) hi2 = v; }
+            free(o2);
+            printf("test_host_window_downscale: straight into the target: %d..%d\n", lo2, hi2);
+            assert(lo2 > 80 && hi2 < 175);
+            dd.usage = MTLTextureUsageRenderTarget;
+            id<MTLTexture> dr = [g.dev newTextureWithDescriptor:dd];
+            g.direct_checked = 0;
+            cb = [g.queue commandBuffer];
+            assert(downscale_direct(cb, src, dr) == 0);
+            [cb commit]; [cb waitUntilCompleted];
+            g.direct_checked = 0;
+        }
+
+        /* PS3_DOWNSCALE_LINEAR: thin bright lines on dark keep more of their
+         * brightness than with the gamma-space reduction; white stays white */
+        {
+            const NSUInteger LW = 192, LH = 108;
+            MTLTextureDescriptor* ld = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:LW height:LH mipmapped:NO];
+            ld.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget | MTLTextureUsagePixelFormatView;
+            ld.storageMode = MTLStorageModeShared;
+            id<MTLTexture> lines = [g.dev newTextureWithDescriptor:ld];
+            uint8_t* lp = malloc(LW * LH * 4);
+            for (NSUInteger i = 0; i < LW * LH; i++) { const uint8_t v = (i % LW) % 3 == 0 ? 255 : 10; lp[i*4] = lp[i*4+1] = lp[i*4+2] = v; lp[i*4+3] = 255; }
+            [lines replaceRegion:MTLRegionMake2D(0, 0, LW, LH) mipmapLevel:0 withBytes:lp bytesPerRow:LW * 4];
+            free(lp);
+            long mean[2];
+            for (int lin = 0; lin < 2; lin++) {
+                g.down_linear = lin; g.ds_out = nil; g.ds_out_raw = nil;
+                cb = [g.queue commandBuffer];
+                id<MTLTexture> r = downscale(cb, lines, 64, 36);
+                assert(r && r.pixelFormat == MTLPixelFormatBGRA8Unorm);
+                id<MTLTexture> rb = checker(64, 36, MTLTextureUsageShaderRead);
+                id<MTLBlitCommandEncoder> lb = [cb blitCommandEncoder]; [lb copyFromTexture:r toTexture:rb]; [lb endEncoding];
+                [cb commit]; [cb waitUntilCompleted];
+                uint8_t* ro = malloc(64 * 36 * 4);
+                [rb getBytes:ro bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+                long sm = 0; for (int i = 0; i < 64 * 36; i++) sm += ro[i * 4 + 1];
+                free(ro); mean[lin] = sm / (64 * 36);
+            }
+            printf("test_host_window_downscale: 1-in-3 bright lines, mean %ld (gamma) vs %ld (linear light)\n", mean[0], mean[1]);
+            assert(mean[1] > mean[0] + 20);
+            g.down_linear = 0; g.ds_out = nil; g.ds_out_raw = nil;
+            cb = [g.queue commandBuffer];
+            out = downscale(cb, src, 64, 36);
+            [cb commit]; [cb waitUntilCompleted];
+        }
+
+        /* a source a shader may not read: it gives up, presents plain */
+        id<MTLTexture> bad = checker(192, 108, MTLTextureUsageRenderTarget);
+        cb = [g.queue commandBuffer];
+        assert(downscale(cb, bad, 64, 36) == nil);
+        assert(!g.down_on && g.ds_kernel == nil);
+        assert(g.layer.drawableSize.width == 192 && g.layer.drawableSize.height == 108);
+        printf("test_host_window_downscale: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_offscreen.m b/tools/host_window/test_host_window_offscreen.m
new file mode 100644
index 00000000..d09d222a
--- /dev/null
+++ b/tools/host_window/test_host_window_offscreen.m
@@ -0,0 +1,112 @@
+/* The window host off screen (host_window.m, "Off screen"): a window macOS
+ * does not show (another app or Space in front, minimized, covered) logs
+ * that it left and came back, its [RSX FPS] lines carry hidden=1 meanwhile,
+ * and coming back shows the newest frame the game published while it was
+ * away. No window: the layer is a bare CAMetalLayer.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_offscreen.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_offscreen && /tmp/test_host_window_offscreen
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+/* stderr into a file for the duration of fn; returns what was written */
+static char* capture(void (^fn)(void))
+{
+    char path[] = "/tmp/test_host_window_offscreen.XXXXXX";
+    const int fd = mkstemp(path);
+    assert(fd >= 0);
+    fflush(stderr);
+    const int saved = dup(2);
+    dup2(fd, 2);
+    fn();
+    fflush(stderr);
+    dup2(saved, 2);
+    close(saved);
+    const off_t n = lseek(fd, 0, SEEK_END);
+    char* out = calloc(1, (size_t)n + 1);
+    pread(fd, out, (size_t)n, 0);
+    close(fd);
+    unlink(path);
+    return out;
+}
+
+static int count(const char* s, const char* what)
+{
+    int n = 0;
+    for (const char* p = s; (p = strstr(p, what)); p += strlen(what)) n++;
+    return n;
+}
+
+/* what the game does for a finished frame */
+static uint64_t publish(void)
+{
+    const int slot = rsx_host_begin_render(g.ctl);
+    assert(slot >= 0);
+    rsx_host_end_render(g.ctl, slot, 1, mach_absolute_time());
+    return atomic_load(&g.ctl->seq[slot]);
+}
+
+/* the copy's completion comes back on the main queue */
+static void settle(void)
+{
+    for (int i = 0; i < 500 && g.present_busy; i++)
+        [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode
+                                 beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.01]];
+    assert(!g.present_busy);
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_offscreen: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.layer.device = g.dev;
+        g.layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+        g.layer.framebufferOnly = NO;
+        assert(make_control() == 0 && make_surfaces(64, 36) == 0);
+        g.fps_on = 1;
+        metal_frame_rate_reset(&g.fps, CACurrentMediaTime());
+
+        /* on screen: a frame goes up, and the rate line is plain */
+        const uint64_t first = publish();
+        try_present();
+        settle();
+        assert(g.shown_seq == first);
+        char* line = capture(^{ stats_tick(); });
+        assert(strstr(line, "[RSX FPS] display=") && !strstr(line, "hidden"));
+        free(line);
+
+        /* off screen: said once, and every rate line says hidden=1 */
+        line = capture(^{ note_on_screen(0, 100.0); note_on_screen(0, 101.0); });
+        assert(count(line, "[host window] window off screen") == 1);
+        free(line);
+        assert(g.off_screen);
+        line = capture(^{ stats_tick(); });
+        assert(strstr(line, "[RSX FPS] display=") && strstr(line, " hidden=1\n"));
+        free(line);
+
+        /* the game goes on meanwhile; back on screen, the newest of its
+         * frames goes up at once, with how long the window was away */
+        settle();
+        publish();
+        const uint64_t newest = publish();
+        line = capture(^{ note_on_screen(1, 127.5); });
+        assert(strstr(line, "[host window] window on screen again after 27.5 s"));
+        free(line);
+        assert(!g.off_screen);
+        assert(g.present_busy);                 /* presented by the change itself */
+        settle();
+        assert(g.shown_seq == newest);
+        line = capture(^{ note_on_screen(1, 130.0); stats_tick(); });
+        assert(!strstr(line, "on screen again") && !strstr(line, "hidden"));
+        free(line);
+        printf("test_host_window_offscreen: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_sharpen.m b/tools/host_window/test_host_window_sharpen.m
new file mode 100644
index 00000000..ca96dc4a
--- /dev/null
+++ b/tools/host_window/test_host_window_sharpen.m
@@ -0,0 +1,120 @@
+/* The window host's sharpening after the reduction (PS3_CAS_AFTER,
+ * host_window.m cas_setup / cas_into) with no window: the pipeline is made
+ * and says so in the control page (sharpen_caps); a frame sharpened into a
+ * target matches the game's CAS formula (rsx_metal_backend.m eng_present_fs)
+ * computed here on the CPU, to within one level; a flat picture comes out
+ * unchanged; and PS3_CAS_AFTER=0 makes nothing and tells the game so.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_sharpen.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_sharpen && /tmp/test_host_window_sharpen
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+enum { W = 32, H = 24 };
+
+static id<MTLTexture> picture(const uint8_t* bgra, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:W height:H mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    if (bgra) [t replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:bgra bytesPerRow:W * 4];
+    return t;
+}
+
+/* The game's CAS on one channel at (x, y), clamped at the edges as the
+ * nearest-clamp sampler is. */
+static float ref(const uint8_t* px, int x, int y, int c, float sharp)
+{
+#define P(dx, dy) (px[((size_t)(y + (dy) < 0 ? 0 : y + (dy) >= H ? H - 1 : y + (dy)) * W + \
+                       (size_t)(x + (dx) < 0 ? 0 : x + (dx) >= W ? W - 1 : x + (dx))) * 4 + c] / 255.0f)
+    const float a = P(-1, -1), b = P(0, -1), cc = P(1, -1), l = P(-1, 0), e = P(0, 0), r = P(1, 0),
+                g_ = P(-1, 1), h = P(0, 1), k = P(1, 1);
+#undef P
+    float mn = fminf(fminf(fminf(l, e), fminf(r, b)), h); mn += fminf(mn, fminf(fminf(a, cc), fminf(g_, k)));
+    float mx = fmaxf(fmaxf(fmaxf(l, e), fmaxf(r, b)), h); mx += fmaxf(mx, fmaxf(fmaxf(a, cc), fmaxf(g_, k)));
+    float q = fminf(mn, 2.0f - mx) / fmaxf(mx, 1e-5f);
+    q = q < 0 ? 0 : q > 1 ? 1 : q;
+    const float w = sqrtf(q) * (-1.0f / (8.0f + (5.0f - 8.0f) * sharp));
+    float o = (b * w + l * w + r * w + h * w + e) / (1.0f + 4.0f * w);
+    return o < 0 ? 0 : o > 1 ? 1 : o;
+}
+
+static void run(id<MTLTexture> src, id<MTLTexture> dst, float sharp, uint8_t* out)
+{
+    id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+    assert(cas_into(cb, src, dst, sharp));
+    [cb commit];
+    [cb waitUntilCompleted];
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+    [dst getBytes:out bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_sharpen: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        rsx_host_control* ctl = calloc(1, RSX_HOST_CONTROL_BYTES);
+        g.ctl = ctl;
+
+        /* PS3_CAS_AFTER=0: no pipeline, and the game is told nothing */
+        g.cas_after = hd_cas_after_from("0");
+        cas_setup(MTLPixelFormatBGRA8Unorm);
+        assert(!g.cas_pso && atomic_load(&ctl->sharpen_caps) == 0);
+
+        /* default: made, and the game may leave sharpening to the window */
+        g.cas_after = hd_cas_after_from(NULL);
+        cas_setup(MTLPixelFormatBGRA8Unorm);
+        assert(g.cas_pso && atomic_load(&ctl->sharpen_caps) == 1);
+
+        /* a soft step and a ramp: what CAS works on */
+        uint8_t* px = malloc(W * H * 4);
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) {
+                uint8_t* p = px + ((size_t)y * W + x) * 4;
+                p[0] = (uint8_t)(x < 14 ? 40 : x < 18 ? 40 + (x - 13) * 35 : 200);   /* B: a soft step */
+                p[1] = (uint8_t)(20 + y * 8);                                         /* G: a ramp */
+                p[2] = (uint8_t)(((x / 3) + (y / 3)) & 1 ? 180 : 70);                 /* R: 3x3 blocks */
+                p[3] = 255;
+            }
+        id<MTLTexture> src = picture(px, MTLTextureUsageShaderRead);
+        id<MTLTexture> dst = picture(NULL, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+        uint8_t* out = malloc(W * H * 4);
+        run(src, dst, 0.35f, out);
+        int worst = 0, changed = 0;
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++)
+                for (int c = 0; c < 3; c++) {
+                    const int want = (int)lroundf(ref(px, x, y, c, 0.35f) * 255.0f);
+                    const int got = out[((size_t)y * W + x) * 4 + c];
+                    if (abs(want - got) > worst) worst = abs(want - got);
+                    if (got != px[((size_t)y * W + x) * 4 + c]) changed++;
+                }
+        printf("test_host_window_sharpen: CAS 0.35 vs the game's formula: worst difference %d level(s), %d values sharpened\n",
+               worst, changed);
+        assert(worst <= 1 && changed > 0);
+
+        /* a flat picture: nothing to sharpen */
+        memset(px, 128, W * H * 4);
+        src = picture(px, MTLTextureUsageShaderRead);
+        run(src, dst, 1.0f, out);
+        for (int i = 0; i < W * H * 4; i++) if ((i & 3) != 3) assert(abs(out[i] - 128) <= 1);
+
+        /* a size mismatch is refused: the caller copies instead */
+        MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                      width:W / 2 height:H / 2 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget;
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        assert(!cas_into(cb, src, [g.dev newTextureWithDescriptor:td], 0.35f));
+        free(px); free(out); free(ctl);
+        printf("test_host_window_sharpen: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_upscale.m b/tools/host_window/test_host_window_upscale.m
new file mode 100644
index 00000000..b5941e69
--- /dev/null
+++ b/tools/host_window/test_host_window_upscale.m
@@ -0,0 +1,89 @@
+/* The window host's MetalFX path (PS3_UPSCALE=metalfx, host_window.m) with
+ * no window: a surface-sized frame through upscale() to a larger size, the
+ * fallback when the source cannot be read, and the drawable staying at the
+ * surfaces' size without it.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_upscale.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_upscale && /tmp/test_host_window_upscale
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+static id<MTLTexture> frame(NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            p[0] = (uint8_t)(x * 255 / (w - 1)); p[1] = (uint8_t)(y * 255 / (h - 1)); p[2] = 128; p[3] = 255;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_upscale: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.width = 64; g.height = 36;
+
+        /* without PS3_UPSCALE the drawable is the surfaces' size */
+        g.upscale_on = 0;
+        keep_drawable();
+        assert(g.layer.drawableSize.width == 64 && g.layer.drawableSize.height == 36);
+
+        g.upscale_on = 1;
+        id<MTLTexture> src = frame(64, 36, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        id<MTLTexture> out = upscale(cb, src, 128, 72);
+        if (!out) {
+            /* MetalFX missing on this machine: the path turns itself off */
+            assert(!g.upscale_on);
+            printf("test_host_window_upscale: MetalFX not available here, fallback checked\n");
+            return 0;
+        }
+        assert(out.width == 128 && out.height == 72 && out.storageMode == MTLStorageModePrivate);
+        /* read it back through a shared copy, as the window's blit would */
+        id<MTLTexture> back = frame(128, 72, MTLTextureUsageShaderRead);
+        id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        [b copyFromTexture:out toTexture:back];
+        [b endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(cb.status == MTLCommandBufferStatusCompleted);
+        uint8_t* px = malloc(128 * 72 * 4);
+        [back getBytes:px bytesPerRow:128 * 4 fromRegion:MTLRegionMake2D(0, 0, 128, 72) mipmapLevel:0];
+        /* the gradient survives: dark at the left, bright at the right, red kept */
+        const uint8_t* l = px + (36 * 128 + 2) * 4;
+        const uint8_t* r = px + (36 * 128 + 125) * 4;
+        assert(l[0] < 40 && r[0] > 215);
+        assert(abs((int)l[2] - 128) < 24 && abs((int)r[2] - 128) < 24);
+        free(px);
+        /* the same sizes reuse the scaler */
+        id scaler = g.fx_scaler;
+        cb = [g.queue commandBuffer];
+        assert(upscale(cb, src, 128, 72) == out && g.fx_scaler == scaler);
+        [cb commit]; [cb waitUntilCompleted];
+
+        /* a source the scaler may not read: it gives up, presents plain */
+        id<MTLTexture> bad = frame(64, 36, MTLTextureUsageRenderTarget);
+        cb = [g.queue commandBuffer];
+        assert(upscale(cb, bad, 128, 72) == nil);
+        assert(!g.upscale_on && g.fx_scaler == nil);
+        assert(g.layer.drawableSize.width == 64 && g.layer.drawableSize.height == 36);
+        printf("test_host_window_upscale: ok\n");
+    }
+    return 0;
+}
