+        free(px); m->bad = 1; return 0;
+    }
+    if (pw > 8192u || ph > 8192u) {
+        fprintf(stderr, "[mods] %s is %ux%u: at most 8192x8192; the original is used\n", path, pw, ph);
+        free(px); m->bad = 1; return 0;
