+    m(M_SCISSOR_V, 256u << 16);
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    CHECK(stub.n_clear_color == 1,
+          "without clear_color_rect a scissored clear falls back to a whole one (%d)",
+          stub.n_clear_color);
