+void cellMsgDialog_tick(void) {}
+/* cellSysutil.c declares vm_write32 extern (the runtime defines it); the test stores the word big-endian like the runtime. */
+void vm_write32(uint64_t a, uint32_t v) { for (int i = 0; i < 4; i++) vm_base[a + i] = (uint8_t)(v >> (24 - 8 * i)); }
+void vm_write8(uint64_t a, uint8_t v) { vm_base[a] = v; }
+
+static unsigned failures;
+#define CHECK(expr) do { if (!(expr)) { \
+    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #expr); failures++; \
+} } while (0)
+
+/* The guest value is stored big-endian at value_ea (vm_write32). */
+static uint32_t licence_area(void)
+{
+    s32 rc = cellSysutilGetSystemParamInt(CELL_SYSUTIL_SYSTEMPARAM_ID_LICENSE_AREA, 0x100);
+    CHECK(rc == CELL_OK);
+    return ((uint32_t)vm_base[0x100] << 24) | (vm_base[0x101] << 16) | (vm_base[0x102] << 8) | vm_base[0x103];
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 65536);
+    if (!vm_base) return 2;
+    unsetenv("PS3_LICENSE_AREA");
+    CHECK(licence_area() == CELL_SYSUTIL_LICENSE_AREA_A);   /* default: not Japan (0) */
+    setenv("PS3_LICENSE_AREA", "2", 1);
+    CHECK(licence_area() == CELL_SYSUTIL_LICENSE_AREA_E);
+    setenv("PS3_LICENSE_AREA", "0", 1);
+    CHECK(licence_area() == CELL_SYSUTIL_LICENSE_AREA_J);
+    setenv("PS3_LICENSE_AREA", "", 1);                      /* empty = unset */
+    CHECK(licence_area() == CELL_SYSUTIL_LICENSE_AREA_A);
+    if (failures) return 1;
+    puts("PASS: licence area default and PS3_LICENSE_AREA override");
+    return 0;
+}
diff --git a/libs/system/tests/test_quit_gate.c b/libs/system/tests/test_quit_gate.c
new file mode 100644
index 00000000..a3eaf9e9
--- /dev/null
+++ b/libs/system/tests/test_quit_gate.c
@@ -0,0 +1,72 @@
+/* The quit gate (include/ps3emu/quit_gate.h, in cellSaveData.c): a quit
+ * waits for the saves and writes inside it, and once it has begun a new one
+ * never starts -- its thread parks -- while one already inside may open
+ * another (a save that opens a file must not park the thread the quit is
+ * waiting for).
+ *
+ *   clang -std=gnu17 -I include libs/system/tests/test_quit_gate.c \
+ *         -Wl,-dead_strip -o /tmp/test_quit_gate && /tmp/test_quit_gate */
+#include "../cellSaveData.c"
+#include <assert.h>
+#include <pthread.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+
+static volatile int s_saving, s_done, s_late_started;
+
+/* A save that takes 300 ms, with a file opened inside it at the end. */
+static void* saver(void* arg)
+{
+    (void)arg;
+    ps3_quit_gate_enter();
+    s_saving = 1;
+    usleep(300 * 1000);
+    ps3_quit_gate_enter();            /* nested: never parks */
+    ps3_quit_gate_leave();
+    s_done = 1;
+    ps3_quit_gate_leave();
+    return NULL;
+}
+
+/* A save that would start after the quit began. */
+static void* late(void* arg)
+{
+    (void)arg;
+    ps3_quit_gate_enter();            /* parks for good */
+    s_late_started = 1;
+    return NULL;
+}
+
+int main(void)
+{
+    assert(ps3_quit_gate_busy() == 0 && !ps3_quit_gate_closed());
+    ps3_quit_gate_enter();
+    assert(ps3_quit_gate_busy() == 1);
+    ps3_quit_gate_leave();
+    assert(ps3_quit_gate_busy() == 0);
+
+    pthread_t a, b;
+    assert(pthread_create(&a, NULL, saver, NULL) == 0);
+    while (!s_saving) usleep(1000);
+    /* The quit: a short wait reports the save still inside ... */
+    assert(ps3_quit_gate_wait(50) == 1 && ps3_quit_gate_closed() && !s_done);
+    /* ... a longer one sees it finish (its nested open did not park). */
+    assert(ps3_quit_gate_wait(5000) == 0);
+    assert(s_done && ps3_quit_gate_busy() == 0);
+    pthread_join(a, NULL);
+    /* A save after the quit began never starts, and is not counted. */
+    assert(pthread_create(&b, NULL, late, NULL) == 0);
+    usleep(200 * 1000);
+    assert(!s_late_started && ps3_quit_gate_busy() == 0);
+    puts("test_quit_gate: ok");
+    return 0;                        /* the parked thread ends with the process */
+}
diff --git a/libs/system/tests/test_sysconf.c b/libs/system/tests/test_sysconf.c
new file mode 100644
index 00000000..eddf0bf0
--- /dev/null
+++ b/libs/system/tests/test_sysconf.c
@@ -0,0 +1,51 @@
+/* cellSysconfOpen / cellSysconfAbort: Open finishes at once and its callback
+ * (result, userdata) runs on the next cellSysutilCheckCallback, not inside
+ * Open; Abort with nothing open succeeds.
+ *
+ *   clang -std=gnu17 -I include libs/system/tests/test_sysconf.c libs/system/cellSysutil.c \
+ *         -Wl,-dead_strip -pthread -o /tmp/test_sysconf && /tmp/test_sysconf
+ */
+#include "../cellMsgDialog.c"   /* what cellSysutil.c links against */
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void np_psnr_pump(void) {}
+
+static unsigned calls;
+static u64 last_result, last_user;
+static void callback(u32 opd, u64 result, u64 user, u64 c, u64 d,
+                     u64 e, u64 f, u64 g, u64 h)
+{
+    assert(opd == 0x400 && !c && !d && !e && !f && !g && !h);
+    calls++; last_result = result; last_user = user;
+}
+
+int main(void)
+{
+    vm_base = calloc(1, 65536); assert(vm_base);
+    g_ps3_guest_caller = callback;
+
+    assert(cellSysconfAbort() == CELL_OK);
+    assert(cellSysconfOpen(1, 0x400, 0xBEEF, 0, 0) == CELL_OK);
+    assert(calls == 0);                       /* not from inside Open */
+    cellSysutilCheckCallback();
+    assert(calls == 1 && last_result == CELL_OK && last_user == 0xBEEF);
+    cellSysutilCheckCallback();
+    assert(calls == 1);                       /* once */
+    assert(cellSysconfOpen(2, 0, 0, 0, 0) == CELL_OK);   /* no callback: fine */
+    cellSysutilCheckCallback();
+    assert(calls == 1);
+    assert(cellSysconfAbort() == CELL_OK);
+
+    free(vm_base);
+    puts("cellSysconf checks passed");
+    return 0;
+}
