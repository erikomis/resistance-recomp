+/* The same hash over a sample of the span: its first and last 64-byte
+ * blocks and every eighth block between (a short span is hashed whole).
+ * Geometry the guest rewrites (skinning, particles, UI) changes blocks all
+ * over the span, so the sample sees it; the full hash still runs every
+ * PS3RECOMP_ENG_VCACHE_SPARSE frames to catch anything else. */
+static u64 eng_hash_span_sparse(const u8* src, u64 n, u64 seed)
+{
+    if (n <= 1024) return eng_hash_span(src, n, seed);
+    u64 h[8];
+    for (int k = 0; k < 8; k++) h[k] = seed ^ (0x9E3779B97F4A7C15ull * (u64)(k + 1));
+    const u64 last = (n - 64) & ~(u64)63;
+    u64 i = 0, blocks = 0;
+    for (;;) {
+        u64 w[8]; memcpy(w, src + i, sizeof w);
+        for (int k = 0; k < 8; k++) h[k] = (h[k] ^ w[k]) * 1099511628211ull;
+        blocks++;
+        if (i >= last) break;
+        i += 512;
+        if (i > last) i = last;
+    }
+    u64 r = n ^ (blocks << 48);
+    for (int k = 0; k < 8; k++) r ^= h[k] * (u64)(2 * k + 1);
+    return r;
