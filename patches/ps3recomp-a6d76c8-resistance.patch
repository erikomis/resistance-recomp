+/* PS3_NET_HOSTS and PS3_NET_DNS: the lookups a community server is reached
+ * through. The DNS half talks to a one-shot fake server on loopback. */
+#ifndef _WIN32
+#include <pthread.h>
+static host_socket_t s_dns_srv;
+static void* fake_dns(void* arg)
+{
+    (void)arg;
+    uint8_t q[512];
+    struct sockaddr_in from; socklen_t fl = sizeof from;
+    const int n = (int)recvfrom(s_dns_srv, q, sizeof q, 0, (struct sockaddr*)&from, &fl);
+    if (n < 12) return NULL;
+    uint8_t r[600];
+    memcpy(r, q, (size_t)n);
+    r[2] = 0x81; r[3] = 0x80;                 /* response, no error */
+    r[6] = 0; r[7] = 2;                       /* two answers: a CNAME, then the A */
+    int o = n;
+    const uint8_t cname[] = { 0xC0, 12, 0, 5, 0, 1, 0, 0, 0, 60, 0, 4, 3, 'x', 'y', 0 };
+    memcpy(r + o, cname, sizeof cname); o += (int)sizeof cname;
+    const uint8_t a[] = { 0xC0, 12, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4, 67, 222, 156, 250 };
+    memcpy(r + o, a, sizeof a); o += (int)sizeof a;
+    sendto(s_dns_srv, r, (size_t)o, 0, (struct sockaddr*)&from, fl);
+    return NULL;
+}
+#endif
+
+static void test_name_lookup(void)
+{
+    struct in_addr a;
+    const char* list = "resistance.ps3.online.scea.com=10.0.0.1, *.scee.com=10.0.0.2;bad=nope";
+    assert(sys_net_hosts_lookup(list, "resistance.ps3.online.scea.com", &a) && a.s_addr == inet_addr("10.0.0.1"));
+    assert(sys_net_hosts_lookup(list, "RESISTANCE.ps3.online.SCEA.com", &a));          /* names ignore case */
+    assert(sys_net_hosts_lookup(list, "resistance.online.scee.com", &a) && a.s_addr == inet_addr("10.0.0.2"));
+    assert(!sys_net_hosts_lookup(list, "scee.com", &a));                               /* "*." needs a label */
+    assert(!sys_net_hosts_lookup(list, "online.scea.com", &a));
+    assert(!sys_net_hosts_lookup(list, "bad", &a));                                    /* not an address */
+    assert(!sys_net_hosts_lookup(NULL, "x", &a));
+    assert(sys_net_hosts_lookup("*=127.0.0.1", "anything.example", &a) && a.s_addr == inet_addr("127.0.0.1"));
+
+    /* gethostbyname through the list: the hostent the title reads. */
+    setenv("PS3_NET_HOSTS", list, 1);
+    strcpy((char*)vm_base + 0xF0000, "resistance.online.scee.com");
+    const uint32_t h = sys_net_bnet_gethostbyname((const char*)(uintptr_t)0xF0000);
+    assert(h && vm_read32(h + 8) == SYS_NET_AF_INET && vm_read32(h + 12) == 4);
+    const uint32_t addr0 = vm_read32(vm_read32(h + 16));
+    assert(!memcmp(vm_base + addr0, "\x0A\x00\x00\x02", 4));
+    unsetenv("PS3_NET_HOSTS");
+
+#ifndef _WIN32
+    s_dns_srv = socket(AF_INET, SOCK_DGRAM, 0);
+    struct sockaddr_in sa; memset(&sa, 0, sizeof sa);
+    sa.sin_family = AF_INET; sa.sin_addr.s_addr = htonl(0x7F000001u);
+    assert(bind(s_dns_srv, (struct sockaddr*)&sa, sizeof sa) == 0);
+    socklen_t sl = sizeof sa; getsockname(s_dns_srv, (struct sockaddr*)&sa, &sl);
+    char srv[32]; snprintf(srv, sizeof srv, "127.0.0.1:%u", ntohs(sa.sin_port));
+    pthread_t th; pthread_create(&th, NULL, fake_dns, NULL);
+    assert(sys_net_dns_query(srv, "resistance.ps3.online.scea.com", &a));
+    assert(a.s_addr == inet_addr("67.222.156.250"));          /* past the CNAME */
+    pthread_join(th, NULL);
+    host_closesocket(s_dns_srv);
+    assert(!sys_net_dns_query("not-an-ip", "x.y", &a));
+    assert(!sys_net_dns_query("127.0.0.1:0", "x.y", &a));
+#endif
+    /* PS3_NET_ALLOW: only the listed addresses, and loopback. */
+    struct in_addr x;
+    unsetenv("PS3_NET_ALLOW");
+    inet_pton(AF_INET, "8.8.8.8", &x);        assert(net_allowed(&x));
+    setenv("PS3_NET_ALLOW", "67.222.156.250, 10.1.2.3", 1);
+    inet_pton(AF_INET, "67.222.156.250", &x); assert(net_allowed(&x));
+    inet_pton(AF_INET, "10.1.2.3", &x);       assert(net_allowed(&x));
+    inet_pton(AF_INET, "127.0.0.1", &x);      assert(net_allowed(&x));
+    inet_pton(AF_INET, "8.8.8.8", &x);        assert(!net_allowed(&x));
+    inet_pton(AF_INET, "239.255.255.250", &x); assert(!net_allowed(&x));
+    unsetenv("PS3_NET_ALLOW");
+    printf("test_sys_net: name lookups passed\n");
+}
+
 int main(void)
 {
     vm_base = (uint8_t*)calloc(1, 1u << 20);
     ps3_net_host_register(bump_alloc);
+    test_name_lookup();
     assert(s_reg[0].nid == 0x9C056962u);   /* "socket", as nid_database.py has it */
 
     const uint32_t LOOP = 0x7F000001u;
