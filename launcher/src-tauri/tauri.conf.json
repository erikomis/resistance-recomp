{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resistance Launcher",
  "version": "0.4.4",
  "identifier": "io.github.erikomis.resistancerecomp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resistance recomp",
        "width": 1100,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Game",
    "copyright": "Code: MIT. Resistance: Fall of Man (c) Sony Interactive Entertainment; not affiliated.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RTFFRkExNUJDMTAxQTQKUldTa0FjRmJvZS9oK1picXhpYTZZKy9wMGx2c0lXMVBzYjNWQ1ZldU9ldzFMQlcwM0IwZk5td2YK",
      "endpoints": [
        "https://github.com/erikomis/resistance-recomp/releases/download/updater/latest.json",
        "https://github.com/erikomis/resistance-recomp/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
