{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Resistance: Fall of Man",
  "repo": "erikomis/resistance-recomp",
  "requires": ["start", "start.macos", "exit_codes", "settings.json", "settings.choices", "settings.slider", "settings.groups"],
  "min": "0.90.0-beta.27",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your own Resistance: Fall of Man disc, the US release BCUS98107: a decrypted .iso of it, or its folder (the one with PS3_GAME in it, or PS3_GAME itself).",
    "check": {
      "iso9660": "PS3_DISC.SFB",
      "ids": ["BCUS98107"]
    }
  },
  "prepare": {
    "program": ["Resistance Launcher.app/Contents/MacOS/resistance-launcher"],
    "args": ["--prepare", "--game", "{game}"],
    "label": "Building the game from your disc (10 to 30 minutes, longer on a slow connection)",
    "timeout": 7200
  },
  "start": {
    "program": ["Resistance Launcher.app/Contents/MacOS/resistance-launcher"],
    "args": ["--play", "--game", "{game}"]
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [{ "path": "{home}/Library/Application Support/resistance-recomp/launcher.json" }]
    }
  ],
  "settings": [
    {
      "id": "window_mode",
      "label": "Display mode",
      "group": "Display",
      "choices": [
        { "label": "Window", "set": { "windowMode": "\"windowed\"" } },
        { "label": "Full screen (macOS)", "set": { "windowMode": "\"fullscreen\"" } },
        { "label": "Borderless full screen", "set": { "windowMode": "\"borderless\"" } }
      ],
      "defaults": { "windowMode": "\"windowed\"" }
    },
    {
      "id": "window_size",
      "label": "Window size",
      "help": "The window's size when it is not full screen.",
      "group": "Display",
      "choices": [
        { "label": "1280×720", "set": { "windowSize": "\"\"" } },
        { "label": "1600×900", "set": { "windowSize": "\"1600x900\"" } },
        { "label": "1920×1080", "set": { "windowSize": "\"1920x1080\"" } },
        { "label": "2560×1440", "set": { "windowSize": "\"2560x1440\"" } },
        { "label": "3840×2160", "set": { "windowSize": "\"3840x2160\"" } }
      ],
      "defaults": { "windowSize": "\"\"" }
    },
    {
      "id": "show_fps",
      "label": "Frame rate in the title bar",
      "group": "Display",
      "choices": [
        { "label": "On", "set": { "showFps": "true" } },
        { "label": "Off", "set": { "showFps": "false" } }
      ],
      "defaults": { "showFps": "true" }
    },
    {
      "id": "res_scale",
      "label": "Internal resolution",
      "help": "What the game draws at. 720p is the PS3's own; higher is experimental.",
      "group": "Graphics",
      "choices": [
        { "label": "720p (native)", "set": { "resScale": "\"\"" } },
        { "label": "1080p (1.5×)", "set": { "resScale": "\"1.5\"" } },
        { "label": "1440p (2×)", "set": { "resScale": "\"2\"" } },
        { "label": "4K (3×)", "set": { "resScale": "\"3\"" } }
      ],
      "defaults": { "resScale": "\"\"" }
    },
    {
      "id": "upscale",
      "label": "Upscaling",
      "help": "How the picture is scaled to the window. MetalFX is Apple's upscaler.",
      "group": "Graphics",
      "choices": [
        { "label": "Simple", "set": { "upscale": "\"\"" } },
        { "label": "MetalFX", "set": { "upscale": "\"metalfx\"" } }
      ],
      "defaults": { "upscale": "\"\"" }
    },
    {
      "id": "aa",
      "label": "Anti-aliasing",
      "group": "Graphics",
      "choices": [
        { "label": "Off", "set": { "aa": "\"\"" } },
        { "label": "FXAA", "set": { "aa": "\"fxaa\"" } },
        { "label": "SMAA", "set": { "aa": "\"smaa\"" } }
      ],
      "defaults": { "aa": "\"\"" }
    },
    {
      "id": "sharpen",
      "label": "Sharpening",
      "group": "Graphics",
      "slider": { "key": "sharpen", "min": 0, "max": 1, "step": 0.05, "format": "%.2f" },
      "defaults": { "sharpen": "0.0" }
    },
    {
      "id": "aniso",
      "label": "Anisotropic filtering",
      "help": "Sharper textures on surfaces seen at an angle.",
      "group": "Graphics",
      "choices": [
        { "label": "Off", "set": { "aniso": "0" } },
        { "label": "2×", "set": { "aniso": "2" } },
        { "label": "4×", "set": { "aniso": "4" } },
        { "label": "8×", "set": { "aniso": "8" } },
        { "label": "16×", "set": { "aniso": "16" } }
      ],
      "defaults": { "aniso": "0" }
    },
    {
      "id": "input_mode",
      "label": "What controls the game",
      "group": "Controls",
      "choices": [
        { "label": "Controller and keyboard", "set": { "inputMode": "\"both\"" } },
        { "label": "Controller only", "set": { "inputMode": "\"controller\"" } },
        { "label": "Keyboard and mouse only", "set": { "inputMode": "\"keyboard\"" } }
      ],
      "defaults": { "inputMode": "\"both\"" }
    },
    {
      "id": "mouse_sens",
      "label": "Mouse sensitivity",
      "group": "Controls",
      "slider": { "key": "mouseSens", "min": 0.25, "max": 4, "step": 0.05, "format": "%.2f" },
      "defaults": { "mouseSens": "1.0" }
    },
    {
      "id": "mouse_invert_y",
      "label": "Invert mouse up and down",
      "group": "Controls",
      "choices": [
        { "label": "Off", "set": { "mouseInvertY": "false" } },
        { "label": "On", "set": { "mouseInvertY": "true" } }
      ],
      "defaults": { "mouseInvertY": "false" }
    },
    {
      "id": "rumble",
      "label": "Vibration",
      "group": "Controls",
      "choices": [
        { "label": "On", "set": { "rumble": "true" } },
        { "label": "Off", "set": { "rumble": "false" } }
      ],
      "defaults": { "rumble": "true" }
    },
    {
      "id": "adaptive_triggers",
      "label": "DualSense adaptive triggers",
      "help": "R2 clicks like a gun's trigger on a PS5 controller.",
      "group": "Controls",
      "choices": [
        { "label": "On", "set": { "adaptiveTriggers": "true" } },
        { "label": "Off", "set": { "adaptiveTriggers": "false" } }
      ],
      "defaults": { "adaptiveTriggers": "true" }
    },
    {
      "id": "audio_volume",
      "label": "Volume",
      "group": "Audio",
      "slider": { "key": "audioVolume", "min": 0, "max": 100, "step": 5, "format": "%d" },
      "defaults": { "audioVolume": "100" }
    },
    {
      "id": "audio_mute",
      "label": "Sound",
      "group": "Audio",
      "choices": [
        { "label": "On", "set": { "audioMute": "false" } },
        { "label": "Muted", "set": { "audioMute": "true" } }
      ],
      "defaults": { "audioMute": "false" }
    }
  ],
  "saves": [
    "{home}/Library/Application Support/resistance-recomp/gamedata/dev_hdd0/home/00000001/savedata"
  ],
  "folders": {
    "saves": [{ "path": "{home}/Library/Application Support/resistance-recomp/gamedata/dev_hdd0/home/00000001/savedata" }],
    "logs": [{ "path": "{home}/Library/Application Support/resistance-recomp" }]
  },
  "exit_codes": {
    "0": "ok",
    "2": "The launcher was started with arguments it does not understand. Update RecompLauncher and the game, then try again.",
    "10": "That is not the US disc of Resistance: Fall of Man (BCUS98107), or it can no longer be found. Pick your decrypted .iso or disc folder again on the game's page.",
    "11": "Apple's Command Line Tools are needed to build the game. Their installer has opened: finish it, then run the setup again.",
    "12": "The game's sources or build tools could not be downloaded. Check the internet connection and run the setup again; it continues where it stopped.",
    "13": "Building the game failed. Run the setup again; if it fails the same way, report it with install.log from the logs folder.",
    "14": "Resistance is already being installed or played. Wait for it to finish (or quit the game), then try again.",
    "15": "There is not enough free disk space. The build needs about 4 GB: free some space and run the setup again.",
    "16": "This recomp runs on Macs only.",
    "17": "The game is not built yet. Run the setup on the game's page first.",
    "18": "Files of the game's v1.7 update are in the offline play folder. Open the Resistance Launcher once: it moves them aside."
  }
}
